def count_active_channels(channel_pattern: str) -> int:
    text = str(channel_pattern or "").strip()
    return sum(1 for char in text if char == "1")


def infer_transfer_direction_from_positions(positions: List[str]) -> str:
    normalized = [normalize_position_text(pos) for pos in positions if pos]

    parsed = []
    for pos in normalized:
        match = re.match(r"^([A-P])(\d{1,2})$", pos)
        if match:
            parsed.append((match.group(1), int(match.group(2)), pos))
        else:
            num = extract_position_number(pos)
            if num is not None:
                parsed.append(("", num, pos))

    if len(parsed) < 2:
        return "single position / direction not inferable"

    rows = [item[0] for item in parsed if item[0]]
    cols = [item[1] for item in parsed]

    if rows and len(set(rows)) == 1 and len(set(cols)) > 1:
        return "left-to-right across columns"

    if rows and len(set(cols)) == 1 and len(set(rows)) > 1:
        return "top-to-bottom down rows"

    if cols == sorted(cols):
        return "ascending numeric order"

    if cols == sorted(cols, reverse=True):
        return "descending numeric order"

    return "mixed/non-linear order"


def infer_labware_orientation_from_layout(layout_matches: Dict[str, List[Dict[str, Any]]]) -> Dict[str, Any]:
    layout_summary = summarize_layout_format(layout_matches)
    row_count = int(layout_summary.get("row_count") or 0)
    column_count = int(layout_summary.get("column_count") or 0)

    if column_count > row_count:
        orientation = "landscape"
    elif row_count > column_count:
        orientation = "portrait"
    else:
        orientation = "square/unknown"

    return {
        "type": "labware_orientation",
        "orientation": orientation,
        "row_count": row_count,
        "column_count": column_count,
        "inferred_plate_format": layout_summary.get("inferred_plate_format", "unknown"),
    }


def analyze_orientation_and_tip_usage(
    configs: List[SequenceStepConfig],
    execution_plan: List[Dict[str, Any]],
    layout_matches: Dict[str, List[Dict[str, Any]]],
    aspirate_steps: List[str],
    dispense_steps: List[str],
    cross_match: Any,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []

    orientation = infer_labware_orientation_from_layout(layout_matches) if layout_matches else {
        "type": "labware_orientation",
        "orientation": "unknown/no layout",
        "row_count": 0,
        "column_count": 0,
        "inferred_plate_format": "unknown",
    }

    findings.append(orientation)

    trace_step_usage = []
    max_channels_used_any_step = 0

    for step_index, step_line in enumerate(aspirate_steps, start=1):
        normalized = normalize_channel_steps([step_line])
        channels = sorted({item[0] for item in normalized}, key=lambda x: int(x) if str(x).isdigit() else 999)
        labware = sorted({item[1] for item in normalized if item[1]})
        positions = [item[2] for item in normalized]
        tips_used = len(channels)
        max_channels_used_any_step = max(max_channels_used_any_step, tips_used)

        trace_step_usage.append({
            "type": "tip_usage_by_trace_step",
            "step_number": step_index,
            "step_role": "aspirate",
            "tips_used_at_this_step": tips_used,
            "channels_used": channels,
            "labware": labware,
            "positions": positions,
        })

    for step_index, step_line in enumerate(dispense_steps, start=1):
        normalized = normalize_channel_steps([step_line])
        channels = sorted({item[0] for item in normalized}, key=lambda x: int(x) if str(x).isdigit() else 999)
        labware = sorted({item[1] for item in normalized if item[1]})
        positions = [item[2] for item in normalized]
        tips_used = len(channels)
        max_channels_used_any_step = max(max_channels_used_any_step, tips_used)

        trace_step_usage.append({
            "type": "tip_usage_by_trace_step",
            "step_number": step_index,
            "step_role": "dispense",
            "tips_used_at_this_step": tips_used,
            "channels_used": channels,
            "labware": labware,
            "positions": positions,
        })

    findings.extend(trace_step_usage)

    tip_pick_steps = [
        item for item in execution_plan
        if item.get("action") == "tip_pick"
    ]

    for index, tip_step in enumerate(tip_pick_steps, start=1):
        pattern = str(tip_step.get("channel_pattern") or "")
        picked_tip_count = count_active_channels(pattern)

        if str(tip_step.get("hardware_mode", "")).lower() == "head":
            picked_tip_count = 96

        unused_count = max(picked_tip_count - max_channels_used_any_step, 0)

        status = "pass"
        if picked_tip_count > 0 and max_channels_used_any_step == 0:
            status = "fail"
        elif unused_count > 0:
            status = "warning"

        finding = {
            "type": "tip_pickup_vs_usage",
            "tip_pick_step_index": index,
            "tip_sequence": tip_step.get("sequence"),
            "hardware_mode": tip_step.get("hardware_mode"),
            "channel_pattern": pattern,
            "tips_picked_up": picked_tip_count,
            "max_tips_used_at_one_time": max_channels_used_any_step,
            "unused_picked_tips": unused_count,
            "status": status,
        }

        findings.append(finding)

        if status == "fail":
            issues.append(ValidationIssue(
                "critical",
                "tip usage",
                f"Tips were picked up from {tip_step.get('sequence')}, but no aspirate or dispense tip usage was detected in the trace.",
                finding,
            ))

        elif status == "warning":
            issues.append(ValidationIssue(
                "major",
                "tip usage",
                (
                    f"{tip_step.get('sequence')} picked up {picked_tip_count} tip(s), "
                    f"but the trace only used {max_channels_used_any_step} tip(s) at one time."
                ),
                finding,
            ))

    return findings, issues


def generate_pyhamilton_review_script(
    configs: List[SequenceStepConfig],
    execution_plan: List[Dict[str, Any]],
    output_dir: str,
) -> str:
    os.makedirs(output_dir, exist_ok=True)

    script_path = os.path.join(
        output_dir,
        f"devpal_lite_review_required_pyhamilton_script_{datetime.now().strftime('%H%M%S')}.py",
    )

    payload = {
        "review_required": True,
        "generated_at": datetime.now().isoformat(),
        "selected_sequences": [asdict(config) for config in configs],
        "execution_plan": execution_plan,
    }

    lines = [
        "from pyhamilton import *",
        "",
        "REVIEW_REQUIRED = True",
        f"DEV_PAL_LITE_PLAN = {json.dumps(payload, indent=4)}",
        "",
        "def _resolve_resource_class(labware_name):",
        "    text = str(labware_name or '').upper()",
        "    preferred_names = []",
        "    if '384' in text:",
        "        preferred_names = ['Plate384', 'Plate96']",
        "    elif '24' in text:",
        "        preferred_names = ['Plate24', 'Plate96']",
        "    elif '96' in text or 'PLATE' in text:",
        "        preferred_names = ['Plate96']",
        "    elif 'TIP' in text or 'TIPRACK' in text or 'SLIM' in text:",
        "        preferred_names = ['Tip96', 'TipRack', 'Plate96']",
        "    elif 'RACK' in text or 'TUBE' in text or 'HONEYCOMB' in text or 'CARRIER' in text:",
        "        preferred_names = ['Plate96', 'Tip96']",
        "    else:",
        "        preferred_names = ['Plate96']",
        "",
        "    for class_name in preferred_names:",
        "        if class_name in globals():",
        "            return globals()[class_name]",
        "",
        "    return Plate96",
        "",
        "def _assign_sequence_resource(layout_manager, labware_name):",
        "    labware_name = str(labware_name or '').strip()",
        "    if not labware_name:",
        "        return None",
        "",
        "    resource_class = _resolve_resource_class(labware_name)",
        "    attempts = []",
        "",
        "    if hasattr(layout_manager, 'assign_resource'):",
        "        attempts.append(lambda: layout_manager.assign_resource(labware_name))",
        "",
        "    if 'ResourceType' in globals() and resource_class is not None:",
        "        if hasattr(layout_manager, 'assign_resource'):",
        "            attempts.append(lambda: layout_manager.assign_resource(ResourceType(resource_class, labware_name)))",
        "        if hasattr(layout_manager, 'assign_unused_resource'):",
        "            attempts.append(lambda: layout_manager.assign_unused_resource(ResourceType(resource_class, labware_name)))",
        "            attempts.append(lambda: layout_manager.assign_unused_resource(ResourceType(resource_class, '')))",
        "",
        "    last_error = None",
        "    for attempt in attempts:",
        "        try:",
        "            resource = attempt()",
        "            if resource is not None:",
        "                return resource",
        "        except Exception as exc:",
        "            last_error = exc",
        "",
        "    raise RuntimeError(f\"Could not assign labware resource for {labware_name!r}. Last error: {last_error}\")",
        "",
        "def run_review_required_plan(ham_int, layout_manager):",
        "    if REVIEW_REQUIRED:",
        "        raise RuntimeError('Review required before running generated PyHamilton script. Set REVIEW_REQUIRED = False only after human review.')",
        "",
        "    resource_cache = {}",
        "    initialize(ham_int)",
    ]

    for item in execution_plan:
        action = str(item.get("action") or "").strip()
        seq = str(item.get("sequence") or "").strip()
        hardware_mode = str(item.get("hardware_mode") or "channels").strip().lower()

        if hardware_mode == "stamp":
            hardware_mode = "head"

        channel = normalize_assigned_channel_pattern(
            item.get("channel_pattern") or "111111111111",
            hardware_mode,
        )

        volume = float(item.get("volume_ul") or 0)
        liquid_class = str(item.get("liquid_class") or "").strip()
        increment = int(item.get("increment") or 0)
        labware_name = str(item.get("labware_name") or seq).strip()
        cache_key = str(labware_name or seq).strip().lower()

        lines.append("")
        lines.append(f"    # Order {item.get('order')} | Set {item.get('set_order')} | {action} | {seq}")

        if (
                item.get("autoincrement")
                and item.get("action") in {"aspirate", "dispense"}
                and not bool(item.get("manual"))
                and seq
                and increment > 0
        ):
            lines.append(
                f"    inc_sequence(ham_int, sequence={seq!r}, increment={increment!r})"
            )

        if action == "tip_pick":
            if hardware_mode == "head":
                lines.append(
                    f"    tip_pick_up_96_seq(ham_int, tip96_seq={seq!r})"
                )
            else:
                lines.append(
                    f"    tip_pick_up_seq(ham_int, tipseq={seq!r}, channel={channel!r})"
                )

        elif action == "aspirate":
            if hardware_mode == "head":
                lines.append(
                    f"    if {cache_key!r} not in resource_cache:"
                )
                lines.append(
                    f"        resource_cache[{cache_key!r}] = _assign_sequence_resource(layout_manager, {labware_name!r})"
                )
                lines.append(
                    f"    aspirate_96_seq(ham_int, plate96=resource_cache[{cache_key!r}], head_asp_seq={seq!r}, vols={volume!r}, liq_class={liquid_class!r})"
                )
            else:
                lines.append(
                    f"    aspirate_seq(ham_int, asp_seq={seq!r}, vols={volume!r}, channel={channel!r}, liq_class={liquid_class!r})"
                )

        elif action == "dispense":
            if hardware_mode == "head":
                lines.append(
                    f"    if {cache_key!r} not in resource_cache:"
                )
                lines.append(
                    f"        resource_cache[{cache_key!r}] = _assign_sequence_resource(layout_manager, {labware_name!r})"
                )
                lines.append(
                    f"    dispense_96_seq2(ham_int, plate96=resource_cache[{cache_key!r}], head_disp_seq={seq!r}, vols={volume!r}, liq_class={liquid_class!r})"
                )
            else:
                lines.append(
                    f"    dispense_seq(ham_int, disp_seq={seq!r}, vols={volume!r}, channel={channel!r}, liq_class={liquid_class!r})"
                )

        elif action == "tip_eject":
            if hardware_mode == "head":
                lines.append("    tip_eject_96(ham_int)")
            else:
                lines.append(
                    f"    tip_eject_seq2(ham_int, waste_seq={seq!r}, channel={channel!r})"
                )

    Path(script_path).write_text("\n".join(lines) + "\n", encoding="utf-8")
    return script_path


def humanize_key(key: str) -> str:
    text = str(key or "").replace("_", " ").replace("-", " ").strip()
    replacements = {
        "trace layout": "Trace vs Layout Crossmatch",
        "runtime step execution": "Runtime Step Execution",
        "tip volume rule": "Tip Type / Volume Rule",
        "urgent labware mismatch": "Labware Mismatch",
        "urgent destination outside layout format": "Destination Outside Layout Format",
        "configuration": "Configuration",
        "marker": "Plate Layout Marker",
        "mapping": "Transfer Mapping",
        "layout": "Plate Layout",
        "trace": "Trace Analysis",
        "tracking": "Sample Tracking",
        "tip usage": "Tip Usage",
        "runtime": "Runtime",
    }
    lower = re.sub(r"\s+", " ", text.lower())
    return replacements.get(lower, text.title())


def is_error_record(value: Any) -> bool:
    text = str(value).lower()
    return any(word in text for word in [
        "urgent", "critical", "error", "fail", "mismatch",
        "wrong labware", "missing", "unexpected", "not valid",
    ])


def safe_text(value: Any) -> str:
    if value is None:
        return "None"

    if isinstance(value, float):
        if value.is_integer():
            return str(int(value))
        return str(value)

    text = str(value)
    text = text.replace("{", "").replace("}", "")
    text = text.replace("[", "").replace("]", "")
    text = text.replace("'", "").replace('"', "")
    text = text.replace("_", " ")
    text = re.sub(r"\s+", " ", text).strip()
    return text if text else "None"


def normal_datetime() -> str:
    return datetime.now().strftime("%B %d, %Y at %I:%M %p")


def compact_path(path: str) -> str:
    return str(path or "Not provided")


def join_values(values: List[Any]) -> str:
    cleaned = [safe_text(value) for value in values if safe_text(value) not in {"", "None"}]
    return ", ".join(cleaned) if cleaned else "None"


def format_evidence(evidence: Any) -> List[str]:
    if not evidence:
        return ["Evidence: Not provided by analyzer."]

    lines = []

    if isinstance(evidence, dict):
        for key, value in evidence.items():
            if value in (None, "", [], {}):
                continue

            label = humanize_key(key)

            if isinstance(value, list):
                lines.append(f"{label}: {join_values(value)}")
            elif isinstance(value, dict):
                nested = []
                for nested_key, nested_value in value.items():
                    if nested_value not in (None, "", [], {}):
                        nested.append(f"{humanize_key(nested_key)} = {safe_text(nested_value)}")
                if nested:
                    lines.append(f"{label}: {', '.join(nested)}")
            else:
                lines.append(f"{label}: {safe_text(value)}")

    elif isinstance(evidence, list):
        lines.append(f"Evidence: {join_values(evidence)}")
    else:
        lines.append(f"Evidence: {safe_text(evidence)}")

    return lines if lines else ["Evidence: Not provided by analyzer."]


def summarize_issue_title(issue: Dict[str, Any]) -> str:
    severity = humanize_key(issue.get("severity", "Issue"))
    category = humanize_key(issue.get("category", "Validation"))
    return f"{severity} issue - {category}"


def build_report_sections(output: DevPalLiteOutput, report_path: str) -> Dict[str, Any]:
    issue_groups = defaultdict(lambda: {
        "severity": "",
        "category": "",
        "messages": set(),
        "evidence": defaultdict(set),
    })

    severity_rank = {"critical": 3, "major": 2, "minor": 1, "info": 0}

    for issue in output.issues or []:
        if not isinstance(issue, dict):
            continue

        severity = str(issue.get("severity", "")).lower()
        if severity not in {"critical", "major"}:
            continue

        category = humanize_key(issue.get("category", "Issue"))
        message = safe_text(issue.get("message", ""))

        group = issue_groups[category.lower()]

        if not group["severity"] or severity_rank.get(severity, 0) > severity_rank.get(group["severity"], 0):
            group["severity"] = severity

        group["category"] = category

        if message:
            group["messages"].add(message)

        evidence = issue.get("evidence") or {}

        if category.lower() == "trace vs plate layout":
            continue

        if isinstance(evidence, dict):
            for ev_key, ev_value in evidence.items():
                if ev_key in {"message", "type", "status"} or ev_value in (None, "", [], {}):
                    continue

                label = humanize_key(ev_key)

                if isinstance(ev_value, list):
                    for item in ev_value:
                        group["evidence"][label].add(safe_text(item))
                elif isinstance(ev_value, dict):
                    for nested_key, nested_value in ev_value.items():
                        if nested_value not in (None, "", [], {}):
                            group["evidence"][label].add(f"{safe_text(nested_key)}: {safe_text(nested_value)}")
                else:
                    group["evidence"][label].add(safe_text(ev_value))

    major_critical = []
    for _, group in sorted(issue_groups.items(), key=lambda item: item[0]):
        major_critical.append({
            "severity": group["severity"],
            "category": group["category"],
            "messages": sorted(group["messages"]),
            "evidence": {
                key: sorted(values)
                for key, values in group["evidence"].items()
                if values
            },
        })

    critical_issue_count = sum(
        1 for issue in output.issues or []
        if isinstance(issue, dict) and str(issue.get("severity", "")).lower() == "critical"
    )

    role_order = {"tip pick up": 1, "aspirate": 2, "dispense": 3}

    selected_sequences = []
    ordered_configs = sorted(
        output.selected_sequences or [],
        key=lambda c: (
            int(c.get("set_order", 1) or 1),
            role_order.get(str(c.get("role", "")).lower(), 99),
            int(c.get("selected_index", 0) or 0),
        ) if isinstance(c, dict) else (999, 999, 999),
    )

    for config in ordered_configs:
        if not isinstance(config, dict):
            continue

        role = humanize_key(config.get("role", ""))
        sequence = safe_text(config.get("sequence", ""))
        set_order = safe_text(config.get("set_order", "1"))
        hardware = safe_text(config.get("hardware_mode", "")).replace(" mode", "")
        channel = safe_text(config.get("channel_pattern", ""))
        volume = config.get("volume_ul", "")
        liquid_class = safe_text(config.get("liquid_class", ""))
        count = safe_text(config.get("sequence_count", ""))

        replicate_text = ""
        if config.get("replicate_report_only"):
            replicate_text = f", replicate setting reported only: {safe_text(config.get('replicate', 'single'))}"

        line = f"Set {set_order}: {role} - {sequence}, using {hardware}{replicate_text}"

        if str(config.get("role", "")).lower() in {"aspirate", "dispense"}:
            line += f", {safe_text(volume)} uL, LC {liquid_class}"

        line += f", channel pattern {channel}, sequence count {count}"
        selected_sequences.append(line)

    marker_summary = []
    for marker_label, entries in sorted(
        (output.marker_matches or {}).items(),
        key=lambda item: extract_position_number(item[0]) or 0,
    ):
        locations = []

        for entry in entries or []:
            if not isinstance(entry, dict):
                continue

            dest = safe_text(entry.get("dest_value", ""))
            value = safe_text(entry.get("cell_value", ""))

            if dest != "None":
                locations.append(f"{dest} contains {value}")

        marker_summary.append(f"{safe_text(marker_label)}: {join_values(locations)}")

    trace_transfer_summary = []
    trace_layout_failures = defaultdict(lambda: {"expected": set(), "actual": set()})
    has_trace_layout_failure = False

    for finding in output.trace_findings or []:
        if not isinstance(finding, dict):
            continue

        if finding.get("type") == "actual_trace_transfer":
            marker_label = safe_text(finding.get("marker", ""))
            transfers = finding.get("transfers", []) or []

            transfer_parts = []
            for transfer in transfers:
                source_labware = safe_text(transfer.get("source_labware", ""))
                source_position = safe_text(transfer.get("source_position", ""))
                destination_labware = join_values(transfer.get("destination_labware", []))
                destination_wells = join_values(transfer.get("destination_wells", []))

                transfer_parts.append(
                    f"aspirated from {source_labware} position {source_position}; "
                    f"dispensed to {destination_labware} wells {destination_wells}"
                )

            if transfer_parts:
                trace_transfer_summary.append(f"{marker_label}: " + " | ".join(transfer_parts))

        if finding.get("type") == "trace_layout_match" and finding.get("status") == "fail":
            has_trace_layout_failure = True
            marker_label = safe_text(finding.get("marker", ""))

            for well in finding.get("expected_destinations", []) or []:
                trace_layout_failures[marker_label]["expected"].add(safe_text(well))

            for well in finding.get("actual_destinations", []) or []:
                trace_layout_failures[marker_label]["actual"].add(safe_text(well))

    trace_summary = []

    for finding in output.trace_findings or []:
        if not isinstance(finding, dict):
            continue

        finding_type = str(finding.get("type", "")).lower()

        if finding_type == "trace_summary":
            trace_summary.append(
                f"Trace parsed: {safe_text(finding.get('aspirate_step_count'))} aspirate step(s), "
                f"{safe_text(finding.get('dispense_step_count'))} dispense step(s). "
                f"Plate layout crossmatch {'failed' if has_trace_layout_failure else safe_text(finding.get('cross_match_status'))}."
            )

        elif finding_type == "labware_orientation":
            trace_summary.append(
                f"Labware orientation: {safe_text(finding.get('orientation'))}; "
                f"{safe_text(finding.get('row_count'))} row(s), "
                f"{safe_text(finding.get('column_count'))} column(s), "
                f"detected as {safe_text(finding.get('inferred_plate_format'))}."
            )

        elif finding_type == "tip_pickup_vs_usage":
            trace_summary.append(
                f"Tip pickup usage: {safe_text(finding.get('tip_sequence'))} picked up "
                f"{safe_text(finding.get('tips_picked_up'))} tip(s); trace used up to "
                f"{safe_text(finding.get('max_tips_used_at_one_time'))} tip(s) at one time; "
                f"unused picked tips: {safe_text(finding.get('unused_picked_tips'))}."
            )

        elif finding_type == "tip_usage_by_trace_step":
            trace_summary.append(
                f"{humanize_key(finding.get('step_role'))} step {safe_text(finding.get('step_number'))}: "
                f"used {safe_text(finding.get('tips_used_at_this_step'))} tip(s) at one time; "
                f"channels {join_values(finding.get('channels_used', []))}; "
                f"labware {join_values(finding.get('labware', []))}; "
                f"positions {join_values(finding.get('positions', []))}."
            )

        elif finding_type == "expected_runtime_step_check" and finding.get("status") != "pass":
            trace_summary.append(
                f"Runtime step check failed: planned {safe_text(finding.get('planned_liquid_handling_step_count'))} "
                f"liquid-handling step(s); trace showed {safe_text(finding.get('trace_liquid_handling_step_count'))}."
            )

    for marker_label in sorted(trace_layout_failures, key=lambda value: extract_position_number(value) or 0):
        expected = sorted(trace_layout_failures[marker_label]["expected"])
        actual = sorted(trace_layout_failures[marker_label]["actual"])

        trace_summary.append(
            f"Mismatch - {marker_label}: expected plate layout wells {join_values(expected)}; trace dispensed to {join_values(actual)}."
        )

    layout_summary = []
    for finding in output.layout_findings or []:
        if isinstance(finding, dict) and finding.get("type") == "layout_summary":
            layout_summary.append(
                f"Plate layout marker {safe_text(finding.get('marker'))}: "
                f"{safe_text(finding.get('marker_count'))} marker(s), "
                f"{safe_text(finding.get('unique_layout_position_count'))} destination well(s)."
            )

    what_was_run = [
        line for line in selected_sequences
        if safe_text(line) not in {"", "None"}
    ]

    return {
        "major_critical": major_critical,
        "what_was_run": what_was_run,
        "marker_summary": marker_summary,
        "layout_summary": layout_summary,
        "trace_summary": trace_summary,
        "summary": {
            "Generated": normal_datetime(),
            "LAY File": compact_path(output.lay_file),
            "Plate Layout File": compact_path(output.layout_file),
            "Report Path": compact_path(report_path),
            "Number of Critical Issues": critical_issue_count,
        },
    }


def write_docx_line(doc, text: str, bold: bool = False, red: bool = False) -> None:
    paragraph = doc.add_paragraph()
    run = paragraph.add_run(safe_text(text))
    run.bold = bold
    if RGBColor is not None and (red or is_error_record(text)):
        run.font.color.rgb = RGBColor(255, 0, 0)


def write_docx_bullets(doc, lines: List[str], red: bool = False) -> None:
    if not lines:
        doc.add_paragraph("None found.")
        return

    for line in lines:
        paragraph = doc.add_paragraph(style=None)
        paragraph.paragraph_format.left_indent = None
        run = paragraph.add_run(f"• {safe_text(line)}")
        if RGBColor is not None and (red or is_error_record(line)):
            run.font.color.rgb = RGBColor(255, 0, 0)


def write_docx_report(output: DevPalLiteOutput, output_dir: str) -> str:
    if Document is None:
        return write_text_report(output, output_dir)

    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.docx",
    )

    sections = build_report_sections(output, path)

    doc = Document()
    doc.add_heading("DevPal Sequence Analyzer Report", 0)

    doc.add_heading("Run Summary", level=1)
    for label, value in sections["summary"].items():
        paragraph = doc.add_paragraph()
        paragraph.add_run(f"{label}: ").bold = True
        paragraph.add_run(safe_text(value))

    doc.add_heading("Major / Critical Issues", level=1)

    if sections["major_critical"]:
        for index, group in enumerate(sections["major_critical"], start=1):
            title = f"{index}. {humanize_key(group.get('severity'))} issue with {humanize_key(group.get('category'))}"
            write_docx_line(doc, title, bold=True, red=True)

            for message in group.get("messages", []):
                write_docx_line(doc, f"- {message}", red=True)

            evidence = group.get("evidence") or {}
            for key, values in evidence.items():
                if values:
                    write_docx_line(doc, f"{key}: {join_values(values)}", red=True)
    else:
        doc.add_paragraph("No major or critical issues found.")

    doc.add_heading("What Was Run", level=1)
    write_docx_bullets(doc, sections["what_was_run"])

    doc.add_heading("Plate Layout Marker Review", level=1)
    write_docx_bullets(
        doc,
        sections["marker_summary"] or ["No marker matches were found in the uploaded plate layout."],
    )

    doc.add_heading("Layout Summary", level=1)
    write_docx_bullets(doc, sections["layout_summary"])

    doc.add_heading("Trace / Runtime Summary", level=1)
    write_docx_bullets(doc, sections["trace_summary"])

    doc.save(path)
    return path


def write_text_report(output: DevPalLiteOutput, output_dir: str) -> str:
    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.txt",
    )

    sections = build_report_sections(output, path)

    with open(path, "w", encoding="utf-8") as handle:
        handle.write("DevPal Lite Validation Report\n")
        handle.write("=" * 80 + "\n\n")

        handle.write("Run Summary\n")
        handle.write("-" * 80 + "\n")
        for label, value in sections["summary"].items():
            handle.write(f"{label}: {safe_text(value)}\n")

        handle.write("\nMajor / Critical Issues\n")
        handle.write("-" * 80 + "\n")

        if sections["major_critical"]:
            for index, group in enumerate(sections["major_critical"], start=1):
                handle.write(
                    f"\n{index}. {humanize_key(group.get('severity'))} issue with "
                    f"{humanize_key(group.get('category'))}\n"
                )

                for message in group.get("messages", []):
                    handle.write(f"- {safe_text(message)}\n")

                evidence = group.get("evidence") or {}
                for key, values in evidence.items():
                    if values:
                        handle.write(f"{key}: {join_values(values)}\n")
        else:
            handle.write("No major or critical issues found.\n")

        blocks = [
            ("What Was Run", sections["what_was_run"]),
            ("Plate Layout Marker Review", sections["marker_summary"] or ["No marker matches were found in the uploaded plate layout."]),
            ("Layout Summary", sections["layout_summary"]),
            ("Trace / Runtime Summary", sections["trace_summary"]),
        ]

        for title, lines in blocks:
            handle.write(f"\n{title}\n")
            handle.write("-" * 80 + "\n")

            if lines:
                for line in lines:
                    handle.write(f"- {safe_text(line)}\n")
            else:
                handle.write("None found.\n")

    return path


def write_pdf_report(output: DevPalLiteOutput, output_dir: str) -> str:
    if SimpleDocTemplate is None:
        return write_text_report(output, output_dir)

    path = os.path.join(
        output_dir,
