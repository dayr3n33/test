    source = source.replace(old_call, new_call, 1)

    old_layout = '''        pairs = generate_deterministic_transfer_pairs(configs, marker_matches)

        if marker_matches:
            layout_findings, layout_issues = validate_layout_matches(
                marker_matches,
                pairs,
