                )
                layout_findings.append({
                    "type": "plate_layout_pattern",
                    "marker_prefix": plate_pattern.marker_prefix,
                    "samples_per_plate": plate_pattern.samples_per_plate,
                    "replicate": plate_pattern.replicate_name,
                    "replicate_count": plate_pattern.replicate_count,
                    "marker_numbers": plate_pattern.marker_numbers,
                    "status": "pass",
                })
            except Exception as exc:
                issues.append(ValidationIssue(
                    "critical",
                    "plate layout pattern",
                    str(exc),
                    {"marker": marker, "replicate": configs[0].replicate},
                ))
        else:
            limitations.append("No marker matches were found in the plate layout.")'''

    if old_layout not in source:
        raise RuntimeError(
            "Could not locate layout-validation block in generate_plan_run_and_validate."
        )

    return source.replace(old_layout, new_layout, 1)


def main() -> None:
    target = Path(sys.argv[1]) if len(sys.argv) > 1 else Path("DP")

    if not target.exists():
        raise SystemExit(f"Target file does not exist: {target}")

    source = target.read_text(encoding="utf-8")

    source = replace_marker_region(source)
    source = replace_function(
        source,
        "generate_deterministic_transfer_pairs",
        GENERATE_PAIRS_FUNCTION,
    )
    source = replace_function(source, "validate_layout_matches", VALIDATE_LAYOUT_FUNCTION)
    source = replace_function(source, "cross_match_positions", CROSS_MATCH_FUNCTION)
    source = replace_function(
        source,
        "validate_trace_against_layout",
        VALIDATE_TRACE_FUNCTION,
    )
    source = patch_generate_plan(source)

    try:
        ast.parse(source)
    except SyntaxError as exc:
        raise SystemExit(
            f"Patched file failed Python syntax validation at line {exc.lineno}: {exc.msg}"
        )

    output = target.with_name(target.name + ".multiplate.py")
    output.write_text(source, encoding="utf-8")

    print(f"Created: {output}")
