PLATE_LAYOUT_BLOCK = r'''
@dataclass
class PlateLayoutPattern:
    marker_prefix: str
    marker_numbers: List[int]
    wells_by_marker_number: Dict[int, List[str]]
    occurrences_by_marker_number: Dict[int, int]
    samples_per_plate: int
    replicate_count: int

    @property
    def replicate_name(self) -> str:
        return {1: "single", 2: "duplicate", 3: "triplicate"}.get(
            int(self.replicate_count), f"{self.replicate_count}x"
        )


def _parse_marker_token(marker_token: Any) -> Tuple[str, Optional[int]]:
    text = str(marker_token or "").strip().upper()
    match = re.match(r"^([A-Z][A-Z0-9 _\-]*?)(\d+)$", text)
    if not match:
        return "", None
    prefix = re.sub(r"\s+", "", match.group(1))
    return prefix, int(match.group(2))


def get_marker_numbers(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> List[int]:
    marker = str(marker or "").upper().strip()

    if not marker:
        prefixes = defaultdict(list)
        for marker_key in layout_matches:
            prefix, number = _parse_marker_token(marker_key)
            if prefix and number is not None:
                prefixes[prefix].append(number)

        if not prefixes:
            return []

        marker = max(prefixes, key=lambda key: len(set(prefixes[key])))

    numbers = []
    for marker_key in layout_matches:
        prefix, number = _parse_marker_token(marker_key)
        if prefix == marker and number is not None:
            numbers.append(number)

    return sorted(set(numbers))


def analyze_plate_layout_pattern(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    configured_marker: str = "",
    configured_replicate: str = "",
) -> PlateLayoutPattern:
    if not layout_matches:
        raise ValueError("No plate-layout markers were found.")

    configured_marker = str(configured_marker or "").strip().upper()

    prefix_to_numbers = defaultdict(list)
    for marker_key in layout_matches:
        prefix, number = _parse_marker_token(marker_key)
        if prefix and number is not None:
            prefix_to_numbers[prefix].append(number)

    if configured_marker:
        marker_prefix = configured_marker
        if marker_prefix not in prefix_to_numbers:
            available = ", ".join(sorted(prefix_to_numbers)) or "none"
            raise ValueError(
                f"Marker '{configured_marker}' was not found in the plate layout. "
                f"Detected marker prefix(es): {available}."
            )
    else:
        if not prefix_to_numbers:
            raise ValueError(
                "No numbered marker pattern such as S1, S2, S3 was found in the plate layout."
            )
        marker_prefix = max(
            prefix_to_numbers,
            key=lambda prefix: len(set(prefix_to_numbers[prefix])),
        )

    marker_numbers = sorted(set(prefix_to_numbers[marker_prefix]))
    if not marker_numbers:
        raise ValueError(f"No numbered markers were found for marker prefix '{marker_prefix}'.")

    expected_numbers = list(range(1, max(marker_numbers) + 1))
    if marker_numbers != expected_numbers:
        missing = sorted(set(expected_numbers) - set(marker_numbers))
        raise ValueError(
            f"Plate-layout marker numbering for {marker_prefix} must be continuous from "
            f"{marker_prefix}1 through {marker_prefix}{max(marker_numbers)}. "
            f"Missing marker number(s): {missing}."
        )

    wells_by_marker_number: Dict[int, List[str]] = {}
    occurrences_by_marker_number: Dict[int, int] = {}

    for number in marker_numbers:
        marker_label = f"{marker_prefix}{number}"
        wells = get_layout_marker_positions(layout_matches, marker_label)
        wells_by_marker_number[number] = wells
        occurrences_by_marker_number[number] = len(wells)

    occurrence_counts = sorted(set(occurrences_by_marker_number.values()))

    if len(occurrence_counts) != 1:
        raise ValueError(
            "Plate-layout replicate pattern is inconsistent. Every numbered sample marker "
            "must occur the same number of times. "
            f"Counts: {occurrences_by_marker_number}."
        )

    replicate_count = occurrence_counts[0] if occurrence_counts else 0
    if replicate_count not in (1, 2, 3):
        raise ValueError(
            "DevPal Lite supports single, duplicate, or triplicate plate layouts. "
            f"The uploaded layout contains {replicate_count} destination occurrence(s) "
            "per sample marker."
        )

    if configured_replicate:
        configured_count = REPLICATE_MAP.get(str(configured_replicate).lower())
        if configured_count and configured_count != replicate_count:
            raise ValueError(
                f"Replicate mismatch: the UI is set to '{configured_replicate}' "
                f"({configured_count} destination(s) per sample), but the plate layout "
                f"contains {replicate_count} destination(s) per numbered marker."
            )

    return PlateLayoutPattern(
        marker_prefix=marker_prefix,
        marker_numbers=marker_numbers,
        wells_by_marker_number=wells_by_marker_number,
        occurrences_by_marker_number=occurrences_by_marker_number,
        samples_per_plate=len(marker_numbers),
        replicate_count=replicate_count,
    )


def resolve_repeating_layout_marker(
    source_number: int,
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> Tuple[str, int]:
    pattern = analyze_plate_layout_pattern(
        layout_matches,
        configured_marker=marker,
    )

    source_number = max(int(source_number), 1)
    repeated_number = ((source_number - 1) % pattern.samples_per_plate) + 1
    return f"{pattern.marker_prefix}{repeated_number}", repeated_number


def expected_plate_layout_for_sample(
    sample_number: int,
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
    configured_replicate: str = "",
) -> Dict[str, Any]:
    pattern = analyze_plate_layout_pattern(
        layout_matches,
        configured_marker=marker,
        configured_replicate=configured_replicate,
    )

    sample_number = max(int(sample_number), 1)
    template_number = ((sample_number - 1) % pattern.samples_per_plate) + 1
    plate_cycle = ((sample_number - 1) // pattern.samples_per_plate) + 1
    marker_label = f"{pattern.marker_prefix}{template_number}"

    return {
        "sample_number": sample_number,
        "template_marker": marker_label,
        "marker_number": template_number,
        "plate_cycle": plate_cycle,
        "expected_wells": list(pattern.wells_by_marker_number[template_number]),
        "replicate_count": pattern.replicate_count,
        "replicate": pattern.replicate_name,
        "samples_per_plate": pattern.samples_per_plate,
    }
'''.strip()


GENERATE_PAIRS_FUNCTION = r'''
def generate_deterministic_transfer_pairs(
    configs: List[SequenceStepConfig],
    layout_matches: Dict[str, List[Dict[str, Any]]],
) -> List[TransferPair]:
    if not configs:
        return []

    configured_replicate = configs[0].replicate
    marker = configs[0].marker.upper().strip() if configs[0].marker else ""

    try:
        pattern = analyze_plate_layout_pattern(
            layout_matches,
            configured_marker=marker,
            configured_replicate=configured_replicate,
        )
        replicate_count = pattern.replicate_count
        marker = pattern.marker_prefix
    except Exception:
        pattern = None
        replicate_count = REPLICATE_MAP.get(str(configured_replicate).lower(), 1)

    tip_steps = [c for c in configs if c.role == "tip pick up"]
    asp_steps = [c for c in configs if c.role == "aspirate"]
    dsp_steps = [c for c in configs if c.role == "dispense"]

    if not dsp_steps:
        return []

    max_dispense_positions = max(int(dsp.sequence_count or 0) for dsp in dsp_steps)
    if max_dispense_positions <= 0:
        max_dispense_positions = replicate_count

    total_samples = max(
        (max_dispense_positions + replicate_count - 1) // replicate_count,
        1,
    )

    pairs = []

    for source_num in range(1, total_samples + 1):
        asp = asp_steps[(source_num - 1) % len(asp_steps)] if asp_steps else None
        dsp = dsp_steps[(source_num - 1) % len(dsp_steps)] if dsp_steps else None
        tip = tip_steps[(source_num - 1) % len(tip_steps)] if tip_steps else None

        displayed_marker = f"{marker}{source_num}" if marker else ""

        if pattern is not None:
            expected = expected_plate_layout_for_sample(
                source_num,
                layout_matches,
                marker,
                configured_replicate,
            )
            expected_wells = expected["expected_wells"]
        else:
            layout_marker, _ = resolve_repeating_layout_marker(
                source_num,
                layout_matches,
                marker,
            )
            expected_wells = get_layout_marker_positions(layout_matches, layout_marker)

        for rep_index in range(1, replicate_count + 1):
            dest_position = ""
            if expected_wells:
                dest_position = expected_wells[min(rep_index - 1, len(expected_wells) - 1)]

            pairs.append(TransferPair(
                pair_id=f"sample-{source_num}-rep-{rep_index}",
                tip_sequence=tip.sequence if tip else "",
                source_sequence=asp.sequence if asp else "",
                destination_sequence=dsp.sequence if dsp else "",
                source_position=str(source_num),
                destination_position=dest_position,
                source_sample_number=source_num,
                destination_sample_number=extract_position_number(dest_position),
                replicate_index=rep_index,
                volume_ul=asp.volume_ul if asp else dsp.volume_ul if dsp else 0.0,
                liquid_class=asp.liquid_class if asp else dsp.liquid_class if dsp else "",
                transfer_type=asp.transfer_type if asp else dsp.transfer_type if dsp else "",
                marker_label=displayed_marker,
            ))

    return pairs
'''.strip()


VALIDATE_LAYOUT_FUNCTION = r'''
def validate_layout_matches(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    pairs: List[TransferPair],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []

    marker = str(marker or "").upper().strip()
    all_layout_positions = []
    seen_positions = defaultdict(list)

    for marker_label, entries in layout_matches.items():
        for entry in entries:
            pos = normalize_position_text(entry.get("dest_value", ""))
            if not pos:
                continue
            all_layout_positions.append(pos)
            seen_positions[pos].append(marker_label)

    duplicate_layout_positions = {
        pos: labels
        for pos, labels in seen_positions.items()
        if len(labels) > 1
    }

    if duplicate_layout_positions:
        add_issue(
            issues,
            "major",
            "plate layout",
            "Duplicate destination wells were found in the plate layout.",
            {
                "duplicate_destination_wells": sorted(duplicate_layout_positions.keys()),
                "markers_using_same_wells": {
                    pos: labels for pos, labels in duplicate_layout_positions.items()
                },
            },
        )

    try:
        pattern = analyze_plate_layout_pattern(
            layout_matches,
            configured_marker=marker,
        )

        findings.append({
            "type": "layout_summary",
            "marker": pattern.marker_prefix,
            "marker_count": len(pattern.marker_numbers),
            "layout_position_count": len(all_layout_positions),
            "unique_layout_position_count": len(set(all_layout_positions)),
            "layout_marker_numbers": pattern.marker_numbers,
            "samples_per_plate": pattern.samples_per_plate,
            "replicate_count_from_layout": pattern.replicate_count,
            "replicate_from_layout": pattern.replicate_name,
            "repeating_layout_template": (
                f"{pattern.marker_prefix}1 through "
                f"{pattern.marker_prefix}{pattern.samples_per_plate} define one plate. "
                "The same marker-to-well pattern repeats for every additional "
                "destination labware/plate."
            ),
            "duplicate_layout_positions": sorted(duplicate_layout_positions.keys()),
            "status": "pass",
        })
    except Exception as exc:
        findings.append({
            "type": "layout_summary",
            "marker": marker,
            "marker_count": len(layout_matches),
            "layout_position_count": len(all_layout_positions),
            "unique_layout_position_count": len(set(all_layout_positions)),
            "duplicate_layout_positions": sorted(duplicate_layout_positions.keys()),
            "status": "fail",
            "message": str(exc),
        })
        add_issue(
            issues,
            "critical",
            "plate layout pattern",
            str(exc),
            {"marker": marker},
        )

    return findings, issues
'''.strip()


CROSS_MATCH_FUNCTION = r'''
def cross_match_positions(
    aspirate_steps: List[str],
    dispense_steps: List[str],
    replicate_value: str,
) -> Tuple[bool, Any]:
    replicate_count = REPLICATE_MAP.get(str(replicate_value).lower(), 1)

    normalized_aspirates = normalize_channel_steps(aspirate_steps)
    normalized_dispenses = normalize_channel_steps(dispense_steps)

    if not normalized_aspirates:
        return False, "No channel-level aspirate positions could be parsed from the trace."

    if not normalized_dispenses:
        return False, "No channel-level dispense positions could be parsed from the trace."

    aspirates_by_channel = defaultdict(list)
    for asp_index, aspirate in enumerate(normalized_aspirates):
        aspirates_by_channel[aspirate[0]].append((asp_index, aspirate))

    dispenses_by_channel = defaultdict(list)
    for dispense in normalized_dispenses:
        dispenses_by_channel[dispense[0]].append(dispense)

    unknown_channels = sorted(set(dispenses_by_channel) - set(aspirates_by_channel))
    if unknown_channels:
        return False, (
            "Dispense channel(s) did not match any aspirate channel: "
            + ", ".join(unknown_channels)
        )

    mapped_records = []

    for channel, aspirate_records in aspirates_by_channel.items():
        channel_dispenses = dispenses_by_channel.get(channel, [])
        expected_dispense_total = len(aspirate_records) * replicate_count

        if len(channel_dispenses) != expected_dispense_total:
            return False, (
                f"Channel {channel} contains {len(aspirate_records)} aspirate sample(s) "
                f"and {len(channel_dispenses)} dispense destination(s). "
                f"With replicate '{replicate_value}', exactly {expected_dispense_total} "
                "dispense destination(s) are expected for that channel."
            )

        for occurrence, (asp_index, aspirate) in enumerate(aspirate_records):
            start = occurrence * replicate_count
            stop = start + replicate_count
            assigned = channel_dispenses[start:stop]
            mapped_records.append(
                (asp_index, aspirate, [dispense[1:] for dispense in assigned])
            )

    mapped_records.sort(key=lambda record: record[0])

    result = {}
    for sample_order, (_, aspirate, assigned) in enumerate(mapped_records, start=1):
        # Add a unique sample-order suffix so identical source tuple values in long
        # runs cannot collapse into one dictionary key.
        unique_key = aspirate + (f"sample_order={sample_order}",)
        result[unique_key] = assigned

    return True, result
'''.strip()


VALIDATE_TRACE_FUNCTION = r'''
def validate_trace_against_layout(
    aspirate_to_dispense_map: Dict[Any, Any],
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
    configured_replicate: str = "",
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []

    pattern = analyze_plate_layout_pattern(
        layout_matches,
        configured_marker=marker,
        configured_replicate=configured_replicate,
    )

    plate_cycle_to_labware: Dict[int, str] = {}
    labware_to_plate_cycle: Dict[str, int] = {}
    seen_physical_destinations = []
    total_samples = len(aspirate_to_dispense_map)

    for sample_index, (aspirate_step, dispenses) in enumerate(
        aspirate_to_dispense_map.items(),
        start=1,
    ):
        expected = expected_plate_layout_for_sample(
            sample_index,
            layout_matches,
            pattern.marker_prefix,
            configured_replicate,
        )

        marker_label = f"{pattern.marker_prefix}{sample_index}"
        template_marker = expected["template_marker"]
        plate_cycle = expected["plate_cycle"]
        expected_positions = [
            normalize_position_text(value) for value in expected["expected_wells"]
        ]

        source_labware = str(aspirate_step[1]).strip() if len(aspirate_step) > 1 else ""
        source_position = (
            normalize_position_text(aspirate_step[2]) if len(aspirate_step) > 2 else ""
        )

        actual_positions = [
            normalize_position_text(dispense[1])
            for dispense in dispenses
            if len(dispense) > 1
        ]
        actual_labwares = [
            str(dispense[0]).strip()
            for dispense in dispenses
            if dispense and str(dispense[0]).strip()
        ]

        unique_actual_labwares = []
        for labware in actual_labwares:
            if labware not in unique_actual_labwares:
                unique_actual_labwares.append(labware)

        actual_labware = (
            unique_actual_labwares[0] if len(unique_actual_labwares) == 1 else ""
        )

        missing = sorted(set(expected_positions) - set(actual_positions))
        unexpected = sorted(set(actual_positions) - set(expected_positions))
        reasons = []

        if len(actual_positions) != pattern.replicate_count:
            reasons.append(
                f"expected {pattern.replicate_count} dispense(s) for "
                f"{pattern.replicate_name}, trace showed {len(actual_positions)}"
            )

        if missing or unexpected:
            reasons.append(
                f"expected well(s) {join_values(expected_positions)}, "
                f"trace showed {join_values(actual_positions)}"
            )

        if len(unique_actual_labwares) != 1:
            reasons.append(
                "all replicates for one sample must remain on exactly one physical "
                f"destination plate; trace used {join_values(unique_actual_labwares)}"
            )
        else:
            expected_labware_for_cycle = plate_cycle_to_labware.get(plate_cycle)

            if expected_labware_for_cycle is None:
                prior_cycle = labware_to_plate_cycle.get(actual_labware)

                if prior_cycle is not None and prior_cycle != plate_cycle:
                    reasons.append(
                        f"plate cycle {plate_cycle} reused destination labware "
                        f"'{actual_labware}' already assigned to plate cycle {prior_cycle}"
                    )
                else:
                    plate_cycle_to_labware[plate_cycle] = actual_labware
                    labware_to_plate_cycle[actual_labware] = plate_cycle

            elif actual_labware != expected_labware_for_cycle:
                reasons.append(
                    f"plate cycle {plate_cycle} must remain on destination labware "
                    f"'{expected_labware_for_cycle}', but this sample used '{actual_labware}'"
                )

        for labware, position in zip(actual_labwares, actual_positions):
            seen_physical_destinations.append((labware, position))

        status = "fail" if reasons else "pass"

        finding = {
            "type": "trace_layout_match",
            "sample_number": sample_index,
            "marker": marker_label,
            "plate_layout_marker_used": template_marker,
            "template_marker": template_marker,
            "marker_number": expected["marker_number"],
            "plate_cycle": plate_cycle,
            "samples_per_plate": pattern.samples_per_plate,
            "replicate": pattern.replicate_name,
            "replicate_count": pattern.replicate_count,
            "source_labware": source_labware,
            "source_position": source_position,
            "expected_destinations": expected_positions,
            "actual_destinations": actual_positions,
            "actual_destination_labware": unique_actual_labwares,
            "missing_destinations": missing,
            "unexpected_destinations": unexpected,
            "status": status,
            "reason": "; ".join(reasons) if reasons else "Plate-layout crossmatch passed.",
        }
        findings.append(finding)

        findings.append({
            "type": "actual_trace_transfer",
            "marker": marker_label,
            "transfers": [{
                "source_labware": source_labware,
                "source_position": source_position,
                "destination_labware": unique_actual_labwares,
                "destination_wells": actual_positions,
                "plate_cycle": plate_cycle,
                "template_marker": template_marker,
            }],
        })

        if reasons:
            add_issue(
                issues,
                "critical",
                "trace vs plate layout",
                (
                    f"{marker_label} (plate cycle {plate_cycle}, template {template_marker}) "
                    f"failed plate-layout crossmatch: {'; '.join(reasons)}."
                ),
                finding,
            )

    duplicate_trace_dests = sorted({
        f"{labware}:{position}"
        for labware, position in seen_physical_destinations
        if seen_physical_destinations.count((labware, position)) > 1
    })

    if duplicate_trace_dests:
        add_issue(
            issues,
            "major",
            "trace duplicate destinations",
            "The same physical destination well was used more than once in the trace.",
            {"duplicate_destination_wells": duplicate_trace_dests},
        )

    expected_plate_count = (
        (total_samples + pattern.samples_per_plate - 1) // pattern.samples_per_plate
        if total_samples else 0
    )

    actual_plate_order = [
        plate_cycle_to_labware[cycle]
        for cycle in sorted(plate_cycle_to_labware)
    ]

    plate_count_status = (
        "pass" if len(actual_plate_order) == expected_plate_count else "fail"
    )

    findings.append({
        "type": "multi_plate_layout_summary",
        "marker_prefix": pattern.marker_prefix,
        "samples_per_plate": pattern.samples_per_plate,
        "replicate": pattern.replicate_name,
        "replicate_count": pattern.replicate_count,
        "total_samples_processed": total_samples,
        "expected_destination_plate_count": expected_plate_count,
        "actual_destination_plate_count": len(actual_plate_order),
        "actual_destination_plate_order": actual_plate_order,
        "layout_pattern_repeated": expected_plate_count > 1,
        "status": plate_count_status,
    })

    if plate_count_status == "fail":
        add_issue(
            issues,
            "critical",
            "multi-plate destination continuity",
            (
                f"{total_samples} sample(s) with {pattern.samples_per_plate} sample(s) "
                f"per plate require {expected_plate_count} destination plate(s), but "
                f"the trace resolved {len(actual_plate_order)} correctly assigned plate cycle(s)."
            ),
            {
                "expected_destination_plate_count": expected_plate_count,
                "actual_destination_plate_order": actual_plate_order,
            },
        )

    labware_findings, labware_issues = validate_trace_labware_against_layout_format(
        aspirate_to_dispense_map,
        layout_matches,
    )
    findings.extend(labware_findings)
    issues.extend(labware_issues)

    return findings, issues
'''.strip()


def replace_function(source: str, name: str, replacement: str) -> str:
    pattern = re.compile(
        rf"(?ms)^def {re.escape(name)}\b.*?(?=^def \w+\b|^class \w+\b|\Z)"
    )
    match = pattern.search(source)
    if not match:
        raise RuntimeError(f"Could not locate function: {name}")
    return source[:match.start()] + replacement.rstrip() + "\n\n" + source[match.end():]


def replace_marker_region(source: str) -> str:
    pattern = re.compile(
        r"(?ms)^def get_marker_numbers\b.*?(?=^def get_layout_marker_positions\b)"
    )
    match = pattern.search(source)
    if not match:
        raise RuntimeError(
            "Could not locate get_marker_numbers -> get_layout_marker_positions region."
        )
    return source[:match.start()] + PLATE_LAYOUT_BLOCK + "\n\n\n" + source[match.end():]


