import sys
import subprocess
from pathlib import Path
from datetime import datetime


# ============================================================
# CONFIGURATION
# ============================================================

CELLPROFILER_EXE = Path(
    r"C:\Program Files\CellProfiler\CellProfiler.exe"
)

INPUT_ROOT = Path(
    r"C:\Input Files\CP"
)

OUTPUT_ROOT = Path(
    r"C:\Output Files\CP"
)

SUPPORTED_IMAGE_EXTENSIONS = {
    ".png",
    ".jpg",
    ".jpeg",
    ".tif",
    ".tiff",
    ".bmp"
}


# ============================================================
# LOGGING
# ============================================================

def write_log(log_file: Path, message: str):
    """
    Write a timestamped message to the run log.
    """

    timestamp = datetime.now().strftime(
        "%Y-%m-%d %H:%M:%S"
    )

    with log_file.open(
        "a",
        encoding="utf-8"
    ) as file:

        file.write(
            f"[{timestamp}] {message}\n"
        )


# ============================================================
# FIND LATEST TIMESTAMPED INPUT FOLDER
# ============================================================

def get_latest_input_folder() -> Path:
    """
    Find the newest valid timestamped folder under:

        C:\\Input Files\\CP

    Expected folder format:

        DDMonYYYYHHMMSS

    Example:

        03Sep2026120104

    Meaning:

        03 Sep 2026
        12:01:04
    """

    if not INPUT_ROOT.exists():
        raise FileNotFoundError(
            f"Input root does not exist: "
            f"{INPUT_ROOT}"
        )

    valid_folders = []

    for folder in INPUT_ROOT.iterdir():

        if not folder.is_dir():
            continue

        try:

            folder_timestamp = datetime.strptime(
                folder.name,
                "%d%b%Y%H%M%S"
            )

            valid_folders.append(
                (
                    folder_timestamp,
                    folder
                )
            )

        except ValueError:

            # Ignore any folder that does not match
            # the expected timestamp format.
            continue

    if not valid_folders:

        raise FileNotFoundError(
            "No valid CellProfiler timestamp folders "
            f"were found under {INPUT_ROOT}"
        )

    # Select folder with latest timestamp encoded
    # in the folder name.
    latest_timestamp, latest_folder = max(
        valid_folders,
        key=lambda item: item[0]
    )

    return latest_folder.resolve()


# ============================================================
# DETERMINE WHICH INPUT FOLDER TO USE
# ============================================================

def get_input_folder() -> Path:
    """
    If a folder path was supplied to Python,
    use that folder.

    Otherwise automatically locate the newest
    timestamped folder.
    """

    if len(sys.argv) >= 2:

        input_folder = Path(
            sys.argv[1]
        ).resolve()

        print(
            "Input folder supplied by caller:"
        )

        print(
            input_folder
        )

    else:

        input_folder = (
            get_latest_input_folder()
        )

        print(
            "No input folder supplied."
        )

        print(
            "Using latest CellProfiler folder:"
        )

        print(
            input_folder
        )

    return input_folder


# ============================================================
# FIND PIPELINE
# ============================================================

def get_pipeline_file(
    input_folder: Path
) -> Path:
    """
    Locate exactly one .cppipe file in
    the selected input folder.
    """

    pipelines = [
        file
        for file in input_folder.iterdir()
        if (
            file.is_file()
            and file.suffix.lower() == ".cppipe"
        )
    ]

    if len(pipelines) == 0:

        raise FileNotFoundError(
            "No .cppipe pipeline file was found "
            f"in {input_folder}"
        )

    if len(pipelines) > 1:

        pipeline_names = "\n".join(
            pipeline.name
            for pipeline in pipelines
        )

        raise RuntimeError(
            "More than one .cppipe file was found. "
            "Exactly one pipeline is required.\n\n"
            f"Files found:\n{pipeline_names}"
        )

    return pipelines[0]


# ============================================================
# FIND IMAGE FILES
# ============================================================

def get_image_files(
    input_folder: Path
):
    """
    Locate supported image files.
    Workflow requires between 1 and 3 images.
    """

    image_files = [
        file
        for file in input_folder.iterdir()
        if (
            file.is_file()
            and file.suffix.lower()
            in SUPPORTED_IMAGE_EXTENSIONS
        )
    ]

    if len(image_files) == 0:

        raise FileNotFoundError(
            "No supported image files were found "
            f"in {input_folder}"
        )

    if len(image_files) > 3:

        raise RuntimeError(
            "Expected between 1 and 3 image files, "
            f"but found {len(image_files)}."
        )

    return image_files


# ============================================================
# RUN CELLPROFILER
# ============================================================

def run_cellprofiler(
    input_folder: Path,
    pipeline_file: Path,
    image_files,
    output_folder: Path,
    log_file: Path
) -> int:
    """
    Launch CellProfiler in headless mode and
    automatically execute the supplied pipeline.
    """

    command = [

        str(CELLPROFILER_EXE),

        # Run without opening the CellProfiler GUI.
        "-c",

        # Immediately run the pipeline.
        "-r",

        # Pipeline file.
        "-p",
        str(pipeline_file),

        # Default input directory.
        "-i",
        str(input_folder),

        # Default output directory.
        "-o",
        str(output_folder)
    ]

    write_log(
        log_file,
        "CellProfiler analysis starting."
    )

    write_log(
        log_file,
        f"CellProfiler executable: "
        f"{CELLPROFILER_EXE}"
    )

    write_log(
        log_file,
        f"Input folder: "
        f"{input_folder}"
    )

    write_log(
        log_file,
        f"Pipeline: "
        f"{pipeline_file}"
    )

    write_log(
        log_file,
        f"Output folder: "
        f"{output_folder}"
    )

    write_log(
        log_file,
        f"Image count: "
        f"{len(image_files)}"
    )

    for image_file in image_files:

        write_log(
            log_file,
            f"Input image: "
            f"{image_file.name}"
        )

    readable_command = " ".join(
        f'"{argument}"'
        if " " in argument
        else argument
        for argument in command
    )

    write_log(
        log_file,
        "Command:"
    )

    write_log(
        log_file,
        readable_command
    )

    print()
    print(
        "Launching CellProfiler..."
    )

    print(
        f"Pipeline: {pipeline_file.name}"
    )

    print(
        f"Images: {len(image_files)}"
    )

    print(
        f"Output: {output_folder}"
    )

    try:

        result = subprocess.run(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            shell=False
        )

    except Exception as error:

        write_log(
            log_file,
            "Failed to launch CellProfiler."
        )

        write_log(
            log_file,
            f"{type(error).__name__}: "
            f"{error}"
        )

        raise

    # --------------------------------------------------------
    # Save CellProfiler console output
    # --------------------------------------------------------

    if result.stdout:

        write_log(
            log_file,
            "----- CELLPROFILER STDOUT -----"
        )

        with log_file.open(
            "a",
            encoding="utf-8"
        ) as file:

            file.write(
                result.stdout
            )

            if not result.stdout.endswith("\n"):
                file.write("\n")

    if result.stderr:

        write_log(
            log_file,
            "----- CELLPROFILER STDERR -----"
        )

        with log_file.open(
            "a",
            encoding="utf-8"
        ) as file:

            file.write(
                result.stderr
            )

            if not result.stderr.endswith("\n"):
                file.write("\n")

    # --------------------------------------------------------
    # Evaluate return code
    # --------------------------------------------------------

    if result.returncode == 0:

        write_log(
            log_file,
            "CellProfiler completed successfully."
        )

        print()
        print(
            "CELLPROFILER SUCCESS"
        )

        print(
            f"Pipeline: "
            f"{pipeline_file.name}"
        )

        print(
            f"Images processed: "
            f"{len(image_files)}"
        )

        print(
            f"Output folder: "
            f"{output_folder}"
        )

        print(
            f"Log file: "
            f"{log_file}"
        )

        return 0

    else:

        write_log(
            log_file,
            "CellProfiler returned an error."
        )

        write_log(
            log_file,
            f"Exit code: "
            f"{result.returncode}"
        )

        print()
        print(
            "CELLPROFILER ERROR"
        )

        print(
            f"Exit code: "
            f"{result.returncode}"
        )

        print(
            f"See log: "
            f"{log_file}"
        )

        return result.returncode


# ============================================================
# MAIN
# ============================================================

def main():

    try:

        # ----------------------------------------------------
        # Verify CellProfiler installation
        # ----------------------------------------------------

        if not CELLPROFILER_EXE.exists():

            print(
                "ERROR:"
            )

            print(
                "CellProfiler.exe was not found:"
            )

            print(
                CELLPROFILER_EXE
            )

            return 4

        # ----------------------------------------------------
        # Determine input folder
        # ----------------------------------------------------

        input_folder = (
            get_input_folder()
        )

        if not input_folder.exists():

            print(
                "ERROR:"
            )

            print(
                "Input folder does not exist:"
            )

            print(
                input_folder
            )

            return 2

        if not input_folder.is_dir():

            print(
                "ERROR:"
            )

            print(
                "Input path is not a folder:"
            )

            print(
                input_folder
            )

            return 3

        # ----------------------------------------------------
        # Locate pipeline
        # ----------------------------------------------------

        pipeline_file = (
            get_pipeline_file(
                input_folder
            )
        )

        # ----------------------------------------------------
        # Locate images
        # ----------------------------------------------------

        image_files = (
            get_image_files(
                input_folder
            )
        )

        # ----------------------------------------------------
        # Create matching output folder
        # ----------------------------------------------------

        output_folder = (
            OUTPUT_ROOT
            / input_folder.name
        )

        output_folder.mkdir(
            parents=True,
            exist_ok=True
        )

        # ----------------------------------------------------
        # Create log file
        # ----------------------------------------------------

        log_file = (
            output_folder
            / "CellProfiler_Run.log"
        )

        write_log(
            log_file,
            "========================================"
        )

        write_log(
            log_file,
            "NEW CELLPROFILER RUN"
        )

        write_log(
            log_file,
            "========================================"
        )

        # ----------------------------------------------------
        # Run CellProfiler
        # ----------------------------------------------------

        return run_cellprofiler(
            input_folder=input_folder,
            pipeline_file=pipeline_file,
            image_files=image_files,
            output_folder=output_folder,
            log_file=log_file
        )

    except FileNotFoundError as error:

        print()
        print(
            "FILE ERROR"
        )

        print(
            str(error)
        )

        return 10

    except RuntimeError as error:

        print()
        print(
            "VALIDATION ERROR"
        )

        print(
            str(error)
        )

        return 11

    except Exception as error:

        print()
        print(
            "UNEXPECTED ERROR"
        )

        print(
            f"{type(error).__name__}: "
            f"{error}"
        )

        return 99


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":

    exit_code = main()

    sys.exit(
        exit_code
    )
