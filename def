def _get_optional_interface_command(name, fallback=None):
    try:
        import pyhamilton.interface as interface_module
        return getattr(interface_module, name, fallback or name)
    except Exception:
        return fallback or name


PICKUP384 = _get_optional_interface_command("PICKUP384", "PICKUP384")
EJECT384 = _get_optional_interface_command("EJECT384", "EJECT384")
ASPIRATE384 = _get_optional_interface_command("ASPIRATE384", "ASPIRATE384")
DISPENSE384 = _get_optional_interface_command("DISPENSE384", "DISPENSE384")


def normalize_channel_pattern(channel, allowed=(8, 12, 14, 16)):
    pattern = str(channel or "").strip()

    if not pattern:
        raise ValueError("Channel pattern is required.")

    if not re_match_binary(pattern):
        raise ValueError(f"Invalid channel pattern: {pattern}")

    if len(pattern) not in allowed:
        raise ValueError(
            f"Invalid channel pattern length {len(pattern)}. "
            f"Allowed channel-mode lengths are {allowed}."
        )

    if "1" not in pattern:
        raise ValueError("Channel pattern must contain at least one active channel.")

    return pattern


def re_match_binary(pattern):
    return all(char in {"0", "1"} for char in str(pattern))


def normalize_head_size(head_size):
    try:
        head_size = int(head_size)
    except Exception:
        head_size = 96

    if head_size not in {96, 384}:
        raise ValueError(f"Unsupported head size: {head_size}. Use 96 or 384.")

    return head_size


def normalize_head_pattern(head_size):
    head_size = normalize_head_size(head_size)

    if head_size == 96:
        return _channel_patt_96

    if head_size == 384:
        return _channel_patt_384

    raise ValueError(f"Unsupported head size: {head_size}")


def command_for_head(base_command, head_size):
    head_size = normalize_head_size(head_size)

    if head_size == 96:
        if base_command == "pickup":
            return PICKUP96
        if base_command == "eject":
            return EJECT96
        if base_command == "aspirate":
            return ASPIRATE96
        if base_command == "dispense":
            return DISPENSE96

    if head_size == 384:
        if base_command == "pickup":
            return PICKUP384
        if base_command == "eject":
            return EJECT384
        if base_command == "aspirate":
            return ASPIRATE384
        if base_command == "dispense":
            return DISPENSE384

    raise ValueError(f"Unsupported head command: {base_command}, head_size={head_size}")


def resource_list_with_prefix(layout_manager, prefix, res_class, num_ress, order_key=None, reverse=False):
    def name_from_line(line):
        field = LayoutManager.layline_objid(line)
        if field:
            return field
        return LayoutManager.layline_first_field(line)

    layline_test = lambda line: LayoutManager.field_starts_with(name_from_line(line), prefix)
    res_type = ResourceType(res_class, layline_test, name_from_line)
    return [
        layout_manager.assign_unused_resource(res_type, order_key=order_key, reverse=reverse)
        for _ in range(num_ress)
    ]


def layout_item(lmgr, item_class, item_name):
    return lmgr.assign_unused_resource(ResourceType(item_class, item_name))


def labware_pos_str(labware, idx):
    return labware.layout_name() + ", " + labware.position_id(idx)


def compound_pos_str(pos_tuples):
    present_pos_tups = [pt for pt in pos_tuples if pt is not None]
    return ";".join((labware_pos_str(labware, idx) for labware, idx in present_pos_tups))


def compound_pos_str_head(labware, head_size=96):
    head_size = normalize_head_size(head_size)
    return ";".join((labware_pos_str(labware, idx) for idx in range(head_size)))


def compound_pos_str_96(labware96):
    return compound_pos_str_head(labware96, 96)


def initialize(ham, asynch=False):
    logging.info("initialize: " + ("a" if asynch else "") + "synchronously initialize the robot")
    cmd = ham.send_command(INITIALIZE)
    if not asynch:
        ham.wait_on_response(cmd, raise_first_exception=True, timeout=300)
    return cmd


