def infer_tip_type_from_text(text: str) -> str:
    raw = str(text or "").upper()
    compact = re.sub(r"[^A-Z0-9]+", "", raw)

    if any(token in compact for token in (
        "HIGHVOLUME",
        "HIGHVOL",
        "HIGHPROFILE",
        "HIGHVOLUMETIPS",
        "HIGHVOLUMEFILTER",
        "HAMILTON1000",
        "1000UL",
        "1000",
        "HTL",
        "HTF",
        "HVT",
        "HV",
        "MLSTARHIGHVOLUMETIPS",
        "MLSTARHIGHVOLUME",
        "HIGHVOLUMEFILTERTIP",
        "HIGHVOLUMETIP",
        "TIP1000",
    )):
        return "1000ul"

    if any(token in compact for token in (
        "STANDARDVOLUME",
        "STANDARDVOL",
        "STANDARDVOLUMETIPS",
        "STANDARDVOLUMEFILTER",
        "STANDARD",
        "SLIMTIP",
        "SLIM",
        "300UL",
        "300",
        "STL",
        "STF",
        "SVT",
        "STD",
        "MLSTARSTANDARDVOLUMETIPS",
        "MLSTARSTANDARDVOLUME",
        "STANDARDVOLUMETIP",
        "TIP300",
    )):
        return "300ul"

    if any(token in compact for token in (
        "LOWVOLUME",
        "LOWVOL",
        "LOWVOLUMETIPS",
        "LOWVOLUMEFILTER",
        "50UL",
        "LTL",
        "LTF",
        "LVT",
        "LV",
        "MLSTARLOWVOLUMETIPS",
        "MLSTARLOWVOLUME",
        "LOWVOLUMETIP",
        "TIP50",
    )):
        return "50ul"

    return ""






def infer_tip_type_for_set(
    set_order: int,
    configs: List[SequenceStepConfig],
    lay_metadata: Dict[str, Dict[str, Any]],
) -> Tuple[str, str]:
    tip_configs = [
        c for c in configs
        if int(c.set_order) == int(set_order)
        and c.role == "tip pick up"
    ]

    liquid_configs = [
        c for c in configs
        if int(c.set_order) == int(set_order)
        and c.role in ("aspirate", "dispense")
    ]

    evidence_seen = []

    for config in tip_configs:
        meta = get_sequence_labware_metadata(
            config.sequence,
            lay_metadata,
            getattr(config, "sequence_count", 0),
        )

        searchable_values = [
            config.sequence,
            meta.get("sequence_name", ""),
            meta.get("labware_name", ""),
            meta.get("labware_file", ""),
            meta.get("template", ""),
            meta.get("managed_sequence", ""),
            meta.get("labware_format", ""),
            " ".join(meta.get("positions", []) or []),
        ]

        for key, value in meta.items():
            if isinstance(value, str):
                searchable_values.append(value)
            elif isinstance(value, list):
                searchable_values.append(" ".join(str(v) for v in value))

        searchable_text = " | ".join(str(v) for v in searchable_values if str(v or "").strip())
        evidence_seen.append(f"Tip sequence {config.sequence}: {searchable_text}")

        tip_type = normalize_tip_type(infer_tip_type_from_text(searchable_text))

        if tip_type in {"1000ul", "300ul", "50ul"}:
            return tip_type, evidence_seen[-1]

    for config in liquid_configs:
        searchable_text = " | ".join([
            str(config.sequence or ""),
            str(config.liquid_class or ""),
            str(config.hardware_mode or ""),
        ])

        tip_type = normalize_tip_type(infer_tip_type_from_text(searchable_text))
        evidence_seen.append(f"Liquid step {config.sequence}: {searchable_text}")

        if tip_type in {"1000ul", "300ul", "50ul"}:
            return tip_type, evidence_seen[-1]

    selected_tip_counts = [
        int(getattr(config, "sequence_count", 0) or 0)
        for config in tip_configs
    ]

    if selected_tip_counts:
        max_tip_count = max(selected_tip_counts)

        if max_tip_count >= 96:
            return "1000ul", f"Fallback from selected tip sequence count {max_tip_count}; treated as high-volume compatible."

    return "", " | ".join(evidence_seen) if evidence_seen else "No tip pick up sequence selected."







def validate_tip_volume_rules(
    configs: List[SequenceStepConfig],
    lay_metadata: Dict[str, Dict[str, Any]],
) -> List[ValidationIssue]:
    issues = []

    set_numbers = sorted({int(c.set_order) for c in configs})

    for set_order in set_numbers:
        set_configs = [c for c in configs if int(c.set_order) == int(set_order)]
        liquid_steps = [c for c in set_configs if c.role in ("aspirate", "dispense")]

        if not liquid_steps:
            continue

        tip_type, evidence = infer_tip_type_for_set(set_order, configs, lay_metadata)

        if not tip_type:
            issues.append(ValidationIssue(
                "minor",
                "tip volume rule",
                f"Tip type could not be confirmed for Set {set_order}; volume rule check was skipped instead of blocking the run.",
                {
                    "set_order": set_order,
                    "checked_metadata": evidence,
                },
            ))
            continue

        for config in liquid_steps:
            if not tip_volume_allowed(tip_type, config.hardware_mode, config.volume_ul):
                issues.append(ValidationIssue(
                    "critical",
                    "tip volume rule",
                    (
                        f"Volume {config.volume_ul} uL is not valid for {tip_type} tips "
                        f"in {config.hardware_mode} mode for Set {set_order}."
                    ),
                    {
                        "set_order": set_order,
                        "sequence": config.sequence,
                        "tip_type_detected": tip_type,
                        "volume_ul": config.volume_ul,
                        "hardware_mode": config.hardware_mode,
                        "tip_detection_evidence": evidence,
                    },
                ))

    return issues





