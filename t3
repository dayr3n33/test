def validate_expected_runtime_steps(
    execution_plan: List[Dict[str, Any]],
    ordered_steps: List[Dict[str, Any]],
    trace_text: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []

    expected_actions = [
        item.get("action")
        for item in execution_plan
        if item.get("action") in {"tip_pick", "aspirate", "dispense", "tip_eject"}
    ]

    actual_actions = []

    for step in ordered_steps:
        step_type = step.get("type", "")

        if "aspirate" in step_type:
            actual_actions.append("aspirate")
        elif "dispense" in step_type:
            actual_actions.append("dispense")
        elif "tip_pick" in step_type or "tip pick" in step_type:
            actual_actions.append("tip_pick")
        elif "tip_eject" in step_type or "tip eject" in step_type:
            actual_actions.append("tip_eject")

    trace_lower = trace_text.lower()
    runtime_error_reason = ""

    error_match = re.search(
        r"main\s*-\s*error;\s*(.*?)(?:\n|$)",
        trace_text,
        re.IGNORECASE,
    )

    if error_match:
        runtime_error_reason = error_match.group(1).strip()

    if "tip type mismatch" in trace_lower:
        runtime_error_reason = "Tip type mismatch. The selected liquid class is not compatible with the picked tip type."

    expected_count = len(expected_actions)
    actual_count = len(actual_actions)

    status = "pass" if actual_count >= expected_count and not runtime_error_reason else "fail"

    finding = {
        "type": "expected_runtime_step_check",
        "status": status,
        "planned_liquid_handling_step_count": expected_count,
        "trace_liquid_handling_step_count": actual_count,
        "runtime_error_reason": runtime_error_reason,
    }

    findings.append(finding)

    if status != "pass":
        message = (
            f"Runtime did not execute all planned liquid-handling steps. "
            f"Planned {expected_count}; trace showed {actual_count}."
        )

        if runtime_error_reason:
            message += f" Reason: {runtime_error_reason}"

        issues.append(ValidationIssue(
            "critical",
            "runtime step execution",
            message,
            finding,
        ))

    return findings, issues








def validate_trace_against_layout(
    aspirate_to_dispense_map: Dict[Any, Any],
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []
    marker = marker.upper().strip()

    missing_by_marker = defaultdict(set)
    unexpected_by_marker = defaultdict(set)
    expected_by_marker = defaultdict(set)
    actual_by_marker = defaultdict(set)
    replicate_mismatch_by_marker = {}
    seen_trace_destinations = []

    sorted_transfers = list(aspirate_to_dispense_map.items())

    for sample_index, (aspirate_step, dispenses) in enumerate(sorted_transfers, start=1):
        displayed_marker = f"{marker}{sample_index}"

        layout_marker, repeated_layout_number = resolve_repeating_layout_marker(
            sample_index,
            layout_matches,
            marker,
        )

        expected_positions = get_layout_marker_positions(layout_matches, layout_marker)
        actual_positions = [normalize_position_text(dispense[1]) for dispense in dispenses]
        actual_labware = sorted({str(dispense[0]).strip() for dispense in dispenses if dispense})

        seen_trace_destinations.extend(actual_positions)

        expected_by_marker[displayed_marker].update(expected_positions)
        actual_by_marker[displayed_marker].update(actual_positions)

        missing = sorted(set(expected_positions) - set(actual_positions))
        unexpected = sorted(set(actual_positions) - set(expected_positions))

        if missing:
            missing_by_marker[displayed_marker].update(missing)

        if unexpected:
            unexpected_by_marker[displayed_marker].update(unexpected)

        if len(actual_positions) != len(expected_positions):
            replicate_mismatch_by_marker[displayed_marker] = {
                "plate_layout_marker_used": layout_marker,
                "expected_replicate_count_from_plate_layout": len(expected_positions),
                "actual_dispense_count_from_trace": len(actual_positions),
                "expected_destination_wells": expected_positions,
                "trace_destination_wells": actual_positions,
                "trace_destination_labware": actual_labware,
            }

        findings.append({
            "type": "trace_layout_match",
            "marker": displayed_marker,
            "plate_layout_marker_used": layout_marker,
            "plate_layout_marker_repeated_from_sample_number": repeated_layout_number,
            "expected_destinations": expected_positions,
            "actual_destinations": actual_positions,
            "actual_destination_labware": actual_labware,
            "missing_destinations": missing,
            "unexpected_destinations": unexpected,
            "status": "pass" if not missing and not unexpected and len(actual_positions) == len(expected_positions) else "fail",
        })

    if missing_by_marker:
        for marker_label, wells in sorted(missing_by_marker.items()):
            add_issue(
                issues,
                "critical",
                "trace vs plate layout",
                f"{marker_label}: expected destination wells were not found in the trace.",
                {
                    "expected_wells_not_found": sorted(wells),
                    "plate_layout_expected_wells": sorted(expected_by_marker.get(marker_label, [])),
                    "trace_found_wells": sorted(actual_by_marker.get(marker_label, [])),
                },
            )

    if unexpected_by_marker:
        for marker_label, wells in sorted(unexpected_by_marker.items()):
            add_issue(
                issues,
                "critical",
                "trace vs plate layout",
                f"{marker_label}: trace dispensed into wells not assigned to this marker in the plate layout.",
                {
                    "wrong_trace_wells": sorted(wells),
                    "plate_layout_expected_wells": sorted(expected_by_marker.get(marker_label, [])),
                    "trace_found_wells": sorted(actual_by_marker.get(marker_label, [])),
                },
            )

    for marker_label, evidence in sorted(replicate_mismatch_by_marker.items()):
        add_issue(
            issues,
            "major",
            "replicate mismatch",
            f"{marker_label}: plate layout replicate count and trace dispense count do not match.",
            evidence,
        )

    duplicate_trace_dests = sorted([
        pos for pos in set(seen_trace_destinations)
        if seen_trace_destinations.count(pos) > 1
    ])

    if duplicate_trace_dests:
        add_issue(
            issues,
            "major",
            "trace duplicate destinations",
            "Duplicate destination wells were found in the trace.",
            {
                "duplicate_destination_wells": duplicate_trace_dests,
            },
        )

    labware_findings, labware_issues = validate_trace_labware_against_layout_format(
        aspirate_to_dispense_map,
        layout_matches,
    )
    findings.extend(labware_findings)
    issues.extend(labware_issues)

    return findings, issues









def validate_tracking_source_order(
    aspirate_to_dispense_map: Dict[Any, Any],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []
    marker = marker.upper().strip()

    mismatches = []

    for expected_order, (aspirate_step, dispenses) in enumerate(aspirate_to_dispense_map.items(), start=1):
        source_labware = str(aspirate_step[1]).strip()
        source_position_text = str(aspirate_step[2]).strip()
        actual_marker = f"{marker}{expected_order}"

        findings.append({
            "type": "tracking_source_order",
            "marker": actual_marker,
            "expected_order": expected_order,
            "source_labware": source_labware,
            "source_position": source_position_text,
            "dispense_count": len(dispenses),
            "status": "pass",
        })

    return findings, issues











def build_report_sections(output: DevPalLiteOutput, report_path: str) -> Dict[str, Any]:
    issue_groups = defaultdict(lambda: {
        "severity": "",
        "category": "",
        "messages": set(),
        "evidence": defaultdict(set),
    })

    severity_rank = {"critical": 3, "major": 2, "minor": 1, "info": 0}

    for issue in output.issues or []:
        if not isinstance(issue, dict):
            continue

        severity = str(issue.get("severity", "")).lower()
        if severity not in {"critical", "major"}:
            continue

        category = humanize_key(issue.get("category", "Issue"))
        message = safe_text(issue.get("message", ""))

        key = category.lower()
        group = issue_groups[key]

        if not group["severity"] or severity_rank.get(severity, 0) > severity_rank.get(group["severity"], 0):
            group["severity"] = severity

        group["category"] = category

        if message:
            group["messages"].add(message)

        evidence = issue.get("evidence") or {}
        if isinstance(evidence, dict):
            for ev_key, ev_value in evidence.items():
                if ev_key in {"message", "type", "status"}:
                    continue

                if ev_value in (None, "", [], {}):
                    continue

                label = humanize_key(ev_key)

                if isinstance(ev_value, list):
                    for item in ev_value:
                        group["evidence"][label].add(safe_text(item))
                elif isinstance(ev_value, dict):
                    for nested_key, nested_value in ev_value.items():
                        if nested_value not in (None, "", [], {}):
                            group["evidence"][label].add(f"{safe_text(nested_key)}: {safe_text(nested_value)}")
                else:
                    group["evidence"][label].add(safe_text(ev_value))

    major_critical = []
    for _, group in sorted(issue_groups.items(), key=lambda item: item[0]):
        major_critical.append({
            "severity": group["severity"],
            "category": group["category"],
            "messages": sorted(group["messages"]),
            "evidence": {
                key: sorted(values)
                for key, values in group["evidence"].items()
                if values
            },
        })

    critical_issue_count = sum(
        1
        for issue in output.issues or []
        if isinstance(issue, dict) and str(issue.get("severity", "")).lower() == "critical"
    )

    role_order = {
        "tip pick up": 1,
        "aspirate": 2,
        "dispense": 3,
    }

    selected_sequences = []
    ordered_configs = sorted(
        output.selected_sequences or [],
        key=lambda c: (
            int(c.get("set_order", 1) or 1),
            role_order.get(str(c.get("role", "")).lower(), 99),
            int(c.get("selected_index", 0) or 0),
        ) if isinstance(c, dict) else (999, 999, 999),
    )

    for config in ordered_configs:
        if not isinstance(config, dict):
            continue

        role = humanize_key(config.get("role", ""))
        sequence = safe_text(config.get("sequence", ""))
        set_order = safe_text(config.get("set_order", "1"))
        hardware = safe_text(config.get("hardware_mode", "")).replace(" mode", "")
        channel = safe_text(config.get("channel_pattern", ""))
        volume = config.get("volume_ul", "")
        liquid_class = safe_text(config.get("liquid_class", ""))
        count = safe_text(config.get("sequence_count", ""))

        line = f"Set {set_order}: {role} - {sequence}, using {hardware}"

        if str(config.get("role", "")).lower() in {"aspirate", "dispense"}:
            line += f", {safe_text(volume)} uL, LC {liquid_class}"

        line += f", channel pattern {channel}, sequence count {count}"
        selected_sequences.append(line)

    transfer_summary_by_marker = {}

    for pair in output.transfer_pairs or []:
        if not isinstance(pair, dict):
            continue

        marker_label = safe_text(pair.get("marker_label", ""))
        if marker_label == "None":
            continue

        source_sequence = safe_text(pair.get("source_sequence", ""))
        destination_sequence = safe_text(pair.get("destination_sequence", ""))
        destination_well = safe_text(pair.get("destination_position", ""))
        volume = safe_text(pair.get("volume_ul", ""))
        liquid_class = safe_text(pair.get("liquid_class", ""))

        transfer_summary_by_marker[marker_label] = (
            f"{marker_label}: aspirate from {source_sequence} → dispense to {destination_sequence} well {destination_well}, "
            f"{volume} uL, LC {liquid_class}"
        )

    transfer_summary = [
        transfer_summary_by_marker[key]
        for key in sorted(
            transfer_summary_by_marker,
            key=lambda value: extract_position_number(value) or 0,
        )
    ]

    marker_summary = []
    for marker_label, entries in sorted(
        (output.marker_matches or {}).items(),
        key=lambda item: extract_position_number(item[0]) or 0,
    ):
        locations = []

        for entry in entries or []:
            if not isinstance(entry, dict):
                continue

            dest = safe_text(entry.get("dest_value", ""))
            value = safe_text(entry.get("cell_value", ""))

            if dest != "None":
                locations.append(f"{dest} contains {value}")

        marker_summary.append(f"{safe_text(marker_label)}: {join_values(locations)}")

    layout_summary = []
    for finding in output.layout_findings or []:
        if not isinstance(finding, dict):
            continue

        if finding.get("type") == "layout_summary":
            layout_summary.append(
                f"Plate layout marker {safe_text(finding.get('marker'))}: "
                f"{safe_text(finding.get('marker_count'))} marker(s), "
                f"{safe_text(finding.get('unique_layout_position_count'))} destination well(s)."
            )

    trace_summary = []
    has_trace_layout_failure = False

    for finding in output.trace_findings or []:
        if isinstance(finding, dict) and finding.get("type") == "trace_layout_match" and finding.get("status") == "fail":
            has_trace_layout_failure = True
            break

    for finding in output.trace_findings or []:
        if not isinstance(finding, dict):
            continue

        finding_type = str(finding.get("type", "")).lower()

        if finding_type == "trace_summary":
            trace_summary.append(
                f"Trace parsed: {safe_text(finding.get('aspirate_step_count'))} aspirate step(s), "
                f"{safe_text(finding.get('dispense_step_count'))} dispense step(s). "
                f"Plate layout crossmatch {'failed' if has_trace_layout_failure else safe_text(finding.get('cross_match_status'))}."
            )

        elif finding_type == "expected_runtime_step_check":
            if finding.get("status") != "pass":
                trace_summary.append(
                    f"Runtime step check failed: planned {safe_text(finding.get('planned_liquid_handling_step_count'))} "
                    f"liquid-handling step(s); trace showed {safe_text(finding.get('trace_liquid_handling_step_count'))}."
                )

    failed_markers = defaultdict(lambda: {"expected": set(), "actual": set()})

    for finding in output.trace_findings or []:
        if not isinstance(finding, dict):
            continue

        if finding.get("type") != "trace_layout_match" or finding.get("status") != "fail":
            continue

        marker_label = safe_text(finding.get("marker", ""))
        for well in finding.get("expected_destinations", []) or []:
            failed_markers[marker_label]["expected"].add(safe_text(well))
        for well in finding.get("actual_destinations", []) or []:
            failed_markers[marker_label]["actual"].add(safe_text(well))

    for marker_label in sorted(failed_markers, key=lambda value: extract_position_number(value) or 0):
        expected = sorted(failed_markers[marker_label]["expected"])
        actual = sorted(failed_markers[marker_label]["actual"])

        trace_summary.append(
            f"{marker_label}: expected plate layout wells {join_values(expected)}; trace dispensed to {join_values(actual)}."
        )

    return {
        "major_critical": major_critical,
        "selected_sequences": selected_sequences,
        "transfer_summary": transfer_summary,
        "marker_summary": marker_summary,
        "layout_summary": layout_summary,
        "trace_summary": trace_summary,
        "summary": {
            "Generated": normal_datetime(),
            "LAY File": compact_path(output.lay_file),
            "Plate Layout File": compact_path(output.layout_file),
            "Report Path": compact_path(report_path),
            "Number of Critical Issues": critical_issue_count,
        },
    }








def write_docx_report(output: DevPalLiteOutput, output_dir: str) -> str:
    if Document is None:
        return write_text_report(output, output_dir)

    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.docx",
    )

    sections = build_report_sections(output, path)

    doc = Document()
    doc.add_heading("DevPal Lite Validation Report", 0)

    doc.add_heading("Run Summary", level=1)
    for label, value in sections["summary"].items():
        paragraph = doc.add_paragraph()
        paragraph.add_run(f"{label}: ").bold = True
        paragraph.add_run(safe_text(value))

    doc.add_heading("Major / Critical Issues", level=1)

    if sections["major_critical"]:
        for index, group in enumerate(sections["major_critical"], start=1):
            title = f"{index}. {humanize_key(group.get('severity'))} issue with {humanize_key(group.get('category'))}"
            write_docx_line(doc, title, bold=True, red=True)

            for message in group.get("messages", []):
                write_docx_line(doc, f"- {message}", red=True)

            evidence = group.get("evidence") or {}
            for key, values in evidence.items():
                if values:
                    write_docx_line(doc, f"{key}: {join_values(values)}", red=True)
    else:
        doc.add_paragraph("No major or critical issues found.")

    doc.add_heading("What Was Run", level=1)
    write_docx_bullets(doc, sections["selected_sequences"])

    doc.add_heading("Transfer Log", level=1)
    write_docx_bullets(doc, sections["transfer_summary"])

    doc.add_heading("Plate Layout Marker Review", level=1)
    write_docx_bullets(
        doc,
        sections["marker_summary"] or ["No marker matches were found in the uploaded plate layout."],
    )

    doc.add_heading("Layout Summary", level=1)
    write_docx_bullets(doc, sections["layout_summary"])

    doc.add_heading("Trace / Runtime Summary", level=1)
    write_docx_bullets(doc, sections["trace_summary"])

    doc.save(path)
    return path















