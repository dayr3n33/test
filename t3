import os
import io
import boto3
import tkinter as tk
from tkinter import filedialog, messagebox
from PIL import Image, ImageEnhance, ImageFilter
from docx import Document
from reportlab.lib.pagesizes import letter
from reportlab.lib.styles import getSampleStyleSheet
from reportlab.lib.units import inch
from reportlab.platypus import SimpleDocTemplate, Paragraph, Spacer, PageBreak
from xml.sax.saxutils import escape
from datetime import datetime

AWS_REGION = "us-east-1"
AWS_PROFILE = "default"


def get_textract_client():
    session = boto3.Session(profile_name=AWS_PROFILE)
    credentials = session.get_credentials()

    if credentials is None:
        raise RuntimeError("No AWS credentials were found.")

    frozen_credentials = credentials.get_frozen_credentials()

    print("AWS credentials found")
    print(f"Access key: {frozen_credentials.access_key[:4]}...{frozen_credentials.access_key[-4:]}")
    print(f"Region: {AWS_REGION}")

    client = session.client("textract", region_name=AWS_REGION)
    return client


def test_aws_connection(client):
    sts = boto3.Session(profile_name=AWS_PROFILE).client(
        "sts",
        region_name=AWS_REGION
    )

    identity = sts.get_caller_identity()

    print("AWS connection successful")
    print(f"Account: {identity.get('Account')}")
    print(f"ARN: {identity.get('Arn')}")

    return identity


def load_image_bytes(image_path):
    image = Image.open(image_path)

    if image.mode not in ("RGB", "L"):
        image = image.convert("RGB")

    image = image.filter(ImageFilter.SHARPEN)
    image = ImageEnhance.Sharpness(image).enhance(1.5)

    max_dimension = 5000

    if max(image.size) > max_dimension:
        ratio = max_dimension / max(image.size)
        image = image.resize(
            (
                int(image.width * ratio),
                int(image.height * ratio)
            ),
            Image.LANCZOS
        )

    buffer = io.BytesIO()
    image.save(buffer, format="PNG", optimize=True)

    image_bytes = buffer.getvalue()

    if len(image_bytes) > 5 * 1024 * 1024:
        buffer = io.BytesIO()
        image.convert("RGB").save(
            buffer,
            format="JPEG",
            quality=90,
            optimize=True
        )
        image_bytes = buffer.getvalue()

    if len(image_bytes) > 5 * 1024 * 1024:
        raise ValueError(
            f"{os.path.basename(image_path)} is larger than the Textract synchronous image limit after processing."
        )

    return image_bytes


def textract_detect_lines(image_bytes, textract_client):
    response = textract_client.detect_document_text(
        Document={
            "Bytes": image_bytes
        }
    )

    blocks = [
        block
        for block in response.get("Blocks", [])
        if block.get("BlockType") == "LINE"
    ]

    blocks.sort(
        key=lambda block: (
            block.get("Geometry", {})
            .get("BoundingBox", {})
            .get("Top", 0),
            block.get("Geometry", {})
            .get("BoundingBox", {})
            .get("Left", 0)
        )
    )

    findings = []

    for block in blocks:
        text = block.get("Text", "").strip()

        if text:
            findings.append(
                {
                    "text": text,
                    "confidence": float(block.get("Confidence", 0.0))
                }
            )

    return findings


def select_images():
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)

    files = filedialog.askopenfilenames(
        title="Select Image(s) for AWS Textract",
        filetypes=[
            (
                "Image Files",
                "*.png *.jpg *.jpeg *.tif *.tiff *.bmp"
            ),
            ("PNG Files", "*.png"),
            ("JPEG Files", "*.jpg *.jpeg"),
            ("TIFF Files", "*.tif *.tiff"),
            ("All Files", "*.*")
        ]
    )

    root.destroy()

    return list(files)


def select_output_folder():
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)

    folder = filedialog.askdirectory(
        title="Select Folder for Textract Results"
    )

    root.destroy()

    return folder


def create_docx(results, output_path, identity):
    document = Document()

    document.add_heading("AWS Textract Test Results", 0)

    document.add_paragraph(
        f"Generated: {datetime.now().strftime('%B %d, %Y at %I:%M:%S %p')}"
    )

    document.add_paragraph(
        f"AWS Account: {identity.get('Account', '')}"
    )

    document.add_paragraph(
        f"AWS Region: {AWS_REGION}"
    )

    total_lines = sum(
        len(result["findings"])
        for result in results
    )

    document.add_paragraph(
        f"Images Processed: {len(results)}"
    )

    document.add_paragraph(
        f"Text Lines Detected: {total_lines}"
    )

    for index, result in enumerate(results, start=1):
        document.add_heading(
            f"Image {index}: {result['filename']}",
            level=1
        )

        document.add_paragraph(
            f"Source: {result['path']}"
        )

        document.add_paragraph(
            f"Detected Lines: {len(result['findings'])}"
        )

        if result["findings"]:
            for finding in result["findings"]:
                document.add_paragraph(
                    finding["text"]
                )
        else:
            document.add_paragraph(
                "No text detected."
            )

    document.save(output_path)


def create_pdf(results, output_path, identity):
    styles = getSampleStyleSheet()

    pdf = SimpleDocTemplate(
        output_path,
        pagesize=letter,
        rightMargin=0.65 * inch,
        leftMargin=0.65 * inch,
        topMargin=0.65 * inch,
        bottomMargin=0.65 * inch
    )

    story = []

    story.append(
        Paragraph(
            "AWS Textract Test Results",
            styles["Title"]
        )
    )

    story.append(Spacer(1, 12))

    story.append(
        Paragraph(
            escape(
                f"Generated: {datetime.now().strftime('%B %d, %Y at %I:%M:%S %p')}"
            ),
            styles["Normal"]
        )
    )

    story.append(
        Paragraph(
            escape(
                f"AWS Account: {identity.get('Account', '')}"
            ),
            styles["Normal"]
        )
    )

    story.append(
        Paragraph(
            escape(
                f"AWS Region: {AWS_REGION}"
            ),
            styles["Normal"]
        )
    )

    total_lines = sum(
        len(result["findings"])
        for result in results
    )

    story.append(
        Paragraph(
            f"Images Processed: {len(results)}",
            styles["Normal"]
        )
    )

    story.append(
        Paragraph(
            f"Text Lines Detected: {total_lines}",
            styles["Normal"]
        )
    )

    story.append(Spacer(1, 20))

    for index, result in enumerate(results, start=1):
        story.append(
            Paragraph(
                escape(
                    f"Image {index}: {result['filename']}"
                ),
                styles["Heading1"]
            )
        )

        story.append(
            Paragraph(
                escape(
                    f"Source: {result['path']}"
                ),
                styles["Normal"]
            )
        )

        story.append(
            Paragraph(
                f"Detected Lines: {len(result['findings'])}",
                styles["Normal"]
            )
        )

        story.append(Spacer(1, 12))

        if result["findings"]:
            for finding in result["findings"]:
                story.append(
                    Paragraph(
                        escape(finding["text"]),
                        styles["Normal"]
                    )
                )
                story.append(Spacer(1, 5))
        else:
            story.append(
                Paragraph(
                    "No text detected.",
                    styles["Normal"]
                )
            )

        if index < len(results):
            story.append(PageBreak())

    pdf.build(story)


def show_completion_message(docx_path, pdf_path, total_lines):
    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)

    messagebox.showinfo(
        "AWS Textract Test Complete",
        f"AWS Textract connection successful.\n\n"
        f"Total text lines detected: {total_lines}\n\n"
        f"DOCX:\n{docx_path}\n\n"
        f"PDF:\n{pdf_path}"
    )

    root.destroy()


def main():
    print()
    print("AWS TEXTRACT CONNECTION TEST")
    print("=" * 60)

    image_paths = select_images()

    if not image_paths:
        print("No images selected.")
        return

    print(f"{len(image_paths)} image(s) selected")

    try:
        textract_client = get_textract_client()
        identity = test_aws_connection(textract_client)
    except Exception as exc:
        print()
        print("AWS CONNECTION FAILED")
        print(str(exc))
        raise

    results = []

    for index, image_path in enumerate(image_paths, start=1):
        print()
        print(
            f"Processing image {index}/{len(image_paths)}:"
        )
        print(image_path)

        try:
            image_bytes = load_image_bytes(image_path)

            findings = textract_detect_lines(
                image_bytes,
                textract_client
            )

            results.append(
                {
                    "filename": os.path.basename(image_path),
                    "path": image_path,
                    "findings": findings
                }
            )

            print(
                f"Textract detected {len(findings)} text line(s)"
            )

            for finding in findings:
                print(
                    f"[{finding['confidence']:.2f}%] "
                    f"{finding['text']}"
                )

        except Exception as exc:
            print(
                f"FAILED: {os.path.basename(image_path)}"
            )
            print(str(exc))

            results.append(
                {
                    "filename": os.path.basename(image_path),
                    "path": image_path,
                    "findings": []
                }
            )

    output_folder = select_output_folder()

    if not output_folder:
        output_folder = os.path.dirname(image_paths[0])

    timestamp = datetime.now().strftime(
        "%Y%m%d_%H%M%S"
    )

    docx_path = os.path.join(
        output_folder,
        f"AWS_Textract_Test_{timestamp}.docx"
    )

    pdf_path = os.path.join(
        output_folder,
        f"AWS_Textract_Test_{timestamp}.pdf"
    )

    create_docx(
        results,
        docx_path,
        identity
    )

    create_pdf(
        results,
        pdf_path,
        identity
    )

    total_lines = sum(
        len(result["findings"])
        for result in results
    )

    print()
    print("=" * 60)
    print("TEST COMPLETE")
    print("=" * 60)
    print(f"Images processed: {len(results)}")
    print(f"Text lines detected: {total_lines}")
    print()
    print(f"DOCX: {docx_path}")
    print(f"PDF:  {pdf_path}")

    show_completion_message(
        docx_path,
        pdf_path,
        total_lines
    )


if __name__ == "__main__":
    main()
