def parse_lay_sequence_metadata(lay_path: str) -> Dict[str, Dict[str, Any]]:
    text = read_text_file_best_effort(lay_path)
    metadata = {}

    if not text:
        return metadata

    def extract_lay_value(pattern: str, default: str = "") -> str:
        match = re.search(pattern, text, re.IGNORECASE | re.DOTALL)
        if not match:
            return default
        value = match.group(1)
        value = value.replace("\x00", " ")
        value = re.sub(r"[\x01-\x1f]+", " ", value)
        value = clean_control_chars(value)
        value = re.sub(r"\s+", " ", value).strip()
        return value

    labware_by_id = {}

    labware_ids = sorted(
        set(re.findall(r"Labware\.(\d+)\.", text, re.IGNORECASE)),
        key=lambda value: int(value),
    )

    for labware_num in labware_ids:
        labware_id = extract_lay_value(
            rf"Labware\.{labware_num}\.Id(.*?)(?=Labware\.{labware_num}\.|Labware\.\d+\.|Seq\.|$)"
        )

        labware_file = extract_lay_value(
            rf"Labware\.{labware_num}\.File(.*?)(?=Labware\.{labware_num}\.|Labware\.\d+\.|Seq\.|$)"
        )

        template = extract_lay_value(
            rf"Labware\.{labware_num}\.Template(.*?)(?=Labware\.{labware_num}\.|Labware\.\d+\.|Seq\.|$)"
        )

        site_id = extract_lay_value(
            rf"Labware\.{labware_num}\.SiteId(.*?)(?=Labware\.{labware_num}\.|Labware\.\d+\.|Seq\.|$)"
        )

        managed_sequence = extract_lay_value(
            rf"Labware\.{labware_num}\.LwProperties\.\d+\.Property\s*managedSequenceName.*?"
            rf"Labware\.{labware_num}\.LwProperties\.\d+\.Value(.*?)(?=Labware\.{labware_num}\.|Labware\.\d+\.|Seq\.|$)"
        )

        if labware_id:
            labware_by_id[labware_id.lower()] = {
                "labware_name": labware_id,
                "labware_file": labware_file,
                "template": template,
                "site_id": site_id,
                "managed_sequence": managed_sequence,
                "labware_format": infer_plate_format_from_labware_name(f"{labware_id} {labware_file} {template}"),
            }

    seq_ids = sorted(set(re.findall(r"Seq\.(\d+)\.", text)), key=lambda value: int(value))

    for seq_id in seq_ids:
        raw_name = extract_lay_value(
            rf"Seq\.{seq_id}\.Name(.*?)(?=Seq\.{seq_id}\.(?:ReadOnly|Cnt|Item)|Seq\.\d+\.Name|Seq\.Cnt|$)"
        )

        seq_name_match = re.search(r"([A-Za-z][A-Za-z0-9_ .\-]{0,119})", raw_name)
        if not seq_name_match:
            continue

        seq_name = clean_control_chars(seq_name_match.group(1)).strip()
        seq_name = re.sub(r"\s+", " ", seq_name)

        cnt_match = re.search(rf"Seq\.{seq_id}\.Cnt[^\d]*(\d+)", text, re.IGNORECASE)
        selected_position_count = int(cnt_match.group(1)) if cnt_match else 0

        objids = re.findall(
            rf"Seq\.{seq_id}\.Item\.\d+\.ObjId(.*?)(?=Seq\.{seq_id}\.Item\.\d+\.|Seq\.{seq_id}\.|Seq\.\d+\.|$)",
            text,
            re.IGNORECASE | re.DOTALL,
        )

        clean_objids = []
        for raw_objid in objids:
            raw_objid = raw_objid.replace("\x00", " ")
            raw_objid = re.sub(r"[\x01-\x1f]+", " ", raw_objid)
            match = re.search(r"([A-Za-z][A-Za-z0-9_ .\-]{0,150})", raw_objid)
            if match:
                value = clean_control_chars(match.group(1)).strip()
                value = re.sub(r"\s+", " ", value)
                if value:
                    clean_objids.append(value)

        positions = re.findall(
            rf"Seq\.{seq_id}\.Item\.\d+\.PosId[^A-Za-z0-9]*([A-Za-z]?\d{{1,3}})",
            text,
            re.IGNORECASE,
        )

        labware_candidates = []
        for objid in clean_objids:
            objid_key = objid.lower()
            if objid_key in labware_by_id:
                labware_candidates.append(labware_by_id[objid_key])

        if labware_candidates:
            chosen = max(
                labware_candidates,
                key=lambda item: clean_objids.count(item.get("labware_name", "")),
            )
            labware_name = chosen.get("labware_name", seq_name)
            labware_file = chosen.get("labware_file", "")
            template = chosen.get("template", "")
            site_id = chosen.get("site_id", "")
            labware_format = chosen.get("labware_format", infer_plate_format_from_labware_name(labware_name))
        else:
            labware_name = max(set(clean_objids), key=clean_objids.count) if clean_objids else seq_name
            labware_file = ""
            template = ""
            site_id = ""
            labware_format = infer_plate_format_from_labware_name(labware_name)

        metadata[seq_name] = {
            "sequence_id": seq_id,
            "sequence_name": seq_name,
            "selected_position_count": selected_position_count,
            "position_count": selected_position_count,
            "positions": [normalize_position_text(position) for position in positions],
            "labware_name": labware_name,
            "labware_file": labware_file,
            "template": template,
            "site_id": site_id,
            "labware_format": labware_format,
            "labware_format_basis": "sequence_item_objid_to_labware_id_file_template",
        }

    return metadata




def get_marker_numbers(layout_matches: Dict[str, List[Dict[str, Any]]], marker: str) -> List[int]:
    marker = str(marker or "").upper().strip()
    numbers = []

    for marker_key in layout_matches:
        match = re.match(rf"^{re.escape(marker)}(\d+)$", str(marker_key).upper().strip())
        if match:
            numbers.append(int(match.group(1)))

    return sorted(set(numbers))


def resolve_repeating_layout_marker(
    source_number: int,
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> Tuple[str, int]:
    marker = str(marker or "").upper().strip()
    marker_numbers = get_marker_numbers(layout_matches, marker)

    if not marker_numbers:
        return f"{marker}{source_number}", source_number

    max_marker_number = max(marker_numbers)
    repeated_number = ((int(source_number) - 1) % max_marker_number) + 1

    return f"{marker}{repeated_number}", repeated_number


def get_layout_marker_positions(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker_label: str,
) -> List[str]:
    entries = layout_matches.get(str(marker_label).upper().strip(), [])
    return [
        normalize_position_text(entry.get("dest_value", ""))
        for entry in entries
        if entry.get("dest_value") not in (None, "", "nan")
    ]


def add_issue(
    issues: List[ValidationIssue],
    severity: str,
    category: str,
    message: str,
    evidence: Optional[Dict[str, Any]] = None,
) -> None:
    issues.append(ValidationIssue(
        severity=severity,
        category=category,
        message=message,
        evidence=evidence or {},
    ))






def generate_deterministic_transfer_pairs(
    configs: List[SequenceStepConfig],
    layout_matches: Dict[str, List[Dict[str, Any]]],
) -> List[TransferPair]:
    replicate = configs[0].replicate if configs else "single"
    replicate_count = REPLICATE_MAP.get(str(replicate).lower(), 1)

    tip_steps = [c for c in configs if c.role == "tip pick up"]
    asp_steps = [c for c in configs if c.role == "aspirate"]
    dsp_steps = [c for c in configs if c.role == "dispense"]

    if not dsp_steps:
        return []

    marker = configs[0].marker.upper().strip() if configs and configs[0].marker else ""
    pairs = []

    max_dispense_positions = max(int(dsp.sequence_count or 0) for dsp in dsp_steps)
    if max_dispense_positions <= 0:
        max_dispense_positions = 1

    for rep_index in range(1, replicate_count + 1):
        for source_num in range(1, max_dispense_positions + 1):
            asp = asp_steps[(source_num - 1) % len(asp_steps)] if asp_steps else None
            dsp = dsp_steps[(source_num - 1) % len(dsp_steps)] if dsp_steps else None
            tip = tip_steps[(source_num - 1) % len(tip_steps)] if tip_steps else None

            displayed_marker = f"{marker}{source_num}" if marker else ""
            layout_marker, repeated_layout_number = resolve_repeating_layout_marker(
                source_num,
                layout_matches,
                marker,
            )

            dest_position = ""
            entries = layout_matches.get(layout_marker, [])

            if entries:
                dest_entry_index = min(rep_index - 1, len(entries) - 1)
                dest_position = entries[dest_entry_index].get("dest_value", "")

            pairs.append(TransferPair(
                pair_id="",
                tip_sequence=tip.sequence if tip else "",
                source_sequence=asp.sequence if asp else "",
                destination_sequence=dsp.sequence if dsp else "",
                source_position=str(source_num),
                destination_position=dest_position,
                source_sample_number=source_num,
                destination_sample_number=extract_position_number(dest_position),
                replicate_index=rep_index,
                volume_ul=asp.volume_ul if asp else dsp.volume_ul if dsp else 0.0,
                liquid_class=asp.liquid_class if asp else dsp.liquid_class if dsp else "",
                transfer_type=asp.transfer_type if asp else dsp.transfer_type if dsp else "",
                marker_label=displayed_marker,
            ))

    return pairs




def validate_layout_matches(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    pairs: List[TransferPair],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []

    marker = str(marker or "").upper().strip()
    all_layout_positions = []
    seen_positions = defaultdict(list)

    for marker_label, entries in layout_matches.items():
        for entry in entries:
            pos = normalize_position_text(entry.get("dest_value", ""))
            if not pos:
                continue

            all_layout_positions.append(pos)
            seen_positions[pos].append(marker_label)

    duplicate_layout_positions = {
        pos: labels
        for pos, labels in seen_positions.items()
        if len(labels) > 1
    }

    if duplicate_layout_positions:
        add_issue(
            issues,
            "major",
            "plate layout",
            "Duplicate destination wells were found in the plate layout.",
            {
                "duplicate_destination_wells": sorted(duplicate_layout_positions.keys()),
                "markers_using_same_wells": {
                    pos: labels for pos, labels in duplicate_layout_positions.items()
                },
            },
        )

    marker_numbers = get_marker_numbers(layout_matches, marker)

    findings.append({
        "type": "layout_summary",
        "marker": marker,
        "marker_count": len(layout_matches),
        "layout_position_count": len(all_layout_positions),
        "unique_layout_position_count": len(set(all_layout_positions)),
        "layout_marker_numbers": marker_numbers,
        "repeating_layout_template": (
            f"{marker}1 through {marker}{max(marker_numbers)} will be reused for higher sample numbers."
            if marker_numbers else "No marker numbers found."
        ),
        "duplicate_layout_positions": sorted(duplicate_layout_positions.keys()),
    })

    return findings, issues







def validate_trace_against_layout(
    aspirate_to_dispense_map: Dict[Any, Any],
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []
    marker = marker.upper().strip()

    seen_trace_destinations = []
    missing_by_marker = defaultdict(set)
    unexpected_by_marker = defaultdict(set)
    count_mismatch_by_marker = {}

    for aspirate_step, dispenses in aspirate_to_dispense_map.items():
        source_labware = str(aspirate_step[1]).strip()
        source_position_text = str(aspirate_step[2]).strip()
        source_num = extract_position_number(source_position_text)

        if source_num is None:
            add_issue(
                issues,
                "major",
                "trace source tracking",
                f"Could not determine sample number from aspirate source position {source_position_text}.",
                {
                    "source_labware": source_labware,
                    "source_position": source_position_text,
                    "aspirate_step": aspirate_step,
                },
            )
            continue

        displayed_marker = f"{marker}{source_num}"
        layout_marker, repeated_layout_number = resolve_repeating_layout_marker(
            source_num,
            layout_matches,
            marker,
        )

        expected_positions = get_layout_marker_positions(layout_matches, layout_marker)
        actual_positions = [normalize_position_text(dispense[1]) for dispense in dispenses]
        actual_labware = sorted({str(dispense[0]).strip() for dispense in dispenses if dispense})
        seen_trace_destinations.extend(actual_positions)

        missing = sorted(set(expected_positions) - set(actual_positions))
        unexpected = sorted(set(actual_positions) - set(expected_positions))

        if missing:
            missing_by_marker[displayed_marker].update(missing)

        if unexpected:
            unexpected_by_marker[displayed_marker].update(unexpected)

        if len(actual_positions) != len(expected_positions):
            count_mismatch_by_marker[displayed_marker] = {
                "source_labware": source_labware,
                "source_position": source_position_text,
                "destination_labware": actual_labware,
                "plate_layout_marker_used": layout_marker,
                "expected_destination_count_from_plate_layout": len(expected_positions),
                "actual_destination_count_from_trace": len(actual_positions),
                "expected_destinations": expected_positions,
                "actual_trace_destinations": actual_positions,
            }

        findings.append({
            "type": "trace_layout_match",
            "marker": displayed_marker,
            "source_labware": source_labware,
            "source_position": source_position_text,
            "plate_layout_marker_used": layout_marker,
            "plate_layout_marker_repeated_from_sample_number": repeated_layout_number,
            "expected_destinations": expected_positions,
            "actual_destinations": actual_positions,
            "actual_destination_labware": actual_labware,
            "missing_destinations": missing,
            "unexpected_destinations": unexpected,
            "status": "pass" if not missing and not unexpected and len(actual_positions) == len(expected_positions) else "fail",
        })

    if missing_by_marker:
        for marker_label, wells in sorted(missing_by_marker.items()):
            add_issue(
                issues,
                "critical",
                "trace vs plate layout",
                f"{marker_label}: expected destination wells were not found in the trace.",
                {
                    "missing_expected_wells": sorted(wells),
                    "meaning": "These wells are present in the uploaded plate layout for this marker pattern, but the trace did not show dispense activity into them.",
                },
            )

    if unexpected_by_marker:
        for marker_label, wells in sorted(unexpected_by_marker.items()):
            add_issue(
                issues,
                "critical",
                "trace vs plate layout",
                f"{marker_label}: trace dispensed into wells that were not expected from the plate layout.",
                {
                    "unexpected_trace_wells": sorted(wells),
                    "meaning": "These wells appeared in the trace, but they were not the expected destination wells for this sample marker.",
                },
            )

    for marker_label, evidence in sorted(count_mismatch_by_marker.items()):
        add_issue(
            issues,
            "major",
            "replicate count mismatch",
            f"{marker_label}: replicate count did not match between the plate layout and the trace.",
            evidence,
        )

    duplicate_trace_dests = sorted([
        pos for pos in set(seen_trace_destinations)
        if seen_trace_destinations.count(pos) > 1
    ])

    if duplicate_trace_dests:
        add_issue(
            issues,
            "major",
            "trace duplicate destinations",
            "Duplicate destination wells were found in the trace.",
            {
                "duplicate_destination_wells": duplicate_trace_dests,
                "meaning": "The trace showed more than one dispense into the same destination well.",
            },
        )

    labware_findings, labware_issues = validate_trace_labware_against_layout_format(
        aspirate_to_dispense_map,
        layout_matches,
    )
    findings.extend(labware_findings)
    issues.extend(labware_issues)

    return findings, issues








def validate_tracking_source_order(
    aspirate_to_dispense_map: Dict[Any, Any],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []
    marker = marker.upper().strip()

    expected_source = 1
    mismatches = []

    for aspirate_step, dispenses in aspirate_to_dispense_map.items():
        source_labware = str(aspirate_step[1]).strip()
        source_position_text = str(aspirate_step[2]).strip()
        source_num = extract_position_number(source_position_text)

        if source_num is None:
            mismatches.append({
                "expected_source": expected_source,
                "actual_source": "unknown",
                "source_labware": source_labware,
                "source_position": source_position_text,
            })
            expected_source += 1
            continue

        marker_label = f"{marker}{source_num}"
        status = "pass" if source_num == expected_source else "fail"

        findings.append({
            "type": "tracking_source_order",
            "marker": marker_label,
            "expected_source_number": expected_source,
            "actual_source_number": source_num,
            "source_labware": source_labware,
            "source_position": source_position_text,
            "dispense_count": len(dispenses),
            "status": status,
        })

        if status != "pass":
            mismatches.append({
                "expected_source": expected_source,
                "actual_source": source_num,
                "source_labware": source_labware,
                "source_position": source_position_text,
                "dispense_count": len(dispenses),
            })

        expected_source += 1

    if mismatches:
        add_issue(
            issues,
            "major",
            "sample tracking",
            "Samples were not aspirated in the expected source order.",
            {
                "incorrect_sources": mismatches,
                "meaning": "The source position used by the method did not match the expected sample order.",
            },
        )

    return findings, issues










def build_report_sections(output: DevPalLiteOutput, report_path: str) -> Dict[str, Any]:
    issue_groups = defaultdict(lambda: {
        "severity": "",
        "category": "",
        "messages": [],
        "evidence": defaultdict(set),
    })

    severity_rank = {"critical": 3, "major": 2, "minor": 1, "info": 0}

    for issue in output.issues or []:
        if not isinstance(issue, dict):
            continue

        severity = str(issue.get("severity", "")).lower()
        category = humanize_key(issue.get("category", "Issue"))
        message = safe_text(issue.get("message", ""))

        if severity not in {"critical", "major"}:
            continue

        key = category.lower()
        group = issue_groups[key]

        if not group["severity"] or severity_rank.get(severity, 0) > severity_rank.get(group["severity"], 0):
            group["severity"] = severity

        group["category"] = category

        if message and message not in group["messages"]:
            group["messages"].append(message)

        evidence = issue.get("evidence") or {}
        if isinstance(evidence, dict):
            for ev_key, ev_value in evidence.items():
                if ev_value in (None, "", [], {}):
                    continue

                label = humanize_key(ev_key)

                if isinstance(ev_value, list):
                    for item in ev_value:
                        group["evidence"][label].add(safe_text(item))
                elif isinstance(ev_value, dict):
                    for nested_key, nested_value in ev_value.items():
                        group["evidence"][label].add(
                            f"{safe_text(nested_key)}: {safe_text(nested_value)}"
                        )
                else:
                    group["evidence"][label].add(safe_text(ev_value))

    major_critical = []
    for _, group in sorted(issue_groups.items(), key=lambda item: item[0]):
        major_critical.append({
            "severity": group["severity"],
            "category": group["category"],
            "messages": group["messages"],
            "evidence": {
                key: sorted(values)
                for key, values in group["evidence"].items()
                if values
            },
        })

    selected_sequences = []
    ordered_configs = sorted(
        output.selected_sequences or [],
        key=lambda c: (
            int(c.get("set_order", 1) or 1),
            int(c.get("selected_index", 0) or 0),
        ) if isinstance(c, dict) else (999, 999),
    )

    for config in ordered_configs:
        if not isinstance(config, dict):
            continue

        role = humanize_key(config.get("role", ""))
        sequence = safe_text(config.get("sequence", ""))
        set_order = safe_text(config.get("set_order", "1"))
        hardware = safe_text(config.get("hardware_mode", "")).replace(" mode", "")
        channel = safe_text(config.get("channel_pattern", ""))
        volume = config.get("volume_ul", "")
        liquid_class = safe_text(config.get("liquid_class", ""))
        count = safe_text(config.get("sequence_count", ""))

        line = f"Set {set_order}: {role} - {sequence}, using {hardware}"

        if role.lower() in {"aspirate", "dispense"}:
            line += f", {safe_text(volume)} uL, LC {liquid_class}"

        line += f", channel pattern {channel}, sequence count {count}"
        selected_sequences.append(line)

    transfer_summary = []
    for pair in output.transfer_pairs or []:
        if not isinstance(pair, dict):
            continue

        marker = safe_text(pair.get("marker_label", ""))
        source_sequence = safe_text(pair.get("source_sequence", ""))
        destination_sequence = safe_text(pair.get("destination_sequence", ""))
        source = safe_text(pair.get("source_position", ""))
        dest = safe_text(pair.get("destination_position", ""))
        volume = safe_text(pair.get("volume_ul", ""))
        liquid_class = safe_text(pair.get("liquid_class", ""))

        if marker == "None" and source == "None" and dest == "None":
            continue

        transfer_summary.append(
            f"{marker}: source sequence {source_sequence}, source position {source} → "
            f"destination sequence {destination_sequence}, destination well {dest}, "
            f"{volume} uL, LC {liquid_class}"
        )

    marker_summary = []
    for marker_label, entries in sorted((output.marker_matches or {}).items()):
        locations = []

        for entry in entries or []:
            if not isinstance(entry, dict):
                continue

            dest = safe_text(entry.get("dest_value", ""))
            cell = safe_text(entry.get("excel_position", ""))
            value = safe_text(entry.get("cell_value", ""))

            if dest != "None":
                locations.append(f"{dest} from layout cell {cell} containing {value}")

        marker_summary.append(
            f"{safe_text(marker_label)}: {join_values(locations)}"
        )

    layout_summary = []
    for finding in output.layout_findings or []:
        if not isinstance(finding, dict):
            continue

        if finding.get("type") == "layout_summary":
            layout_summary.append(
                f"Plate layout marker {safe_text(finding.get('marker'))}: "
                f"{safe_text(finding.get('marker_count'))} marker(s), "
                f"{safe_text(finding.get('unique_layout_position_count'))} unique destination well(s). "
                f"{safe_text(finding.get('repeating_layout_template'))}"
            )

    trace_summary = []
    for finding in output.trace_findings or []:
        if not isinstance(finding, dict):
            continue

        finding_type = str(finding.get("type", "")).lower()

        if finding_type == "trace_summary":
            trace_summary.append(
                f"Trace parsed: {safe_text(finding.get('aspirate_step_count'))} aspirate step(s), "
                f"{safe_text(finding.get('dispense_step_count'))} dispense step(s), "
                f"crossmatch {safe_text(finding.get('cross_match_status'))}."
            )

        elif finding_type == "expected_runtime_step_check":
            trace_summary.append(
                f"Runtime step check: expected {safe_text(finding.get('expected_step_count'))} step(s), "
                f"trace showed {safe_text(finding.get('actual_step_count'))} step(s), "
                f"status {safe_text(finding.get('status'))}."
            )

        elif finding_type == "trace_layout_match" and finding.get("status") == "fail":
            trace_summary.append(
                f"{safe_text(finding.get('marker'))}: source labware {safe_text(finding.get('source_labware'))}, "
                f"source position {safe_text(finding.get('source_position'))}; "
                f"expected {join_values(finding.get('expected_destinations', []))}; "
                f"trace found {join_values(finding.get('actual_destinations', []))}."
            )

        elif finding_type == "tracking_source_order" and finding.get("status") == "fail":
            trace_summary.append(
                f"{safe_text(finding.get('marker'))}: Source Position 🚫 "
                f"{safe_text(finding.get('source_position'))} from {safe_text(finding.get('source_labware'))}; "
                f"✅ Need source {safe_text(finding.get('expected_source_number'))}."
            )

    return {
        "major_critical": major_critical,
        "selected_sequences": selected_sequences,
        "transfer_summary": transfer_summary,
        "marker_summary": marker_summary,
        "layout_summary": layout_summary,
        "trace_summary": trace_summary,
        "summary": {
            "Generated": normal_datetime(),
            "LAY File": compact_path(output.lay_file),
            "Plate Layout File": compact_path(output.layout_file),
            "Trace File": compact_path(output.trace_file),
            "Generated Review Script": compact_path(output.generated_review_script),
            "Report Path": compact_path(report_path),
            "Major/Critical Issue Count": len(major_critical),
        },
    }













def write_docx_report(output: DevPalLiteOutput, output_dir: str) -> str:
    if Document is None:
        return write_text_report(output, output_dir)

    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.docx",
    )

    sections = build_report_sections(output, path)

    doc = Document()
    doc.add_heading("DevPal Lite Validation Report", 0)

    doc.add_heading("Run Summary", level=1)
    for label, value in sections["summary"].items():
        paragraph = doc.add_paragraph()
        paragraph.add_run(f"{label}: ").bold = True
        paragraph.add_run(safe_text(value))

    doc.add_heading("Major / Critical Issues", level=1)

    if sections["major_critical"]:
        for index, group in enumerate(sections["major_critical"], start=1):
            title = f"{index}. {humanize_key(group.get('severity'))} issue with {humanize_key(group.get('category'))}"
            write_docx_line(doc, title, bold=True, red=True)

            for message in group.get("messages", []):
                write_docx_line(doc, f"- {message}", red=True)

            evidence = group.get("evidence") or {}
            for key, values in evidence.items():
                if values:
                    write_docx_line(doc, f"{key}: {join_values(values)}", red=True)
    else:
        doc.add_paragraph("No major or critical issues found.")

    doc.add_heading("What Was Ran", level=1)
    write_docx_bullets(doc, sections["selected_sequences"])

    doc.add_heading("Transfer / Position Summary", level=1)
    write_docx_bullets(doc, sections["transfer_summary"])

    doc.add_heading("Plate Layout Marker Review", level=1)
    write_docx_bullets(
        doc,
        sections["marker_summary"] or ["No marker matches were found in the uploaded plate layout."],
    )

    doc.add_heading("Layout Summary", level=1)
    write_docx_bullets(doc, sections["layout_summary"])

    doc.add_heading("Trace / Runtime Summary", level=1)
    write_docx_bullets(doc, sections["trace_summary"])

    doc.save(path)
    return path












def write_text_report(output: DevPalLiteOutput, output_dir: str) -> str:
    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.txt",
    )

    sections = build_report_sections(output, path)

    with open(path, "w", encoding="utf-8") as handle:
        handle.write("DevPal Lite Validation Report\n")
        handle.write("=" * 80 + "\n\n")

        handle.write("Run Summary\n")
        handle.write("-" * 80 + "\n")
        for label, value in sections["summary"].items():
            handle.write(f"{label}: {safe_text(value)}\n")

        handle.write("\nMajor / Critical Issues\n")
        handle.write("-" * 80 + "\n")

        if sections["major_critical"]:
            for index, group in enumerate(sections["major_critical"], start=1):
                handle.write(
                    f"\n{index}. {humanize_key(group.get('severity'))} issue with "
                    f"{humanize_key(group.get('category'))}\n"
                )

                for message in group.get("messages", []):
                    handle.write(f"- {safe_text(message)}\n")

                evidence = group.get("evidence") or {}
                for key, values in evidence.items():
                    if values:
                        handle.write(f"{key}: {join_values(values)}\n")
        else:
            handle.write("No major or critical issues found.\n")

        report_blocks = [
            ("What Was Ran", sections["selected_sequences"]),
            ("Transfer / Position Summary", sections["transfer_summary"]),
            ("Plate Layout Marker Review", sections["marker_summary"] or ["No marker matches were found in the uploaded plate layout."]),
            ("Layout Summary", sections["layout_summary"]),
            ("Trace / Runtime Summary", sections["trace_summary"]),
        ]

        for title, lines in report_blocks:
            handle.write(f"\n{title}\n")
            handle.write("-" * 80 + "\n")

            if lines:
                for line in lines:
                    handle.write(f"- {safe_text(line)}\n")
            else:
                handle.write("None found.\n")

    return path










def write_pdf_report(output: DevPalLiteOutput, output_dir: str) -> str:
    if SimpleDocTemplate is None:
        return write_text_report(output, output_dir)

    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.pdf",
    )

    sections = build_report_sections(output, path)

    styles = getSampleStyleSheet()
    story = []

    def add_para(text: Any, style_name: str = "BodyText", red: bool = False):
        clean = safe_text(text)
        if red or is_error_record(clean):
            clean = f'<font color="red">{clean}</font>'
        story.append(Paragraph(clean, styles[style_name]))

    def add_heading(title: str):
        story.append(Spacer(1, 10))
        story.append(Paragraph(safe_text(title), styles["Heading1"]))
        story.append(Spacer(1, 4))

    story.append(Paragraph("DevPal Lite Validation Report", styles["Title"]))
    story.append(Spacer(1, 12))

    summary_rows = [[safe_text(k), safe_text(v)] for k, v in sections["summary"].items()]
    summary_table = Table(summary_rows, colWidths=[150, 360])
    summary_table.setStyle(TableStyle([
        ("GRID", (0, 0), (-1, -1), 0.25, colors.grey),
        ("BACKGROUND", (0, 0), (0, -1), colors.lightgrey),
        ("VALIGN", (0, 0), (-1, -1), "TOP"),
    ]))
    story.append(summary_table)

    add_heading("Major / Critical Issues")

    if sections["major_critical"]:
        for index, group in enumerate(sections["major_critical"], start=1):
            add_para(
                f"{index}. {humanize_key(group.get('severity'))} issue with {humanize_key(group.get('category'))}",
                "Heading3",
                red=True,
            )

            for message in group.get("messages", []):
                add_para(f"- {message}", red=True)

            evidence = group.get("evidence") or {}
            for key, values in evidence.items():
                if values:
                    add_para(f"{key}: {join_values(values)}", red=True)
    else:
        add_para("No major or critical issues found.")

    report_blocks = [
        ("What Was Ran", sections["selected_sequences"]),
        ("Transfer / Position Summary", sections["transfer_summary"]),
        ("Plate Layout Marker Review", sections["marker_summary"] or ["No marker matches were found in the uploaded plate layout."]),
        ("Layout Summary", sections["layout_summary"]),
        ("Trace / Runtime Summary", sections["trace_summary"]),
    ]

    for title, lines in report_blocks:
        add_heading(title)

        if lines:
            for line in lines:
                add_para(f"• {line}")
        else:
            add_para("None found.")

    SimpleDocTemplate(path, pagesize=letter).build(story)
    return path













