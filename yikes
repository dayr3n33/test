+def _extract_text_rows(text: str) -> List[List[str]]:
+    rows: List[List[str]] = []
+    for line in text.splitlines():
+        stripped = clean_raw_token(line)
+        if not stripped:
+            continue
+        rows.append([part.strip() for part in stripped.split("|") if part.strip()])
+    return rows
+
+
+def _extract_docx_rows(path: str) -> List[List[str]]:
+    try:
+        from docx import Document
+    except ImportError as exc:
+        raise DocumentationParserError(
+            "python-docx is required for .docx requirement parsing"
+        ) from exc
+
+    doc = Document(path)
+    rows: List[List[str]] = []
+    for table in doc.tables:
+        for row in table.rows:
+            values = [clean_raw_token(cell.text) for cell in row.cells]
+            filtered = [value for value in values if value]
+            if not filtered:
+                continue
+            if _is_docx_header_row(filtered):
+                continue
+            rows.append(filtered)
+    return rows
+
+
+def _is_docx_header_row(row: List[str]) -> bool:
+    if not row:
+        return False
+    canonical = {clean_raw_token(cell).lower() for cell in row if clean_raw_token(cell)}
+    canonical_headers = [
+        {"requirement id", "requirement", "evidence"},
+        {"identifier", "definition"},
+        {"id", "description"},
+        {"ur id", "requirement"},
+    ]
+    if any(tokens.issubset(canonical) for tokens in canonical_headers):
+        return True
+    if any(_extract_requirement_id(cell) for cell in row):
+        return False
+    return False
+
