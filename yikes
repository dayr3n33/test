def parse_documentation_file(path: str, model: Optional[MethodModel] = None) -> MethodDocumentSet:
    if not path:
        raise DocumentationParserError("No documentation path provided.")

    if not os.path.isfile(path):
        raise DocumentationParserError("Documentation file not found: {0}".format(path))

    try:
        text = _read_document_text(path)
    except (ImportError, OSError, ValueError) as exc:
        raise DocumentationParserError(
            "Documentation file could not be parsed deterministically: {0}: {1}".format(path, exc)
        )

    requirements, rows, summary, limitations = _build_requirements_by_extension(path, text)

    # Safety fallback: preserve DOCX table row metadata even if the structured
    # extraction path consumed all rows as requirements.
    if os.path.splitext(path)[1].lower() == ".docx" and not rows:
        extracted_rows = _extract_docx_rows(path).get("documentation_rows", [])
        if extracted_rows:
            rows = extracted_rows
            summary["documentation_rows_count"] = len(rows)

    per_file_summary = {path: summary} if summary else {}

    document_set = MethodDocumentSet(
        documents=[path],
        requirements=requirements,
        structured_requirements=list(requirements),
        documentation_rows=rows,
        extraction_summary=summary,
        extraction_limitations=limitations,
        parse_warnings=[],
        documentation_extraction_summary=per_file_summary,
    )

    if model is not None:
        model.documents.documents.append(path)
        model.documents.requirements.extend(requirements)
        model.documents.structured_requirements.extend(requirements)
        model.documents.documentation_rows.extend(rows)
        model.documents.extraction_limitations.extend(limitations)
        model.documents.extraction_summary = _merge_summary(model.documents.extraction_summary, summary)
        model.documents.documentation_extraction_summary.update(per_file_summary)

        if per_file_summary:
            model.runtime_metadata.setdefault("documentation_extraction_summary", {}).update(per_file_summary)
        if rows:
            model.runtime_metadata.setdefault("documentation_rows", []).extend(rows)

        if not requirements:
            model.validation_issues.append(
                ValidationIssue(
                    severity="minor",
                    category="documentation",
                    message="No structured requirements parsed from documentation file.",
                    related_objects=[path],
                )
            )

    return document_set
