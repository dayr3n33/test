            self.root.iconbitmap(icon_path)
    except Exception:
        pass

    self.main_pane = tk.PanedWindow(
        self.root,
        orient=tk.HORIZONTAL,
        bg=UI_BG,
        sashwidth=6,
        sashrelief="raised",
    )
    self.main_pane.pack(fill="both", expand=True)

    self.left_panel = tk.Frame(self.main_pane, bg=UI_BG)
    self.right_panel = tk.Frame(self.main_pane, bg=UI_BG)

