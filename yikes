            fg="white",
        ).pack(side="left", padx=4)

        tk.Button(bottom, text="Select Existing Trace Manually", command=self.upload_trace).pack(side="left", padx=4)

        self.status = tk.Label(bottom, text="Upload .lay file to begin.", anchor="w")
