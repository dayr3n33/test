 def _extract_structured_requirements_from_lines(text: str, source_file: str) -> List[RequirementRecord]:
     requirements: List[RequirementRecord] = []
     current_lines: List[str] = []
     current_id: Optional[str] = None
 
     for line in text.splitlines():
         stripped = clean_raw_token(line)
         if not stripped:
             continue
 
         match = STRUCTURED_REQUIREMENT_LINE_PATTERN.match(stripped)
         if match:
             if current_id and current_lines:
                 requirements.append(_build_requirement_record(current_id, current_lines, source_file))
 
             current_id = _normalize_requirement_id(match.group("rid"))
             body = clean_raw_token(match.group("body"))
             current_lines = [body] if body else []
             continue
 
         if current_id:
             current_lines.append(stripped)
 
     if current_id and current_lines:
         requirements.append(_build_requirement_record(current_id, current_lines, source_file))


