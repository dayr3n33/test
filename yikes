

UI_BG = "#000000"
UI_PANEL_BG = "#000000"
UI_TEXT_BG = "#2b004f"
UI_TEXT_FG = "white"
UI_BUTTON_BG = "#2b004f"
UI_BUTTON_ACTIVE = "#4b0082"
CHECK_SELECT_BG = "white"




def style_label(self, widget):
widget.configure(bg=UI_TEXT_BG, fg=UI_TEXT_FG)
    return widget

def style_frame(self, widget):
    widget.configure(bg=UI_PANEL_BG)
    return widget

def style_button(self, widget):
    widget.configure(
        bg=UI_BUTTON_BG,
        fg=UI_TEXT_FG,
        activebackground=UI_BUTTON_ACTIVE,
        activeforeground=UI_TEXT_FG,
    )
    return widget

def style_checkbutton(self, widget):
    widget.configure(
        bg=UI_PANEL_BG,
        fg=UI_TEXT_FG,
        activebackground=UI_PANEL_BG,
        activeforeground=UI_TEXT_FG,
        selectcolor=CHECK_SELECT_BG,
    )
    return widget

def make_bg_label(self, parent, text, **kwargs):
    return tk.Label(parent, text=text, bg=UI_TEXT_BG, fg=UI_TEXT_FG, **kwargs)








def _build_ui(self):
    self.root.configure(bg=UI_BG)

    try:
        self.root.iconbitmap(os.path.join(os.getcwd(), "thumbs_up.ico"))
    except Exception:
        pass

    main = tk.Frame(self.root, bg=UI_BG)
    main.pack(fill="both", expand=True)

    left_panel = tk.Frame(main, bg=UI_PANEL_BG)
    left_panel.pack(side="left", fill="both", expand=True, padx=8, pady=8)

    right_panel = tk.Frame(main, bg=UI_BG, width=360)
    right_panel.pack(side="right", fill="y", padx=8, pady=8)
    right_panel.pack_propagate(False)

    bg_path = os.path.join(os.getcwd(), "backgroundSA.png")
    self.background_image = None
    self.background_label = None

    if os.path.exists(bg_path):
        try:
            self.background_image = tk.PhotoImage(file=bg_path)
