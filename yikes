PYHAMILTON_IMPORT_ERROR = ""

try:
    import pyhamilton
    import pyhamilton.interface as phi

    from pyhamilton import (
        HamiltonError,
        HamiltonStepError,
        HamiltonTimeoutError,
        LayoutManager,
        Plate96,
        ResourceType,
        OEM_HSL_PATH,
        OEM_RUN_EXE_PATH,
        normal_logging,
        initialize,
    )

    def _get_required_seq_wrapper(name):
        candidates = [
            "pyhamilton.liquid_handling_wrappers",
            "pyhamilton.liquid_handling_wrappers.sequence_wrappers",
            "pyhamilton.interface",
            "pyhamilton",
        ]

        for module_name in candidates:
            try:
                module = __import__(module_name, fromlist=[name])
                if hasattr(module, name):
                    return getattr(module, name)
            except Exception:
                continue

        raise ImportError(f"Missing required sequence wrapper: {name}")

    tip_pick_up_seq = _get_required_seq_wrapper("tip_pick_up_seq")
    aspirate_seq = _get_required_seq_wrapper("aspirate_seq")
    dispense_seq = _get_required_seq_wrapper("dispense_seq")

    try:
        tip_eject_seq2 = _get_required_seq_wrapper("tip_eject_seq2")
    except ImportError:
        tip_eject_seq2 = _get_required_seq_wrapper("tip_eject_seq")

    try:
        inc_sequence = _get_required_seq_wrapper("inc_sequence")
    except ImportError:
        try:
            inc_sequence = _get_required_seq_wrapper("increment_sequence")
        except ImportError:
            def inc_sequence(ham_int, sequence, increment):
                return ham_int.send_command(
                    command="INCSEQ",
                    sequence=sequence,
                    increment=increment,
                )

    tip_pick_up_96_seq = _get_required_seq_wrapper("tip_pick_up_96_seq")
    aspirate_96_seq = _get_required_seq_wrapper("aspirate_96_seq")

    try:
        dispense_96_seq2 = _get_required_seq_wrapper("dispense_96_seq2")
    except ImportError:
        dispense_96_seq2 = _get_required_seq_wrapper("dispense_96_seq")

    try:
        tip_eject_96 = _get_required_seq_wrapper("tip_eject_96")
    except ImportError:
        tip_eject_96 = _get_required_seq_wrapper("tip_eject_96_seq")

except Exception as exc:
    PYHAMILTON_IMPORT_ERROR = f"{type(exc).__name__}: {exc}"

    pyhamilton = None
    phi = None
    HamiltonStepError = Exception
    HamiltonError = Exception
    HamiltonTimeoutError = Exception
    LayoutManager = None
    Plate96 = None
    ResourceType = None
    OEM_RUN_EXE_PATH = ""
    OEM_HSL_PATH = ""
