def write_human_section_docx(doc, title: str, data: Any) -> None:
    doc.add_heading(title, level=1)

    if not data:
        doc.add_paragraph("None found.")
        return

    if isinstance(data, dict):
        for key, value in data.items():
            line = f"{humanize_key(key)}: {safe_text(value)}"
            docx_add_line(doc, line)
        return

    if isinstance(data, list):
        for index, item in enumerate(data, start=1):
            docx_add_line(doc, f"Item {index}", force_red=is_error_record(item))

            if isinstance(item, dict):
                for key, value in item.items():
                    line = f"{humanize_key(key)}: {safe_text(value)}"
                    docx_add_line(doc, line)
            else:
                docx_add_line(doc, safe_text(item))
        return

    docx_add_line(doc, safe_text(data))











def build_labware_validation_summary(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    trace_findings: List[Dict[str, Any]],
) -> List[Dict[str, Any]]:
    summary = []

    layout_summary = summarize_layout_format(layout_matches)
    expected_format = layout_summary.get("inferred_plate_format", "unknown")

    labware_findings = [
        finding for finding in trace_findings
        if finding.get("type") == "labware_format_check"
    ]

    if not labware_findings:
        return [{
            "type": "labware_validation_summary",
            "status": "not_checked",
            "expected_layout_format": expected_format,
            "message": "No trace labware findings were available for labware validation.",
        }]

    for finding in labware_findings:
        status = finding.get("status", "unknown")
        labware = finding.get("labware", "unknown")
        labware_format = finding.get("labware_format", "unknown")
        destination = finding.get("destination", "unknown")

        if status == "fail":
            message = (
                f"URGENT ERROR: Wrong labware detected. Trace dispensed to labware "
                f"'{labware}' detected as {labware_format}, but layout requires {expected_format}."
            )
        elif status == "pass":
            message = (
                f"Correct labware detected. Trace dispensed to labware '{labware}' "
                f"detected as {labware_format}, matching layout format {expected_format}."
            )
        else:
            message = (
                f"Labware checked but could not be fully confirmed. Trace labware '{labware}' "
                f"detected as {labware_format}; layout format is {expected_format}."
            )

        summary.append({
            "type": "labware_validation_summary",
            "status": status,
            "trace_labware": labware,
            "trace_labware_format": labware_format,
            "expected_layout_format": expected_format,
            "destination": destination,
            "message": message,
        })

    return summary






