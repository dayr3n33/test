from __future__ import annotations

import os
import re
from typing import Any, Dict, List, Optional, Tuple

from models.method_models import (
    MethodDocumentSet,
    MethodModel,
    RequirementRecord,
    ValidationIssue,
)
from parsers.utils import (
    clean_raw_token,
    extract_file_references,
    extract_max_sample_requirement,
    extract_volume_requirements,
    normalize_hamilton_text,
    read_text_file,
    text_contains_any,
)


COMMENT_BLOCK_PATTERN = re.compile(r"/\*(?P<body>.*?)\*/", re.DOTALL)
LINE_COMMENT_PATTERN = re.compile(r"^\s*//(?P<body>.*)$", re.MULTILINE)

REQUIREMENT_ID_PATTERN = re.compile(
    r"(?i)\b(?:UR|REQ|RQ|MP|SOP|Requirement)\s*[-_#:]?\s*([A-Za-z0-9_.\-]+)"
)

STRUCTURED_REQUIREMENT_IDENTIFIER_PATTERN = re.compile(
    r"^\s*(?:\d+(?:\.\d+){2,}|(?:UR|REQ|RQ|MP|SOP)\s*[-_ ]?\s*\d{1,6}|Requirement\s*[-_#:]?\s*[A-Za-z0-9_.\-]+)\s*$",
    re.IGNORECASE,
)

STRUCTURED_REQUIREMENT_LINE_PATTERN = re.compile(
    r"^\s*(?P<rid>(?:UR|REQ|RQ|MP|SOP)\s*[-_ ]?\s*\d{1,6}|\d+(?:\.\d+){2,}|Requirement\s*[-_#:]?\s*[A-Za-z0-9_.\-]+)\s*[:\-]\s*(?P<body>.*)$",
    re.IGNORECASE,
)

NUMERIC_REQ_ID_PATTERN = re.compile(r"^\d+(?:\.\d+){2,}$")
GENERIC_REQ_ID_PATTERN = re.compile(
    r"(?i)^(?:UR|REQ|RQ|MP|SOP)\s*[-_ ]?\s*\d{1,6}$"
)

REQ_LANGUAGE_PATTERN = re.compile(
    r"(?i)\b(must|shall|should|required to|is required|must be able to|must abort|must dispense|must calculate|must notify|must prompt|must continue)\b"
)

SECTION_PATTERN = re.compile(
    r"(?i)\b(?:section|heading|title)\s*[:\-]\s*([A-Za-z0-9 _\-.]+)"
)

TIP_PATTERN = re.compile(r"(?i)\b(1000ul|300ul|300ul_slim|50ul)\b")

SEQUENCE_PATTERN = re.compile(
    r"(?i)\b([A-Za-z0-9_.\-]*(?:seq|sequence|sample|buffer|qc|std|tip)[A-Za-z0-9_.\-]*)\b"
)

LABWARE_PATTERN = re.compile(
    r"(?i)\b([A-Za-z0-9_.\-]*(?:plate|rack|tube|carrier|reservoir|dwp|mte)[A-Za-z0-9_.\-]*)\b"
)


class DocumentationParserError(Exception):
    pass


DOCX_HEADER_TERMS = {
    "requirement id",
    "requirement",
    "user requirement",
    "ur id",
    "id",
    "identifier",
    "definition",
    "description",
    "acceptance criteria",
    "expected behavior",
    "evidence",
}


def parse_documentation_file(path: str, model: Optional[MethodModel] = None) -> MethodDocumentSet:
    if not path:
        raise DocumentationParserError("No documentation path provided.")

    if not os.path.isfile(path):
        raise DocumentationParserError("Documentation file not found: {0}".format(path))

    try:
        text = _read_document_text(path)
    except (ImportError, OSError, ValueError) as exc:
        raise DocumentationParserError(
            "Documentation file could not be parsed deterministically: {0}: {1}".format(path, exc)
        )

    requirements, rows, summary, limitations = _build_requirements_by_extension(path, text)
    per_file_summary = {path: summary} if summary else {}

    document_set = MethodDocumentSet(
        documents=[path],
        requirements=requirements,
        structured_requirements=list(requirements),
        documentation_rows=rows,
        extraction_summary=summary,
        extraction_limitations=limitations,
        parse_warnings=[],
        documentation_extraction_summary=per_file_summary,
    )

    if model is not None:
        model.documents.documents.append(path)
        model.documents.requirements.extend(requirements)
        model.documents.structured_requirements.extend(requirements)
        model.documents.documentation_rows.extend(rows)
        model.documents.extraction_limitations.extend(limitations)
        model.documents.extraction_summary = _merge_summary(model.documents.extraction_summary, summary)
        model.documents.documentation_extraction_summary.update(per_file_summary)

        if per_file_summary:
            model.runtime_metadata.setdefault("documentation_extraction_summary", {}).update(per_file_summary)
        if rows:
            model.runtime_metadata.setdefault("documentation_rows", []).extend(rows)

        if not requirements:
            model.validation_issues.append(
                ValidationIssue(
                    severity="minor",
                    category="documentation",
                    message="No structured requirements parsed from documentation file.",
                    related_objects=[path],
                )
            )

    return document_set


def parse_multiple_documents(paths: List[str], model: Optional[MethodModel] = None) -> MethodDocumentSet:
    combined = MethodDocumentSet()

    for path in paths:
        try:
            result = parse_documentation_file(path, model=None)
            combined.documents.extend(result.documents)
            combined.requirements.extend(result.requirements)
            combined.structured_requirements.extend(result.structured_requirements)
            combined.documentation_rows.extend(result.documentation_rows)
            combined.extraction_limitations.extend(result.extraction_limitations)
            combined.extraction_summary = _merge_summary(combined.extraction_summary, result.extraction_summary)
            combined.documentation_extraction_summary.update(result.documentation_extraction_summary)
        except (DocumentationParserError, FileNotFoundError, ValueError, OSError) as exc:
            combined.parse_warnings.append(str(exc))
            if model is not None:
                model.parse_warnings.append(str(exc))

    if model is not None:
        model.documents.documents.extend(combined.documents)
        model.documents.requirements.extend(combined.requirements)
        model.documents.structured_requirements.extend(combined.structured_requirements)
        model.documents.documentation_rows.extend(combined.documentation_rows)
        model.documents.extraction_limitations.extend(combined.extraction_limitations)
        model.documents.extraction_summary = _merge_summary(
            model.documents.extraction_summary,
            combined.extraction_summary,
        )
        model.documents.documentation_extraction_summary.update(combined.documentation_extraction_summary)

        if combined.documentation_extraction_summary:
            model.runtime_metadata.setdefault("documentation_extraction_summary", {}).update(
                combined.documentation_extraction_summary
            )
        if combined.documentation_rows:
            model.runtime_metadata.setdefault("documentation_rows", []).extend(combined.documentation_rows)

        if not combined.requirements and combined.documents:
            model.parse_warnings.append("No structured requirements found across uploaded documentation set.")

    return combined


def _read_document_text(path: str) -> str:
    extension = os.path.splitext(path)[1].lower()

    if extension in [".txt", ".md", ".hsl", ".sub", ".stp", ".res"]:
        return normalize_hamilton_text(read_text_file(path))

    if extension == ".docx":
        return normalize_hamilton_text(_read_docx_text(path))

    if extension == ".pdf":
        return normalize_hamilton_text(_read_pdf_text(path))

    return normalize_hamilton_text(read_text_file(path))


def _read_docx_text(path: str) -> str:
    rows = _extract_docx_rows(path)
    chunks: List[str] = []

    for paragraph in rows.get("paragraphs", []):
        value = clean_raw_token(paragraph)
        if value:
            chunks.append(value)

    for row in rows.get("documentation_rows", []):
        raw = clean_raw_token(str(row.get("raw_row_text") or ""))
        if raw:
            chunks.append(raw)

    return "\n".join(chunks)


def _extract_docx_rows(path: str) -> Dict[str, Any]:
    try:
        from docx import Document
    except ImportError as exc:
        raise DocumentationParserError("python-docx is required for .docx requirement parsing") from exc

    doc = Document(path)
    paragraphs = [clean_raw_token(p.text) for p in doc.paragraphs if clean_raw_token(p.text)]
    documentation_rows: List[Dict[str, Any]] = []

    for table_index, table in enumerate(doc.tables):
        rows = table.rows or []
        if not rows:
            continue

        first_cells = [clean_raw_token(c.text) for c in rows[0].cells]
        has_header = _is_docx_header_row(first_cells)
        column_names = [clean_raw_token(c.text).lower() for c in rows[0].cells] if has_header else []
        data_rows = rows[1:] if has_header else rows

        for row_index, row in enumerate(data_rows):
            cells = [clean_raw_token(c.text) for c in row.cells]
            filtered = [c for c in cells if c]
            if not filtered:
                continue

            documentation_rows.append(
                {
                    "table_index": table_index,
                    "row_index": row_index,
                    "column_names": column_names,
                    "cells": cells,
                    "raw_row_text": " | ".join(filtered),
                }
            )

    return {
        "paragraphs": paragraphs,
        "documentation_rows": documentation_rows,
        "docx_tables_parsed": len(doc.tables),
    }


def _read_pdf_text(path: str) -> str:
    try:
        from pypdf import PdfReader
    except ImportError as exc:
        raise DocumentationParserError("pypdf is required for text-based .pdf requirement parsing") from exc

    reader = PdfReader(path)
    chunks: List[str] = []

    for page in reader.pages:
        text = page.extract_text() or ""
        value = clean_raw_token(text)
        if value:
            chunks.append(value)

    return "\n".join(chunks)


def _build_requirements_by_extension(
    path: str,
    text: str,
) -> Tuple[List[RequirementRecord], List[Dict[str, Any]], Dict[str, Any], List[str]]:
    extension = os.path.splitext(path)[1].lower()
    rows: List[Dict[str, Any]] = []
    limitations: List[str] = []
    summary: Dict[str, Any] = {
        "docx_tables_parsed": 0,
        "pdf_pages_parsed": 0,
        "pdf_text_lines_parsed": 0,
        "structured_requirements_count": 0,
        "documentation_rows_count": 0,
        "unstructured_doc_text_detected": False,
    }

    if extension == ".docx":
        records, doc_rows, table_count = _extract_docx_requirements(path)
        line_records = _extract_structured_requirements_from_lines(text, path)
        records = _merge_dedup_requirements(records, line_records)

        rows.extend(doc_rows)
        summary["docx_tables_parsed"] = table_count
        summary["unstructured_doc_text_detected"] = bool(clean_raw_token(text))
        summary["structured_requirements_count"] = len(records)
        summary["documentation_rows_count"] = len(rows)

        if not records and summary["unstructured_doc_text_detected"]:
            limitations.append("DOCX paragraph/text fallback ran but no requirement-like lines were detected.")
        if not records and not summary["unstructured_doc_text_detected"]:
            limitations.append(
                "DOCX may contain text in shapes/textboxes not exposed through python-docx; OCR or advanced OOXML shape extraction is not enabled in this phase."
            )

        return records, rows, summary, limitations

    if extension == ".pdf":
        records, doc_rows, meta, pdf_limits = _extract_pdf_requirements(path)
        rows.extend(doc_rows)
        summary.update(meta)
        summary["structured_requirements_count"] = len(records)
        summary["documentation_rows_count"] = len(rows)
        limitations.extend(pdf_limits)
        return records, rows, summary, limitations

    if extension in [".txt", ".md"]:
        records = _extract_structured_requirements_from_lines(text, path)
        summary["unstructured_doc_text_detected"] = bool(clean_raw_token(text))
        summary["structured_requirements_count"] = len(records)
        return records, rows, summary, limitations

    blocks = _extract_blocks(text)
    records = _build_requirements(blocks, path)
    summary["structured_requirements_count"] = len(records)
    summary["unstructured_doc_text_detected"] = bool(clean_raw_token(text))
    return records, rows, summary, limitations


def _extract_docx_requirements(path: str) -> Tuple[List[RequirementRecord], List[Dict[str, Any]], int]:
    from docx import Document

    doc = Document(path)
    out: List[RequirementRecord] = []
    rows: List[Dict[str, Any]] = []
    section = ""

    for table_index, table in enumerate(doc.tables):
        header: List[str] = []

        for row_index, row in enumerate(table.rows):
            cells = [clean_raw_token(cell.text) for cell in row.cells]
            non_empty = [c for c in cells if c]
            if not non_empty:
                continue

            row_payload = {
                "source_file": path,
                "source_type": "docx_table",
                "table_index": table_index,
                "row_index": row_index,
                "column_names": header,
                "section_heading": section,
                "raw_row_text": " | ".join(non_empty),
            }

            if _is_section_heading_row(non_empty):
                row_payload["section_heading"] = " ".join(non_empty)
                row_payload["extraction_confidence"] = "row_captured_unstructured"
                rows.append(row_payload)
                section = " ".join(non_empty)
                continue

            if _is_docx_header_row(non_empty):
                header = non_empty
                continue

            rid, rtext = _extract_req_pair(cells)

            if rid and _is_requirement_identifier(rid) and _is_requirement_text(rtext):
                rec = _build_requirement_record(_normalize_requirement_id(rid), [rtext], path)
                rec.section = section or rec.section
                out.append(rec)
            else:
                row_payload["extraction_confidence"] = "row_captured_unstructured"
                rows.append(row_payload)

    return out, rows, len(doc.tables)


def _extract_pdf_requirements(
    path: str,
) -> Tuple[List[RequirementRecord], List[Dict[str, Any]], Dict[str, Any], List[str]]:
    lines: List[str] = []
    limits: List[str] = []
    meta = {"pdf_pages_parsed": 0, "pdf_text_lines_parsed": 0}

    try:
        from pypdf import PdfReader
    except ImportError:
        return [], [], meta, ["pypdf dependency missing for PDF parsing."]

    reader = PdfReader(path)
    meta["pdf_pages_parsed"] = len(reader.pages)

    for page in reader.pages:
        text = clean_raw_token(page.extract_text() or "")
        if text:
            lines.extend([clean_raw_token(v) for v in text.splitlines() if clean_raw_token(v)])

    meta["pdf_text_lines_parsed"] = len(lines)

    if not lines:
        limits.append("PDF appears image-only or lacks extractable text; OCR/Textract is not enabled in this phase.")

    text = "\n".join(lines)
    return _extract_structured_requirements_from_lines(text, path), [], meta, limits


def _extract_req_pair(cells: List[str]) -> Tuple[Optional[str], str]:
    if not cells:
        return None, ""

    left = clean_raw_token(cells[0])
    remaining = clean_raw_token(" ".join(cells[1:])) if len(cells) > 1 else ""

    if _is_requirement_identifier(left):
        return _normalize_requirement_id(left), remaining

    merged = clean_raw_token(" ".join(cells))
    match = STRUCTURED_REQUIREMENT_LINE_PATTERN.match(merged)
    if match:
        return _normalize_requirement_id(match.group("rid")), clean_raw_token(match.group("body"))

    return None, merged


def _is_requirement_identifier(text: str) -> bool:
    value = clean_raw_token(text or "")
    return bool(
        value
        and (
            NUMERIC_REQ_ID_PATTERN.match(value)
            or GENERIC_REQ_ID_PATTERN.match(value)
            or STRUCTURED_REQUIREMENT_IDENTIFIER_PATTERN.match(value)
        )
    )


def _is_requirement_text(text: str) -> bool:
    value = clean_raw_token(text)
    return bool(value and (REQ_LANGUAGE_PATTERN.search(value) or len(value.split()) > 4))


def _is_docx_header_row(cells: List[str]) -> bool:
    normalized = [clean_raw_token(cell).lower() for cell in cells if clean_raw_token(cell)]
    if not normalized:
        return False
    match_count = sum(1 for value in normalized if value in DOCX_HEADER_TERMS)
    joined = " ".join(normalized)
    return match_count >= 2 or any(
        term in joined
        for term in [
            "identifier definition",
            "requirement description",
            "requirement id requirement",
            "user requirement",
            "acceptance criteria",
            "expected behavior",
        ]
    )


def _is_section_heading_row(cells: List[str]) -> bool:
    return len(cells) == 1 and not _is_requirement_identifier(cells[0]) and len(cells[0].split()) <= 8


def _merge_summary(a: Dict[str, Any], b: Dict[str, Any]) -> Dict[str, Any]:
    out = dict(a or {})
    for key, value in (b or {}).items():
        existing = out.get(key)

        if isinstance(value, bool):
            out[key] = bool(existing) or value
        elif isinstance(value, int):
            out[key] = int(existing or 0) + value
        else:
            out[key] = value

    return out


def _merge_dedup_requirements(
    primary: List[RequirementRecord],
    secondary: List[RequirementRecord],
) -> List[RequirementRecord]:
    out: List[RequirementRecord] = []
    seen: Dict[str, bool] = {}

    for record in (primary or []) + (secondary or []):
        key = "{0}|{1}".format(
            (record.requirement_id or "").strip().lower(),
            clean_raw_token(record.text or "").lower(),
        )
        if key in seen:
            continue
        seen[key] = True
        out.append(record)

    return out


def _extract_structured_requirements_from_lines(text: str, source_file: str) -> List[RequirementRecord]:
    requirements: List[RequirementRecord] = []
    current_lines: List[str] = []
    current_id: Optional[str] = None

    for line in text.splitlines():
        stripped = clean_raw_token(line)
        if not stripped:
            continue

        if "|" in stripped:
            columns = [clean_raw_token(part) for part in stripped.split("|")]
            first_column = columns[0] if columns else ""
            remaining_text = " ".join(c for c in columns[1:] if c).strip()

            if _is_requirement_identifier(first_column) and remaining_text:
                if current_id and current_lines:
                    requirements.append(_build_requirement_record(current_id, current_lines, source_file))
                current_id = _normalize_requirement_id(first_column)
                current_lines = [remaining_text]
                continue

        match = STRUCTURED_REQUIREMENT_LINE_PATTERN.match(stripped)
        if match:
            if current_id and current_lines:
                requirements.append(_build_requirement_record(current_id, current_lines, source_file))

            current_id = _normalize_requirement_id(match.group("rid"))
            body = clean_raw_token(match.group("body"))
            current_lines = [body] if body else []
            continue

        if current_id:
            current_lines.append(stripped)

    if current_id and current_lines:
        requirements.append(_build_requirement_record(current_id, current_lines, source_file))

    return requirements


def _build_requirement_record(requirement_id: str, lines: List[str], source_file: str) -> RequirementRecord:
    text = " ".join([line for line in lines if line]).strip()
    record = RequirementRecord(
        requirement_id=_normalize_requirement_id(requirement_id),
        source_file=source_file,
        section=_extract_section(text),
        text=text,
    )
    _populate_requirement_fields(record)
    return record


def _extract_blocks(text: str) -> List[str]:
    blocks: List[str] = []

    for match in COMMENT_BLOCK_PATTERN.finditer(text):
        body = clean_raw_token(match.group("body"))
        if body:
            blocks.append(body)

    current: List[str] = []

    for match in LINE_COMMENT_PATTERN.finditer(text):
        body = clean_raw_token(match.group("body"))
        if not body:
            continue

        current.append(body)
        next_match = LINE_COMMENT_PATTERN.search(text, match.end())

        if next_match is None or next_match.start() != match.end():
            blocks.append("\n".join(current))
            current = []

    return blocks


def _build_requirements(blocks: List[str], source_file: str) -> List[RequirementRecord]:
    requirements: List[RequirementRecord] = []

    for index, block in enumerate(blocks, start=1):
        req_id = _extract_requirement_id(block) or "REQ_{0:04d}".format(index)

        record = RequirementRecord(
            requirement_id=_normalize_requirement_id(req_id),
            source_file=source_file,
            section=_extract_section(block),
            text=block,
        )

        _populate_requirement_fields(record)
        requirements.append(record)

    return requirements


def _extract_requirement_id(text: str) -> Optional[str]:
    match = REQUIREMENT_ID_PATTERN.search(text or "")
    if not match:
        return None
    return clean_raw_token(match.group(1))


def _normalize_requirement_id(raw_requirement_id: str) -> str:
    value = clean_raw_token(raw_requirement_id).upper()

    prefix_match = re.match(
        r"^(UR|REQ|RQ|MP|SOP)\s*[-_ ]?\s*(\d{1,6})$",
        value,
        re.IGNORECASE,
    )
    if prefix_match:
        return "{0}-{1}".format(prefix_match.group(1).upper(), prefix_match.group(2))

    value = re.sub(r"\s+", "", value)
    value = value.replace("_", "-")
    return value


def _extract_section(text: str) -> Optional[str]:
    match = SECTION_PATTERN.search(text or "")
    if not match:
        return None

    value = clean_raw_token(match.group(1))
    return value if value else None


def _populate_requirement_fields(record: RequirementRecord) -> None:
    text = record.text or ""

    record.expected_input_files = extract_file_references(text)
    record.expected_output_files = extract_file_references(text)
    record.expected_volumes_ul = extract_volume_requirements(text)
    record.expected_sample_max = extract_max_sample_requirement(text)

    record.expected_tip_types = _extract_tip_types(text)
    record.expected_sequences = _extract_sequences(text)
    record.expected_labware = _extract_labware(text)

    record.requires_error_handling = text_contains_any(text, ["error handling", "handle error", "exception handling"])
    record.requires_recovery = text_contains_any(text, ["recovery", "retry", "repeat step"])
    record.requires_abort_after_attempts = _extract_retry_limit(text)
    record.requires_tracking_order = text_contains_any(text, ["track order", "sample order", "sequence order"])
    record.requires_output_copy = text_contains_any(text, ["copy output", "duplicate output", "backup file"])
    record.requires_initialize = text_contains_any(text, ["initialize", "init method"])


def _extract_tip_types(text: str) -> List[str]:
    matches = TIP_PATTERN.findall(text or "")
    return list({m.lower() for m in matches})


def _extract_sequences(text: str) -> List[str]:
    matches = SEQUENCE_PATTERN.findall(text or "")
    cleaned = [clean_raw_token(m) for m in matches if m]
    return list({m for m in cleaned if m})


def _extract_labware(text: str) -> List[str]:
    matches = LABWARE_PATTERN.findall(text or "")
    cleaned = [clean_raw_token(m) for m in matches if m]
    return list({m for m in cleaned if m})


def _extract_retry_limit(text: str) -> Optional[int]:
    match = re.search(r"(?i)\b(?:retry|repeat)\s*(\d+)\s*(?:times)?", text or "")
    if not match:
        return None

    try:
        return int(match.group(1))
    except ValueError:
        return None


def get_documentation_summary(document_set: MethodDocumentSet) -> List[Dict[str, object]]:
    summary: List[Dict[str, object]] = []

    for record in document_set.requirements:
        summary.append(
            {
                "requirement_id": record.requirement_id,
                "section": record.section,
                "volumes": record.expected_volumes_ul,
                "samples_max": record.expected_sample_max,
                "tip_types": record.expected_tip_types,
                "sequences": record.expected_sequences,
                "labware": record.expected_labware,
                "requires_error_handling": record.requires_error_handling,
                "requires_recovery": record.requires_recovery,
                "requires_tracking_order": record.requires_tracking_order,
            }
        )

    return summary
