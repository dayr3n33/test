def _is_requirement_identifier(text: str) -> bool:
    value = clean_raw_token(text or "")
    if not value:
        return False

    lowered = value.lower().strip()
    if lowered in {
        "requirement id",
        "requirement",
        "user requirement",
        "ur id",
        "id",
        "identifier",
        "definition",
        "description",
        "acceptance criteria",
        "expected behavior",
        "evidence",
    }:
        return False

    return bool(
        NUMERIC_REQ_ID_PATTERN.fullmatch(value)
        or GENERIC_REQ_ID_PATTERN.fullmatch(value)
        or STRUCTURED_REQUIREMENT_IDENTIFIER_PATTERN.fullmatch(value)
    )

def _extract_req_pair(cells: List[str]) -> Tuple[Optional[str], str]:
    if not cells:
        return None, ""

    cleaned = [clean_raw_token(cell) for cell in cells]
    non_empty = [cell for cell in cleaned if cell]
    if not non_empty:
        return None, ""

    left = non_empty[0]
    remaining = clean_raw_token(" ".join(non_empty[1:]))

   
    inline_match = STRUCTURED_REQUIREMENT_LINE_PATTERN.match(left)
    if inline_match:
        rid = _normalize_requirement_id(inline_match.group("rid"))
        body = clean_raw_token(inline_match.group("body"))
        full_text = " ".join(part for part in [body, remaining] if part).strip()
        return rid, full_text

    if _is_requirement_identifier(left):
        return _normalize_requirement_id(left), remaining

    merged = clean_raw_token(" ".join(non_empty))
    merged_match = STRUCTURED_REQUIREMENT_LINE_PATTERN.match(merged)
    if merged_match:
        return _normalize_requirement_id(merged_match.group("rid")), clean_raw_token(merged_match.group("body"))

    return None, merged
