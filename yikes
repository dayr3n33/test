    def load_liquid_classes(self):
        db_path = ""

        for candidate in (
            os.path.join(os.getcwd(), "LC.mdb"),
            os.path.join(os.getcwd(), "LC.accdb"),
            "LC.mdb",
            "LC.accdb",
        ):
            if os.path.exists(candidate):
                db_path = candidate
                break

        self.liquid_classes = load_combined_liquid_classes(self.lay_path, db_path)

        self.liquid_combo.completevalues = self.liquid_classes
        self.liquid_combo["values"] = self.liquid_classes

        if self.liquid_classes and not self.liquid_class_var.get():
            self.liquid_class_var.set(self.liquid_classes[0])

        if not self.liquid_classes:
            messagebox.showwarning(
                "Liquid Class Warning",
                "No liquid classes were found in LC.mdb/LC.accdb or method files.",
            )

    def upload_lay(self):
        path = filedialog.askopenfilename(
            title="Select .lay File",
            filetypes=[("LAY files", "*.lay"), ("All files", "*.*")],
        )

        if not path:
            return

        self.lay_path = path
        self.lay_label.config(text=path)

        try:
            self.sequence_names = parse_lay_file(path)
            self.sequence_counts = parse_lay_sequence_counts(path)

            if not self.sequence_names:
                messagebox.showerror(
                    "LAY Parse Error",
                    "No valid sequences were found in the selected .lay file.",
                )
                return

            self.load_liquid_classes()
            self.render_sequences()

            self.status.config(
                text=f"Loaded {len(self.sequence_names)} sequences and {len(self.liquid_classes)} liquid classes.",
            )

        except Exception as exc:
            messagebox.showerror("LAY Parse Error", str(exc))

    def upload_layout(self):
        path = filedialog.askopenfilename(
            title="Select Plate Layout File",
            filetypes=[("Plate layout files", "*.csv *.xls *.xlsx *.docx"), ("All files", "*.*")],
        )

        if path:
            self.layout_path = path
            self.layout_label.config(text=path)

    def upload_trace(self):
        path = filedialog.askopenfilename(
            title="Select Trace File",
            filetypes=[("Trace files", "*.trc"), ("All files", "*.*")],
        )

        if path:
            self.trace_path = path
            self.status.config(text=f"Selected trace: {path}")

    def render_sequences(self):
        for child in self.scroll_frame.winfo_children():
            child.destroy()

        self.sequence_vars.clear()
        self.role_vars.clear()
        self.channel_vars.clear()
        self.hardware_labels.clear()

        for idx, name in enumerate(self.sequence_names):
            use_var = tk.IntVar(value=0)
            role_var = tk.StringVar(value="aspirate")

            hardware = detect_hardware_mode(name, role_var.get())
            channel_var = tk.StringVar(value=infer_channel_pattern(name, role_var.get(), hardware))
            seq_count = self.sequence_counts.get(name, 0)

            tk.Checkbutton(self.scroll_frame, variable=use_var).grid(row=idx, column=0, padx=2, pady=1)
            tk.Label(self.scroll_frame, text=name, anchor="w", width=65).grid(row=idx, column=1, sticky="w", padx=2, pady=1)

            role_combo = ttk.Combobox(self.scroll_frame, textvariable=role_var, values=ROLE_OPTIONS, state="readonly", width=13)
            role_combo.grid(row=idx, column=2, padx=2, pady=1)

            channel_entry = tk.Entry(self.scroll_frame, textvariable=channel_var, width=22)
            channel_entry.grid(row=idx, column=3, padx=2, pady=1)

            hardware_label = tk.Label(self.scroll_frame, text=hardware, width=12)
            hardware_label.grid(row=idx, column=4, padx=2, pady=1)

            tk.Label(self.scroll_frame, text=str(seq_count), width=10).grid(row=idx, column=5, padx=2, pady=1)

            def update_row(*_args, seq=name, rv=role_var, cv=channel_var, hl=hardware_label):
                mode = detect_hardware_mode(seq, rv.get())
                hl.config(text=mode)
                if not cv.get().strip():
                    cv.set(infer_channel_pattern(seq, rv.get(), mode))

            role_var.trace_add("write", update_row)

            self.sequence_vars.append((name, use_var))
            self.role_vars[name] = role_var
            self.channel_vars[name] = channel_var
            self.hardware_labels[name] = hardware_label

    def collect_configs(self) -> List[SequenceStepConfig]:
        configs = []

        transfer_type = self.transfer_type_var.get().strip()
        replicate = self.replicate_var.get().strip()
        marker = self.marker_var.get().strip().upper()
        liquid_class = self.liquid_class_var.get().strip()
        volume = safe_float(self.volume_var.get())

        for idx, (name, use_var) in enumerate(self.sequence_vars):
            if not use_var.get():
                continue

            role = self.role_vars[name].get().strip()
            hardware = detect_hardware_mode(name, role)
            channel = self.channel_vars[name].get().strip()

            if not channel:
                channel = infer_channel_pattern(name, role, hardware)

            configs.append(SequenceStepConfig(
                sequence=name,
                role=role,
                liquid_class=liquid_class if role in ("aspirate", "dispense") else "",
                transfer_type=transfer_type,
                replicate=replicate,
                volume_ul=volume,
                marker=marker,
                channel_pattern=channel,
                hardware_mode=hardware,
                selected_index=idx,
                sequence_count=self.sequence_counts.get(name, 0),
            ))

        return configs

    def generate_plan_run_and_validate(self):
        if not self.lay_path:
            messagebox.showerror("Missing LAY", "Upload a .lay file first.")
            return

        if not self.layout_path:
            messagebox.showerror("Missing Plate Layout", "Upload a plate layout file first.")
            return

        configs = self.collect_configs()

        if not configs:
            messagebox.showerror("Missing Sequences", "Select sequences first.")
            return

        issues = validate_step_configs(configs)
        critical = [issue for issue in issues if issue.severity == "critical"]

        if critical:
            messagebox.showerror("Configuration Error", "\n".join(issue.message for issue in critical[:10]))
            return

        today_folder = datetime.now().strftime("%d%b%Y")
        output_dir = os.path.join(DEFAULT_RESULTS_DIR, today_folder)
        os.makedirs(output_dir, exist_ok=True)

        execution_plan = build_execution_plan(configs)
        marker = configs[0].marker if configs else ""

        marker_matches = {}
        layout_findings = []
        trace_findings = []
        limitations = []

        try:
            marker_matches = parse_plate_layout_file(self.layout_path, marker)
        except Exception as exc:
            issues.append(ValidationIssue("critical", "layout", f"Could not parse plate layout: {exc}"))

        pairs = generate_deterministic_transfer_pairs(configs, marker_matches)

        if marker_matches:
            layout_findings, layout_issues = validate_layout_matches(marker_matches, pairs, marker)
            issues.extend(layout_issues)
        else:
            limitations.append("No marker matches were found in the plate layout.")

        review_script = generate_pyhamilton_review_script(configs, execution_plan, output_dir)

        self.status.config(text="Running PyHamilton simulation...")
        self.root.update_idletasks()

        runtime_trace, runtime_issues = run_pyhamilton_simulation(self.lay_path, configs, execution_plan)
        issues.extend(runtime_issues)

        if runtime_trace:
            self.trace_path = runtime_trace

        if self.trace_path:
            try:
                aspirate_steps, dispense_steps, ordered_steps = parse_trc_file(self.trace_path)
                ok, cross_match = cross_match_positions(aspirate_steps, dispense_steps, configs[0].replicate)

                trace_findings.append({
                    "type": "trace_summary",
                    "ordered_steps": ordered_steps,
                    "aspirate_step_count": len(aspirate_steps),
                    "dispense_step_count": len(dispense_steps),
                    "cross_match_status": "pass" if ok else "fail",
                    "cross_match": str(cross_match),
                })

                if ok and isinstance(cross_match, dict):
                    if marker_matches:
                        t_findings, t_issues = validate_trace_against_layout(cross_match, marker_matches, marker)
                        trace_findings.extend(t_findings)
                        issues.extend(t_issues)

                    if self.tracking_var.get():
                        tracking_findings, tracking_issues = validate_tracking_source_order(cross_match, marker)
                        trace_findings.extend(tracking_findings)
                        issues.extend(tracking_issues)
                else:
                    issues.append(ValidationIssue("critical", "trace", f"Trace cross-match failed: {cross_match}"))

            except Exception as exc:
                issues.append(ValidationIssue("critical", "trace", f"Trace analysis failed: {exc}"))
        else:
            limitations.append("No trace file was selected or found; trace validation was not completed.")

        output = create_output_model(
            lay_file=self.lay_path,
            layout_file=self.layout_path,
            trace_file=self.trace_path,
            configs=configs,
            pairs=pairs,
            execution_plan=execution_plan,
            marker_matches=marker_matches,
            layout_findings=layout_findings,
            trace_findings=trace_findings,
            issues=issues,
            limitations=limitations,
            review_script_path=review_script,
        )

        json_path = os.path.join(output_dir, f"DevPal_Lite_Output_Model_{datetime.now().strftime('%H%M%S')}.json")
        Path(json_path).write_text(json.dumps(asdict(output), indent=2, default=str), encoding="utf-8")

        report_format = self.report_format_var.get()

        if report_format == "pdf":
            report_path = write_pdf_report(output, output_dir)
        elif report_format == "txt":
            report_path = write_text_report(output, output_dir)
        else:
            report_path = write_docx_report(output, output_dir)

        output.report_path = report_path
        Path(json_path).write_text(json.dumps(asdict(output), indent=2, default=str), encoding="utf-8")

        issue_count = len([issue for issue in issues if issue.severity in ("critical", "major")])

        messagebox.showinfo(
            "DevPal Lite Complete",
            f"Validation complete.\n\nMajor/Critical issues: {issue_count}\nReport: {report_path}\nOutput Model: {json_path}\nTrace: {self.trace_path or 'None'}",
        )

        self.status.config(text=f"Complete. Report saved: {report_path}")

    def run(self):
        self.root.mainloop()


def main():
    app = DevPalLiteApp()
    app.run()


if __name__ == "__main__":
    main()
