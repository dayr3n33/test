    path = os.path.join(
        output_dir,
        f"DevPal_Lite_Validation_Report_{datetime.now().strftime('%H%M%S')}.docx",
    )

    doc = Document()
    doc.add_heading("DevPal Lite Validation Report", 0)
    doc.add_paragraph(f"Generated: {datetime.now().isoformat()}")
    doc.add_paragraph(f"LAY File: {output.lay_file}")
    doc.add_paragraph(f"Layout File: {output.layout_file}")
    doc.add_paragraph(f"Trace File: {output.trace_file}")
