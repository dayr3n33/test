"platform": _safe_platform_string(),


def _safe_platform_string() -> str:
    try:
        return "{0}|{1}|{2}".format(
            platform.system(),
            platform.release(),
            platform.machine(),
        )
    except Exception:
        return "{0}|{1}|{2}".format(
            getattr(sys, "platform", "unknown"),
            "unknown",
            "unknown",
        )
