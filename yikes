def _build_ui(self):
    self.root.configure(bg="#2b004f")

    try:
        self.root.iconbitmap("thumbs_up.ico")
    except Exception:
        pass

    self.bg_image = None
    self.bg_photo = None

    try:
        self.bg_image = tk.PhotoImage(file="backgroundSA.png")
        self.bg_label = tk.Label(self.root, image=self.bg_image, borderwidth=0)
        self.bg_label.place(x=0, y=0, relwidth=1, relheight=1)
        self.bg_label.lower()
    except Exception:
        self.bg_label = None

    style = ttk.Style()
    try:
        style.theme_use("clam")
    except Exception:
        pass

    style.configure(
        "DevPal.TCombobox",
        fieldbackground="white",
        background="#2b004f",
        foreground="black",
        arrowcolor="#2b004f",
    )

    main = tk.Frame(self.root, bg="#2b004f")
    main.place(relx=0.01, rely=0.01, relwidth=0.98, relheight=0.98)

    top = tk.Frame(main, bg="#2b004f")
    top.pack(fill="x", padx=10, pady=8)

    self.style_button(
        tk.Button(top, text="Upload .lay File", command=self.upload_lay)
    ).pack(side="left", padx=4)

    self.lay_label = self.make_bg_label(top, "No .lay selected", anchor="w")
    self.lay_label.pack(side="left", fill="x", expand=True, padx=6)

    self.style_button(
        tk.Button(top, text="Upload Plate Layout", command=self.upload_layout)
    ).pack(side="left", padx=4)

    self.layout_label = self.make_bg_label(top, "No layout selected", anchor="w")
    self.layout_label.pack(side="left", fill="x", expand=True, padx=6)

    form = tk.LabelFrame(
        main,
        text="Required Transfer Information",
        bg="#2b004f",
        fg="white",
        padx=6,
        pady=6,
    )
    form.pack(fill="x", padx=10, pady=5)

    self.make_bg_label(form, "Transfer Type").grid(row=0, column=0, sticky="w", padx=5, pady=4)
    ttk.Combobox(
        form,
        textvariable=self.transfer_type_var,
        values=TRANSFER_OPTIONS,
        state="readonly",
        width=18,
        style="DevPal.TCombobox",
    ).grid(row=0, column=1, sticky="w", padx=5, pady=4)

    self.make_bg_label(form, "Replicate").grid(row=0, column=2, sticky="w", padx=5, pady=4)
    ttk.Combobox(
        form,
        textvariable=self.replicate_var,
        values=REPLICATE_OPTIONS,
        state="readonly",
        width=18,
        style="DevPal.TCombobox",
    ).grid(row=0, column=3, sticky="w", padx=5, pady=4)

    self.make_bg_label(form, "Volume uL").grid(row=0, column=4, sticky="w", padx=5, pady=4)
    tk.Entry(form, textvariable=self.volume_var, width=16).grid(row=0, column=5, sticky="w", padx=5, pady=4)

    self.make_bg_label(form, "Marker").grid(row=0, column=6, sticky="w", padx=5, pady=4)
    tk.Entry(form, textvariable=self.marker_var, width=12).grid(row=0, column=7, sticky="w", padx=5, pady=4)

    tk.Checkbutton(
        form,
        text="Tracking Enabled",
        variable=self.tracking_var,
        bg="#2b004f",
        fg="white",
        selectcolor="#4b0082",
        activebackground="#2b004f",
        activeforeground="white",
    ).grid(row=0, column=8, sticky="w", padx=5, pady=4)

    tk.Checkbutton(
        form,
        text="Variant",
        variable=self.variant_var,
        command=self.update_set_column_visibility,
        bg="#2b004f",
        fg="white",
        selectcolor="#4b0082",
        activebackground="#2b004f",
        activeforeground="white",
    ).grid(row=0, column=9, sticky="w", padx=5, pady=4)

    self.make_bg_label(form, "Liquid Class").grid(row=1, column=0, sticky="w", padx=5, pady=4)

    self.liquid_combo = SearchableCombobox(
        form,
        textvariable=self.liquid_class_var,
        completevalues=[],
        width=70,
        style="DevPal.TCombobox",
    )
    self.liquid_combo.grid(row=1, column=1, columnspan=6, sticky="we", padx=5, pady=4)

    self.style_button(
        tk.Button(form, text="Add LC to Next Set", command=self.add_liquid_class_for_next_set)
    ).grid(row=1, column=7, sticky="w", padx=5, pady=4)

    self.style_button(
        tk.Button(form, text="Clear Set LCs", command=self.clear_set_liquid_classes)
    ).grid(row=1, column=8, sticky="w", padx=5, pady=4)

    self.set_liquid_summary_label = self.make_bg_label(
        form,
        "",
        textvariable=self.set_liquid_summary_var,
        anchor="w",
    )
    self.set_liquid_summary_label.grid(row=2, column=0, columnspan=10, sticky="we", padx=5, pady=4)

    self.set_liquid_listbox = tk.Listbox(
        form,
        height=4,
        width=110,
        bg="#2b004f",
        fg="white",
        selectbackground="#4b0082",
        selectforeground="white",
        highlightbackground="#4b0082",
        highlightcolor="#4b0082",
    )
    self.set_liquid_listbox.grid(row=3, column=0, columnspan=10, sticky="we", padx=5, pady=4)

    options = tk.LabelFrame(
        main,
        text="Report Options",
        bg="#2b004f",
        fg="white",
        padx=6,
        pady=6,
    )
    options.pack(fill="x", padx=10, pady=5)

    self.make_bg_label(options, "Report Format").pack(side="left", padx=10)
    ttk.Combobox(
        options,
        textvariable=self.report_format_var,
        values=["docx", "pdf", "txt"],
        state="readonly",
        width=10,
        style="DevPal.TCombobox",
    ).pack(side="left")

    list_frame = tk.LabelFrame(
        main,
        text="Extracted Method/Deck Sequences",
        bg="#2b004f",
        fg="white",
        padx=6,
        pady=6,
    )
    list_frame.pack(fill="both", expand=True, padx=10, pady=8)

    self.canvas = tk.Canvas(
        list_frame,
        highlightthickness=1,
        highlightbackground="#4b0082",
        bg="#2b004f",
    )
    self.sequence_canvas = self.canvas

    scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.canvas.yview)

    self.sequence_frame = tk.Frame(self.canvas, bg="#2b004f")
    self.scroll_frame = self.sequence_frame

    self.sequence_window = self.canvas.create_window(
        (0, 0),
        window=self.sequence_frame,
        anchor="nw",
    )

    self.sequence_frame.bind(
        "<Configure>",
        lambda event: self.canvas.configure(scrollregion=self.canvas.bbox("all")),
    )

    self.canvas.bind(
        "<Configure>",
        lambda event: self.canvas.itemconfig(self.sequence_window, width=event.width),
    )

    self.canvas.configure(yscrollcommand=scrollbar.set)

    self.canvas.pack(side="left", fill="both", expand=True)
    scrollbar.pack(side="right", fill="y")

    bottom = tk.Frame(main, bg="#2b004f")
    bottom.pack(fill="x", padx=10, pady=8)

    self.style_button(
        tk.Button(
            bottom,
            text="Generate Plan + Run PyHamilton Simulation + Validate",
            command=self.generate_plan_run_and_validate,
        )
    ).pack(side="left", padx=4)

    self.style_button(
        tk.Button(bottom, text="Select Existing Trace Manually", command=self.upload_trace)
    ).pack(side="left", padx=4)

    self.status = self.make_bg_label(bottom, "Upload .lay file to begin.", anchor="w")
    self.status.pack(side="left", fill="x", expand=True, padx=8)
