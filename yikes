def extract_liquid_classes_from_method_files(method_path: str) -> List[str]:
    if not method_path or not os.path.isfile(method_path):
        return []

    candidates = [method_path]

    patterns = [
        re.compile(r"liq[_\s-]*class\s*[=:]\s*[\"']?([A-Za-z0-9_ .\-+/()]+)", re.IGNORECASE),
        re.compile(r"liquid[_\s-]*class\s*[=:]\s*[\"']?([A-Za-z0-9_ .\-+/()]+)", re.IGNORECASE),
        re.compile(r"LiquidClassName\W+([A-Za-z0-9_ .\-+/()]+)", re.IGNORECASE),
        re.compile(r"LiquidClass\W+([A-Za-z0-9_ .\-+/()]+)", re.IGNORECASE),
        re.compile(r"SelectLiquidClass\W+([A-Za-z0-9_ .\-+/()]+)", re.IGNORECASE),
        re.compile(
            r"SetStringProperty\([^,\)]*,\s*[\"'](?:liquidClass|liq_class|LiquidClass)[\"']\s*,\s*[\"']([^\"']+)[\"']",
            re.IGNORECASE,
        ),
        re.compile(
            r"[\"']([A-Za-z0-9_]+(?:Water|Serum|Plasma|Buffer|DMSO|EtOH|Media|Dispense|Aspirate|Empty|Jet|Surface)[A-Za-z0-9_ .\-+/()]*)[\"']",
            re.IGNORECASE,
        ),
    ]

    found = set()

    for candidate in candidates:
        text = read_text_file_best_effort(candidate)

        if not text:
            continue

        for pattern in patterns:
            for match in pattern.findall(text):
                value = clean_control_chars(match)
                value = value.strip("\"' ,;:=()[]{}")

                if len(value) < 3 or len(value) > 150:
                    continue

                if not re.match(r"^[A-Za-z][A-Za-z0-9_ .\-+/()]*$", value):
                    continue

                lowered = value.lower()

                if lowered in {
                    "liquidclass",
                    "liquid class",
                    "liquidclassname",
                    "liquid class name",
                    "water",
                    "buffer",
                    "serum",
                    "plasma",
                }:
                    continue

                found.add(value)

    return sorted(found, key=str.lower)
