def parse_trc_file(trc_path: str) -> Tuple[List[str], List[str], List[Dict[str, Any]]]:
    aspirate_steps = []
    dispense_steps = []
    ordered_steps = []

    def clean_payload(value: Any) -> str:
        text = clean_control_chars(value)
        text = re.sub(r"\s+", " ", text)
        return text.strip(" ;:")

    def infer_hardware_from_line(line: str) -> Tuple[str, int]:
        lower = line.lower()

        if re.search(r"(384\s*head|head\s*384|mph\s*384|mph384|co-?re\s*384|core\s*384|pickup384|aspirate384|dispense384|eject384)", lower):
            return "head384", 384

        if re.search(r"(96\s*head|head\s*96|mph\s*96|mph96|co-?re\s*96|core\s*96|pickup96|aspirate96|dispense96|eject96)", lower):
            return "head96", 96

        return "channels", 0

    def normalize_trace_action(step_type: str) -> str:
        if "aspirate" in step_type:
            return "aspirate"
        if "dispense" in step_type:
            return "dispense"
        if "tip_pick" in step_type or "pickup" in step_type or "pick_up" in step_type:
            return "tip_pick"
        if "tip_eject" in step_type or "eject" in step_type:
            return "tip_eject"
        return step_type

    def infer_channel_count(line: str, hardware_mode: str, head_size: int) -> int:
        if head_size:
            return head_size

        pattern_match = re.search(r"\b([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", line)
        if pattern_match:
            return pattern_match.group(1).count("1")

        channel_match = re.search(r"\b(?:channel|channels|ch)\s*[:=]?\s*(\d{1,2})\b", line, re.IGNORECASE)
        if channel_match:
            value = int(channel_match.group(1))
            if value in {8, 12, 14, 16}:
                return value

        return 0 if hardware_mode != "channels" else 12

    def extract_sequence_name(line: str) -> str:
        patterns = [
            r"\b(?:sequence|seq)\s*[:=]\s*([A-Za-z0-9_\- .]+)",
            r"\b(?:tipSequence|aspirateSequence|dispenseSequence|wasteSequence)\s*[:=]\s*([A-Za-z0-9_\- .]+)",
        ]

        for pattern in patterns:
            match = re.search(pattern, line, re.IGNORECASE)
            if match:
                value = clean_payload(match.group(1))
                value = re.split(r"\s{2,}|;|,", value)[0].strip()
                if value:
                    return value

        return ""

    def extract_volume(line: str) -> Optional[float]:
        match = re.search(r"\b(\d+(?:\.\d+)?)\s*(?:uL|µL|ul)\b", line, re.IGNORECASE)
        if not match:
            return None

        try:
            return float(match.group(1))
        except Exception:
            return None

    patterns = [
        ("tip_pick", re.compile(r"(?:50|300|1000)\s*(?:uL|µL|ul)\s+channel\s+tip\s+pick\s*up\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("aspirate", re.compile(r"(?:50|300|1000)\s*(?:uL|µL|ul)\s+channel\s+aspirate\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("dispense", re.compile(r"(?:50|300|1000)\s*(?:uL|µL|ul)\s+channel\s+dispense\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("tip_eject", re.compile(r"(?:50|300|1000)\s*(?:uL|µL|ul)\s+channel\s+tip\s+eject\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),

        ("tip_pick_96_head", re.compile(r"(?:co-?re\s+96|core\s+96|mph\s*96|96\s*head|head\s*96)\s+(?:head\s+)?tip\s+pick\s*up\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("aspirate_96_head", re.compile(r"(?:co-?re\s+96|core\s+96|mph\s*96|96\s*head|head\s*96)\s+(?:head\s+)?aspirate\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("dispense_96_head", re.compile(r"(?:co-?re\s+96|core\s+96|mph\s*96|96\s*head|head\s*96)\s+(?:head\s+)?dispense\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("tip_eject_96_head", re.compile(r"(?:co-?re\s+96|core\s+96|mph\s*96|96\s*head|head\s*96)\s+(?:head\s+)?tip\s+eject\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),

        ("tip_pick_384_head", re.compile(r"(?:co-?re\s+384|core\s+384|mph\s*384|384\s*head|head\s*384)\s+(?:head\s+)?tip\s+pick\s*up\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("aspirate_384_head", re.compile(r"(?:co-?re\s+384|core\s+384|mph\s*384|384\s*head|head\s*384)\s+(?:head\s+)?aspirate\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("dispense_384_head", re.compile(r"(?:co-?re\s+384|core\s+384|mph\s*384|384\s*head|head\s*384)\s+(?:head\s+)?dispense\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),
        ("tip_eject_384_head", re.compile(r"(?:co-?re\s+384|core\s+384|mph\s*384|384\s*head|head\s*384)\s+(?:head\s+)?tip\s+eject\s+\(single step\)\s*-\s*complete[:;]?\s*(.*)", re.IGNORECASE)),

        ("tip_pick_96_head", re.compile(r"\bPICKUP96\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
        ("aspirate_96_head", re.compile(r"\bASPIRATE96\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
        ("dispense_96_head", re.compile(r"\bDISPENSE96\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
        ("tip_eject_96_head", re.compile(r"\bEJECT96\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),

        ("tip_pick_384_head", re.compile(r"\bPICKUP384\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
        ("aspirate_384_head", re.compile(r"\bASPIRATE384\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
        ("dispense_384_head", re.compile(r"\bDISPENSE384\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
        ("tip_eject_384_head", re.compile(r"\bEJECT384\b.*?(?:complete|completed|success|ok)[:;]?\s*(.*)", re.IGNORECASE)),
    ]

    try:
        with open(trc_path, "r", encoding="latin-1", errors="ignore") as file:
            lines = file.readlines()
    except Exception:
        with open(trc_path, "r", encoding="utf-8", errors="ignore") as file:
            lines = file.readlines()

    order = 1

    for line_number, raw_line in enumerate(lines, start=1):
        line = clean_payload(raw_line)

        if not line:
            continue

        for step_type, pattern in patterns:
            match = pattern.search(line)

            if not match:
                continue

            payload = clean_payload(match.group(1)) if match.groups() else ""

            if not payload:
                payload = line

            action = normalize_trace_action(step_type)
            hardware_mode, head_size = infer_hardware_from_line(line)
            channel_count = infer_channel_count(line, hardware_mode, head_size)
            sequence_name = extract_sequence_name(line)
            volume_ul = extract_volume(line)

            if action == "aspirate":
                aspirate_steps.append(payload)

            if action == "dispense":
                dispense_steps.append(payload)

            ordered_steps.append({
                "order": order,
                "line_number": line_number,
                "type": step_type,
                "action": action,
                "hardware_mode": hardware_mode,
                "head_size": head_size,
                "channel_count": channel_count,
                "sequence": sequence_name,
                "volume_ul": volume_ul,
                "raw": payload,
                "raw_line": line,
            })

            order += 1
            break

    return aspirate_steps, dispense_steps, ordered_steps
