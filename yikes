def render_sequences(self):
    for child in self.scroll_frame.winfo_children():
        child.destroy()

    self.sequence_vars.clear()
    self.role_vars.clear()
    self.channel_vars.clear()
    self.manual_vars.clear()

    for idx, name in enumerate(self.sequence_names):
        use_var = tk.IntVar(value=0)
        role_var = tk.StringVar(value="aspirate")
        channel_var = tk.StringVar(value="")
        manual_var = tk.IntVar(value=0)

        hardware = detect_hardware_mode(name, role_var.get())

        use_checkbox = tk.Checkbutton(
            self.scroll_frame,
            variable=use_var,
        )
        use_checkbox.grid(row=idx, column=0, padx=2, pady=1)

        sequence_label = tk.Label(
            self.scroll_frame,
            text=name,
            anchor="w",
            width=65,
        )
        sequence_label.grid(row=idx, column=1, sticky="w", padx=2, pady=1)

        role_combo = ttk.Combobox(
            self.scroll_frame,
            textvariable=role_var,
            values=ROLE_OPTIONS,
            state="readonly",
            width=13,
        )
        role_combo.grid(row=idx, column=2, padx=2, pady=1)

        manual_checkbox = tk.Checkbutton(
            self.scroll_frame,
            variable=manual_var,
        )
        manual_checkbox.grid(row=idx, column=3, padx=2, pady=1)

        channel_entry = tk.Entry(
            self.scroll_frame,
            textvariable=channel_var,
            width=18,
        )
        channel_entry.grid(row=idx, column=4, padx=2, pady=1)

        hardware_label = tk.Label(
            self.scroll_frame,
            text=hardware,
            width=12,
        )
        hardware_label.grid(row=idx, column=5, padx=2, pady=1)

        def sync_row(*_args, rv=role_var, hv_label=hardware_label, seq_name=name, cb=manual_checkbox, mv=manual_var):
            role = rv.get().strip()
            detected_hardware = detect_hardware_mode(seq_name, role)
            hv_label.config(text=detected_hardware)

            if role in ("aspirate", "dispense"):
                cb.grid()
            else:
                mv.set(0)
                cb.grid_remove()

        role_var.trace_add("write", sync_row)
        sync_row()

        self.sequence_vars.append((name, use_var))
        self.role_vars[name] = role_var
        self.channel_vars[name] = channel_var
        self.manual_vars[name] = manual_var
