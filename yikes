        report_path=report_path,
    )


def run_pyhamilton_simulation(lay_path: str, configs: List[SequenceStepConfig], execution_plan: List[Dict[str, Any]]) -> Tuple[Optional[str], List[ValidationIssue]]:
    issues = []

    if phi is None or LayoutManager is None:
        issues.append(ValidationIssue("critical", "runtime", f"pyhamilton is not available: {PYHAMILTON_IMPORT_ERROR}"))
        return None, issues

    run_start_time = time.time()

    try:
        layout_manager = LayoutManager(lay_path)

        plate1 = None
        try:
            plate1 = layout_manager.assign_unused_resource(ResourceType(Plate96, ""))
        except Exception:
            plate1 = None

        with AutoRunHamiltonInterface(simulate=True) as ham_int:
            normal_logging(ham_int, os.getcwd())
            initialize(ham_int)

            for item in execution_plan:
                action = item.get("action")
                seq = item.get("sequence", "")
                mode = item.get("hardware_mode", "channels")
                channel = item.get("channel_pattern") or "111111111111"
                volume = float(item.get("volume_ul") or 0)
                liquid_class = item.get("liquid_class", "")

                if item.get("autoincrement"):
                    ph_inc_sequence(ham_int, sequence=seq, increment=int(item.get("increment", 12)))

                if action == "tip_pick":
                    if mode == "stamp":
                        ph_tip_pick_up_96_seq(ham_int, tip96_seq=seq)
                    else:
                        ph_tip_pick_up_seq(ham_int, tipseq=seq, channel=channel)

                elif action == "aspirate":
                    if mode == "stamp":
                        ph_aspirate_96_seq(ham_int, plate96=plate1, head_asp_seq=seq, vols=volume, liq_class=liquid_class)
                    else:
                        ph_aspirate_seq(ham_int, asp_seq=seq, vols=volume, channel=channel, liq_class=liquid_class)

                elif action == "dispense":
                    if mode == "stamp":
                        ph_dispense_96_seq2(ham_int, plate96=plate1, head_disp_seq=seq, vols=volume)
                    else:
                        ph_dispense_seq(ham_int, disp_seq=seq, vols=volume, channel=channel, liq_class=liquid_class)

                elif action == "tip_eject":
                    if mode == "stamp":
                        ph_tip_eject_96(ham_int)
                    else:
                        ph_tip_eject_seq2(ham_int, waste_seq="Waste", channel=channel)

    except (HamiltonStepError, HamiltonError, HamiltonTimeoutError, Exception) as exc:
        issues.append(ValidationIssue("critical", "runtime", f"PyHamilton simulation failed: {type(exc).__name__}: {exc}"))
        return None, issues

    time.sleep(5)

    trace_path = get_latest_trc_file(run_start_time=run_start_time, wait_seconds=45)

    if not trace_path:
        issues.append(ValidationIssue("major", "trace", "No new trace file found after PyHamilton simulation."))

    return trace_path, issues


class DevPalLiteApp:
    def __init__(self):
