def _build_ui(self):
    self.root.configure(bg=self.UI_BG)

    try:
        self.root.iconbitmap(os.path.join(os.getcwd(), "thumbs_up.ico"))
    except Exception:
        pass

    style = ttk.Style()
    try:
        style.theme_use("clam")
    except Exception:
        pass

    style.configure(
        "DevPal.TCombobox",
        fieldbackground=self.UI_ENTRY_BG,
        background=self.UI_TEXT_BG,
        foreground=self.UI_ENTRY_FG,
        arrowcolor=self.UI_TEXT_FG,
        bordercolor=self.UI_TEXT_BG,
        lightcolor=self.UI_TEXT_BG,
        darkcolor=self.UI_TEXT_BG,
    )

    main = tk.Frame(self.root, bg=self.UI_BG)
    main.pack(fill="both", expand=True)

    left_panel = tk.Frame(main, bg=self.UI_BG, width=760)
    left_panel.pack(side="left", fill="both", expand=False, padx=6, pady=6)
    left_panel.pack_propagate(False)

    right_panel = tk.Frame(main, bg=self.UI_BG)
    right_panel.pack(side="right", fill="both", expand=True, padx=6, pady=6)

    bg_path = os.path.join(os.getcwd(), "backgroundSA.png")
    self.background_photo = None

    if os.path.exists(bg_path):
        try:
            self.background_photo = tk.PhotoImage(file=bg_path)
            bg_label = tk.Label(
                right_panel,
                image=self.background_photo,
                bg=self.UI_BG,
                bd=0,
            )
            bg_label.pack(fill="both", expand=True)
        except Exception:
            tk.Label(
                right_panel,
                text="backgroundSA.png found but could not be loaded.",
                bg=self.UI_BG,
                fg=self.UI_TEXT_FG,
            ).pack(fill="both", expand=True)
    else:
        tk.Label(
            right_panel,
            text="backgroundSA.png not found in project directory.",
            bg=self.UI_BG,
            fg=self.UI_TEXT_FG,
        ).pack(fill="both", expand=True)

    top = tk.Frame(left_panel, bg=self.UI_BG, relief="raised", bd=2)
    top.pack(fill="x", padx=4, pady=4)

    self.style_button(
        tk.Button(
            top,
            text="Upload .lay File",
            command=self.upload_lay,
            relief="raised",
            bd=3,
        )
    ).pack(side="left", padx=3, pady=4)

    self.lay_label = tk.Label(
        top,
        text="No .lay selected",
        anchor="w",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="sunken",
        bd=2,
        padx=4,
    )
    self.lay_label.pack(side="left", fill="x", expand=True, padx=3, pady=4)

    self.style_button(
        tk.Button(
            top,
            text="Upload Plate Layout",
            command=self.upload_layout,
            relief="raised",
            bd=3,
        )
    ).pack(side="left", padx=3, pady=4)

    self.layout_label = tk.Label(
        top,
        text="No layout selected",
        anchor="w",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="sunken",
        bd=2,
        padx=4,
    )
    self.layout_label.pack(side="left", fill="x", expand=True, padx=3, pady=4)

    form = tk.LabelFrame(
        left_panel,
        text="Required Transfer Information",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="groove",
        bd=3,
        labelanchor="nw",
    )
    form.pack(fill="x", padx=4, pady=4)

    self.make_bg_label(form, "Transfer Type").grid(row=0, column=0, sticky="w", padx=3, pady=3)
    ttk.Combobox(
        form,
        textvariable=self.transfer_type_var,
        values=TRANSFER_OPTIONS,
        state="readonly",
        width=12,
        style="DevPal.TCombobox",
    ).grid(row=0, column=1, sticky="w", padx=3, pady=3)

    self.make_bg_label(form, "Replicate").grid(row=0, column=2, sticky="w", padx=3, pady=3)
    ttk.Combobox(
        form,
        textvariable=self.replicate_var,
        values=REPLICATE_OPTIONS,
        state="readonly",
        width=11,
        style="DevPal.TCombobox",
    ).grid(row=0, column=3, sticky="w", padx=3, pady=3)

    self.make_bg_label(form, "Volume uL").grid(row=0, column=4, sticky="w", padx=3, pady=3)
    tk.Entry(
        form,
        textvariable=self.volume_var,
        width=12,
        bg=self.UI_ENTRY_BG,
        fg=self.UI_ENTRY_FG,
        relief="sunken",
        bd=2,
    ).grid(row=0, column=5, sticky="w", padx=3, pady=3)

    self.make_bg_label(form, "Marker").grid(row=0, column=6, sticky="w", padx=3, pady=3)
    tk.Entry(
        form,
        textvariable=self.marker_var,
        width=9,
        bg=self.UI_ENTRY_BG,
        fg=self.UI_ENTRY_FG,
        relief="sunken",
        bd=2,
    ).grid(row=0, column=7, sticky="w", padx=3, pady=3)

    self.make_checkbutton(
        form,
        text="Tracking Enabled",
        variable=self.tracking_var,
        width=15,
    ).grid(row=0, column=8, sticky="w", padx=2, pady=3)

    self.make_checkbutton(
        form,
        text="Variant",
        variable=self.variant_var,
        command=self.update_set_column_visibility,
        width=8,
    ).grid(row=0, column=9, sticky="w", padx=2, pady=3)

    self.make_bg_label(form, "Liquid Class").grid(row=1, column=0, sticky="w", padx=3, pady=3)

    self.liquid_combo = SearchableCombobox(
        form,
        textvariable=self.liquid_class_var,
        completevalues=[],
        width=42,
        style="DevPal.TCombobox",
    )
    self.liquid_combo.grid(row=1, column=1, columnspan=6, sticky="we", padx=3, pady=3)

    self.style_button(
        tk.Button(
            form,
            text="Add LC",
            command=self.add_liquid_class_for_next_set,
            relief="raised",
            bd=3,
        )
    ).grid(row=1, column=7, sticky="w", padx=3, pady=3)

    self.style_button(
        tk.Button(
            form,
            text="Clear",
            command=self.clear_set_liquid_classes,
            relief="raised",
            bd=3,
        )
    ).grid(row=1, column=8, sticky="w", padx=3, pady=3)

    tk.Label(
        form,
        textvariable=self.set_liquid_summary_var,
        anchor="w",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="flat",
        bd=0,
    ).grid(row=2, column=0, columnspan=10, sticky="we", padx=3, pady=3)

    self.set_liquid_listbox = tk.Listbox(
        form,
        height=3,
        width=92,
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        selectbackground=self.UI_TEXT_BG,
        selectforeground=self.UI_TEXT_FG,
        relief="sunken",
        bd=2,
    )
    self.set_liquid_listbox.grid(row=3, column=0, columnspan=10, sticky="we", padx=3, pady=3)

    form.grid_columnconfigure(1, weight=1)
    form.grid_columnconfigure(8, weight=0)
    form.grid_columnconfigure(9, weight=0)

    options = tk.LabelFrame(
        left_panel,
        text="Report Options",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="groove",
        bd=3,
    )
    options.pack(fill="x", padx=4, pady=4)

    self.make_bg_label(options, "Report Format").pack(side="left", padx=5, pady=4)
    ttk.Combobox(
        options,
        textvariable=self.report_format_var,
        values=["docx", "pdf", "txt"],
        state="readonly",
        width=8,
        style="DevPal.TCombobox",
    ).pack(side="left", padx=4, pady=4)

    list_frame = tk.LabelFrame(
        left_panel,
        text="Extracted Method/Deck Sequences",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="groove",
        bd=3,
    )
    list_frame.pack(fill="both", expand=True, padx=4, pady=4)

    self.sequence_canvas = tk.Canvas(
        list_frame,
        bg=self.UI_BG,
        highlightthickness=0,
        width=720,
    )
    self.canvas = self.sequence_canvas

    y_scrollbar = ttk.Scrollbar(
        list_frame,
        orient="vertical",
        command=self.sequence_canvas.yview,
    )

    x_scrollbar = ttk.Scrollbar(
        list_frame,
        orient="horizontal",
        command=self.sequence_canvas.xview,
    )

    self.sequence_frame = tk.Frame(self.sequence_canvas, bg=self.UI_BG)
    self.scroll_frame = self.sequence_frame

    self.sequence_window = self.sequence_canvas.create_window(
        (0, 0),
        window=self.sequence_frame,
        anchor="nw",
    )

    self.sequence_frame.bind(
        "<Configure>",
        lambda event: self.sequence_canvas.configure(
            scrollregion=self.sequence_canvas.bbox("all")
        ),
    )

    self.sequence_canvas.configure(
        yscrollcommand=y_scrollbar.set,
        xscrollcommand=x_scrollbar.set,
    )

    self.sequence_canvas.grid(row=0, column=0, sticky="nsew")
    y_scrollbar.grid(row=0, column=1, sticky="ns")
    x_scrollbar.grid(row=1, column=0, sticky="ew")

    list_frame.grid_rowconfigure(0, weight=1)
    list_frame.grid_columnconfigure(0, weight=1)

    bottom = tk.Frame(left_panel, bg=self.UI_BG, relief="raised", bd=2)
    bottom.pack(fill="x", padx=4, pady=4)

    self.style_button(
        tk.Button(
            bottom,
            text="Generate Plan + Run PyHamilton Simulation + Validate",
            command=self.generate_plan_run_and_validate,
            relief="raised",
            bd=4,
        )
    ).pack(side="left", padx=4, pady=5)

    self.style_button(
        tk.Button(
            bottom,
            text="Select Existing Trace Manually",
            command=self.upload_trace,
            relief="raised",
            bd=3,
        )
    ).pack(side="left", padx=4, pady=5)

    self.status = tk.Label(
        bottom,
        text="Upload .lay file to begin.",
        anchor="w",
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        relief="sunken",
        bd=2,
        padx=4,
    )
    self.status.pack(side="left", fill="x", expand=True, padx=4, pady=5)
