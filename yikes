python -c "
import json
from pathlib import Path

d = json.loads(Path(r'sample_inputs/devpal_reports/devpal_report.json').read_text())
rtc = d.get('runtime_trace_correlation', {})

print('selected:', d.get('selected_runtime_trace_path') or d.get('simulation_trace_path'))

print('\nFINDINGS:')
for f in rtc.get('transfer_runtime_findings', []):
    print(f)

print('\nRAW ORDER FIRST 30:')
print(rtc.get('observed_operation_order_raw', [])[:30])

print('\nDEDUP ORDER FIRST 30:')
print(rtc.get('observed_operation_order_deduplicated', [])[:30])

print('\nOPERATION EVIDENCE FIRST 20:')
for e in rtc.get('observed_operation_evidence', [])[:20]:
    print('\\n---')
    print('index:', e.get('event_index'))
    print('operation:', e.get('operation'))
    print('real:', e.get('is_real_operation'))
    print('confidence:', e.get('classification_confidence'))
    print('reason:', e.get('classification_reason'))
    print('raw:', e.get('raw_text_snippet'))
"
