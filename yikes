def _is_docx_header_row(cells: List[str]) -> bool:
    normalized = [clean_raw_token(cell).lower() for cell in cells if clean_raw_token(cell)]
    if not normalized:
        return False

    # A row containing a valid requirement ID is data, not a header.
    if any(_is_requirement_identifier(cell) for cell in cells):
        return False

    match_count = sum(1 for value in normalized if value in DOCX_HEADER_TERMS)
    joined = " ".join(normalized)

    return match_count >= 2 or any(
        term in joined
        for term in [
            "identifier definition",
            "requirement description",
            "requirement id requirement",
            "user requirement",
            "acceptance criteria",
            "expected behavior",
        ]
    )
