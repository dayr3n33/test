def infer_plate_format_from_position_count(count: int) -> str:
    count = int(count or 0)

    if count == 24:
        return "24-well"
    if count == 96:
        return "96-well"
    if count == 384:
        return "384-well"

    return "unknown"





def infer_labware_format_from_method_context(text: str, labware_name: str) -> str:
    target = str(labware_name or "").strip()
    if not target:
        return "unknown"

    direct = infer_plate_format_from_labware_name(target)
    if direct != "unknown":
        return direct

    escaped = re.escape(target)
    context_pattern = re.compile(
        rf".{{0,300}}{escaped}.{{0,300}}",
        re.IGNORECASE | re.DOTALL,
    )

    contexts = context_pattern.findall(text)

    for context in contexts:
        context_upper = context.upper()

        if any(token in context_upper for token in ("384", "384WELL", "384 WELL", "PLATE384")):
            return "384-well"

        if any(token in context_upper for token in ("96", "96WELL", "96 WELL", "PLATE96", "PCR96")):
            return "96-well"

        if any(token in context_upper for token in ("24", "24WELL", "24 WELL", "PLATE24")):
            return "24-well"

        if "WASTE" in context_upper:
            return "waste"

        if "TIP" in context_upper or "TIPRACK" in context_upper:
            return "tip rack"

    return "unknown"









def parse_lay_sequence_metadata(lay_path: str) -> Dict[str, Dict[str, Any]]:
    text = read_text_file_best_effort(lay_path)
    metadata = {}

    if not text:
        return metadata

    seq_ids = sorted(set(re.findall(r"Seq\.(\d+)\.", text)), key=lambda value: int(value))

    for seq_id in seq_ids:
        name_match = re.search(
            rf"Seq\.{seq_id}\.Name(.*?)(?=Seq\.{seq_id}\.(?:ReadOnly|Cnt|Item)|Seq\.\d+\.Name|Seq\.Cnt|$)",
            text,
            re.IGNORECASE | re.DOTALL,
        )

        if not name_match:
            continue

        raw_name = name_match.group(1)
        raw_name = raw_name.replace("\x00", " ")
        raw_name = re.sub(r"[\x01-\x1f]+", " ", raw_name)
        raw_name = re.sub(r"^[^A-Za-z0-9_]+", "", raw_name)

        clean_match = re.search(r"([A-Za-z][A-Za-z0-9_ .\-]{0,119})", raw_name)
        if not clean_match:
            continue

        seq_name = clean_control_chars(clean_match.group(1)).strip()
        seq_name = re.sub(r"\s+", " ", seq_name)

        cnt_match = re.search(
            rf"Seq\.{seq_id}\.Cnt[^\d]*(\d+)",
            text,
            re.IGNORECASE,
        )
        sequence_count = int(cnt_match.group(1)) if cnt_match else 0

        objids = re.findall(
            rf"Seq\.{seq_id}\.Item\.\d+\.ObjId[^A-Za-z0-9_]*([A-Za-z][A-Za-z0-9_ .\-]*)",
            text,
            re.IGNORECASE,
        )

        positions = re.findall(
            rf"Seq\.{seq_id}\.Item\.\d+\.PosId[^A-Za-z0-9]*([A-Za-z]?\d{{1,3}})",
            text,
            re.IGNORECASE,
        )

        clean_objids = []
        for item in objids:
            cleaned = clean_control_chars(item).strip()
            cleaned = re.sub(r"\s+", " ", cleaned)
            if cleaned:
                clean_objids.append(cleaned)

        labware_name = max(set(clean_objids), key=clean_objids.count) if clean_objids else seq_name

        labware_format = infer_labware_format_from_method_context(text, labware_name)

        if labware_format == "unknown":
            labware_format = infer_labware_format_from_method_context(text, seq_name)

        metadata[seq_name] = {
            "sequence_id": seq_id,
            "sequence_name": seq_name,
            "sequence_count": sequence_count,
            "position_count": sequence_count,
            "positions": [normalize_position_text(position) for position in positions],
            "labware_name": labware_name,
            "labware_format": labware_format,
            "format_source": "method_labware_context" if labware_format != "unknown" else "unknown_not_sequence_count",
        }

    return metadata










def get_sequence_labware_metadata(
    sequence_name: str,
    lay_metadata: Dict[str, Dict[str, Any]],
    sequence_count: int = 0,
) -> Dict[str, Any]:
    target = str(sequence_name or "").strip()
    target_lower = target.lower()

    if target in lay_metadata:
        return lay_metadata[target]

    for name, metadata in lay_metadata.items():
        if str(name).strip().lower() == target_lower:
            return metadata

    inferred_format = infer_plate_format_from_labware_name(target)

    return {
        "sequence_name": target,
        "labware_name": target if target else "unknown",
        "labware_format": inferred_format,
        "format_source": "sequence_name_only" if inferred_format != "unknown" else "unknown_not_sequence_count",
        "position_count": int(sequence_count or 0),
        "sequence_count": int(sequence_count or 0),
        "positions": [],
    }

