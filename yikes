cleaned = re.sub(r"[\x00-\x1F]+", "", raw_value).strip()
cleaned = cleaned.strip("^").strip()
cleaned = cleaned.strip('"').strip("'").strip()

# Keep only valid sequence names.
# VENUS sequence names should start with a letter.
match = re.search(r"[A-Za-z][A-Za-z0-9_\- .]*", cleaned)
if not match:
    continue

cleaned = match.group(0).strip()

if not cleaned:
    continue

if not cleaned[0].isalpha():
    continue

if cleaned not in seen:
    seen.add(cleaned)
    sequence_names.append(cleaned)
