def normalize_liquid_class_key(value: str) -> str:
    return re.sub(r"[\s_\-]+", "", str(value or "").strip().lower())


def load_combined_liquid_classes(method_path: str, db_path: str = "") -> List[str]:
    method_candidates = extract_liquid_classes_from_method_files(method_path)

    try:
        db_liquid_classes = load_liquid_classes_from_access(db_path)
    except Exception as exc:
        print(f"WARNING: Could not verify liquid classes against LC database: {exc}")
        return sorted(set(method_candidates), key=str.lower)

    db_by_exact = {str(value).strip(): str(value).strip() for value in db_liquid_classes if str(value).strip()}
    db_by_normalized = {
        normalize_liquid_class_key(value): str(value).strip()
        for value in db_liquid_classes
        if str(value).strip()
    }

    verified = set()

    for candidate in method_candidates:
        candidate = str(candidate or "").strip()

        if not candidate:
            continue

        if candidate in db_by_exact:
            verified.add(db_by_exact[candidate])
            continue

        normalized = normalize_liquid_class_key(candidate)

        if normalized in db_by_normalized:
            verified.add(db_by_normalized[normalized])
            continue

    return sorted(verified, key=str.lower)










def load_liquid_classes_from_access(db_path: str = "") -> List[str]:
    if pyodbc is None:
        raise RuntimeError("pyodbc is not installed.")

    candidates = []

    if db_path:
        candidates.append(db_path)

    candidates.extend([
        os.path.join(os.getcwd(), "LC.mdb"),
        os.path.join(os.getcwd(), "LC.accdb"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "LC.mdb"),
        os.path.join(os.path.dirname(os.path.abspath(__file__)), "LC.accdb"),
        "LC.mdb",
        "LC.accdb",
    ])
