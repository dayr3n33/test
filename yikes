@dataclass
class MethodDocumentSet:
    documents: List[str] = field(default_factory=list)
    requirements: List[RequirementRecord] = field(default_factory=list)
    structured_requirements: List[RequirementRecord] = field(default_factory=list)
    documentation_rows: List[Dict[str, Any]] = field(default_factory=list)
    extraction_summary: Dict[str, Any] = field(default_factory=dict)
    extraction_limitations: List[str] = field(default_factory=list)
    parse_warnings: List[str] = field(default_factory=list)
    documentation_extraction_summary: Dict[str, Any] = field(default_factory=dict)
