def ph_tip_pick_up_seq(ham_int, tipseq: str, channel: str):
    func = _get_optional_pyhamilton_function("tip_pick_up_seq", "tip_pickup_seq")
    if func:
        return _call_best_effort(func, ham_int, tipseq=tipseq, tip_seq=tipseq, sequence=tipseq, channel=channel)
    return _send_command_best_effort(ham_int, "tip_pick_up_seq", tipseq=tipseq, tip_seq=tipseq, sequence=tipseq, channel=channel)


