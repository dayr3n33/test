def render_sequences(self):
    if not hasattr(self, "sequence_frame") or self.sequence_frame is None:
        messagebox.showerror(
            "UI Error",
            "Sequence frame does not exist. Rebuild UI before rendering sequences.",
        )
        return

    sequence_frame = self.sequence_frame

    for widget in sequence_frame.winfo_children():
        widget.destroy()

    self.sequence_vars = []
    self.sequence_role_vars = {}
    self.sequence_channel_vars = {}
    self.sequence_hardware_vars = {}
    self.sequence_count_vars = {}
    self.sequence_manual_vars = {}
    self.sequence_set_vars = {}
    self.sequence_set_widgets = {}
    self.set_header_widget = None

    headers = [
        ("Use", 0, 6),
        ("Set", 1, 6),
        ("Sequence", 2, 34),
        ("Step Role", 3, 12),
        ("Manual", 4, 8),
        ("Channel Pattern", 5, 18),
        ("Hardware", 6, 10),
        ("Seq Count", 7, 10),
    ]

    for text, col, width in headers:
        label = tk.Label(
            sequence_frame,
            text=text,
            width=width,
            anchor="w",
            font=("Arial", 9, "bold"),
        )
        label.grid(row=0, column=col, padx=4, pady=4, sticky="w")

        if text == "Set":
            self.set_header_widget = label

    sequence_names = list(getattr(self, "sequence_names", []) or [])
    sequence_counts = getattr(self, "sequence_counts", {}) or {}

    for row_index, sequence_name in enumerate(sequence_names, start=1):
        sequence_count = int(sequence_counts.get(sequence_name, 0) or 0)

        default_hardware = detect_hardware_mode(sequence_name, "").lower()
        if default_hardware not in ("channels", "head"):
            default_hardware = "channels"

        default_channel_pattern = "1" * 96 if default_hardware == "head" else "111111111111"

        use_var = tk.IntVar(value=0)
        set_var = tk.StringVar(value="")
        role_var = tk.StringVar(value="aspirate")
        manual_var = tk.IntVar(value=0)
        channel_var = tk.StringVar(value=default_channel_pattern)
        hardware_var = tk.StringVar(value=default_hardware)
        sequence_count_var = tk.StringVar(value=str(sequence_count))

        self.sequence_vars.append((sequence_name, use_var))
        self.sequence_role_vars[sequence_name] = role_var
        self.sequence_manual_vars[sequence_name] = manual_var
        self.sequence_channel_vars[sequence_name] = channel_var
        self.sequence_hardware_vars[sequence_name] = hardware_var
        self.sequence_count_vars[sequence_name] = sequence_count_var
        self.sequence_set_vars[sequence_name] = set_var

        tk.Checkbutton(
            sequence_frame,
            variable=use_var,
            command=self.update_set_column_visibility,
        ).grid(row=row_index, column=0, padx=4, pady=2, sticky="w")

        set_entry = tk.Entry(sequence_frame, textvariable=set_var, width=6)
        set_entry.grid(row=row_index, column=1, padx=4, pady=2, sticky="w")
        self.sequence_set_widgets[sequence_name] = set_entry

        tk.Label(
            sequence_frame,
            text=sequence_name,
            width=34,
            anchor="w",
        ).grid(row=row_index, column=2, padx=4, pady=2, sticky="w")

        role_combo = ttk.Combobox(
            sequence_frame,
            textvariable=role_var,
            values=ROLE_OPTIONS,
            width=12,
            state="readonly",
        )
        role_combo.grid(row=row_index, column=3, padx=4, pady=2, sticky="w")

        tk.Checkbutton(
            sequence_frame,
            variable=manual_var,
        ).grid(row=row_index, column=4, padx=4, pady=2, sticky="w")

        tk.Entry(
            sequence_frame,
            textvariable=channel_var,
            width=18,
        ).grid(row=row_index, column=5, padx=4, pady=2, sticky="w")

        hardware_combo = ttk.Combobox(
            sequence_frame,
            textvariable=hardware_var,
            values=["channels", "head"],
            width=10,
            state="readonly",
        )
        hardware_combo.grid(row=row_index, column=6, padx=4, pady=2, sticky="w")

        tk.Label(
            sequence_frame,
            textvariable=sequence_count_var,
            width=10,
            anchor="w",
        ).grid(row=row_index, column=7, padx=4, pady=2, sticky="w")

        def on_role_or_hardware_change(event=None, seq=sequence_name):
            role = self.sequence_role_vars[seq].get().strip()
            hardware = self.sequence_hardware_vars[seq].get().strip().lower()

            detected = detect_hardware_mode(seq, role).lower()
            if detected in ("channels", "head"):
                hardware = detected
                self.sequence_hardware_vars[seq].set(hardware)

            current_pattern = self.sequence_channel_vars[seq].get().strip()

            if hardware == "head":
                if not current_pattern or len(current_pattern) != 96:
                    self.sequence_channel_vars[seq].set("1" * 96)
            else:
                if not current_pattern or len(current_pattern) == 96:
                    self.sequence_channel_vars[seq].set("111111111111")

        role_combo.bind("<<ComboboxSelected>>", on_role_or_hardware_change)
        hardware_combo.bind("<<ComboboxSelected>>", on_role_or_hardware_change)

    if not sequence_names:
        tk.Label(
            sequence_frame,
            text="No sequences loaded.",
            anchor="w",
        ).grid(row=1, column=0, columnspan=8, padx=4, pady=8, sticky="w")

    self.update_set_column_visibility()

    try:
        sequence_frame.update_idletasks()
        if hasattr(self, "sequence_canvas"):
            self.sequence_canvas.configure(scrollregion=self.sequence_canvas.bbox("all"))
        elif hasattr(self, "canvas"):
            self.canvas.configure(scrollregion=self.canvas.bbox("all"))
    except Exception:
        pass


def build_execution_plan(configs: List[SequenceStepConfig]) -> List[Dict[str, Any]]:
    plan = []
    order = 1

    grouped = defaultdict(list)
    for config in configs:
        grouped[int(getattr(config, "set_order", 1) or 1)].append(config)

    role_order = {"tip pick up": 0, "aspirate": 1, "dispense": 2}

    for set_order in sorted(grouped):
        set_configs = sorted(
            grouped[set_order],
            key=lambda c: (role_order.get(c.role, 99), c.selected_index),
        )

        replicate = set_configs[0].replicate if set_configs else "single"
        replicate_count = REPLICATE_MAP.get(str(replicate).lower(), 1)

        tip_steps = [c for c in set_configs if c.role == "tip pick up"]
        asp_steps = [c for c in set_configs if c.role == "aspirate"]
        dsp_steps = [c for c in set_configs if c.role == "dispense"]

        max_len = max(len(tip_steps), len(asp_steps), len(dsp_steps), 1)
        transfer_iterations = get_required_transfer_iterations(set_configs)

        for rep_index in range(1, replicate_count + 1):
            for transfer_iteration in range(1, transfer_iterations + 1):
                for idx in range(max_len):
                    tip = tip_steps[idx] if idx < len(tip_steps) else None
                    asp = asp_steps[idx] if idx < len(asp_steps) else None
                    dsp = dsp_steps[idx] if idx < len(dsp_steps) else None

                    if not any([tip, asp, dsp]):
                        continue

                    if tip is not None:
                        tip_batch_size = get_sequence_batch_size(tip)

                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "tip_pick",
                            "sequence": tip.sequence,
                            "hardware_mode": tip.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "manual": bool(tip.manual),
                            "autoincrement": False,
                            "increment": 0,
                            "channel_pattern": tip.channel_pattern,
                            "volume_ul": "",
                            "liquid_class": "",
                            "transfer_type": tip.transfer_type,
                            "marker": tip.marker,
                            "sequence_count": tip.sequence_count,
                            "batch_size": tip_batch_size,
                        })
                        order += 1

                    if asp is not None:
                        asp_batch_size = get_sequence_batch_size(asp)
                        asp_should_increment = transfer_iteration > 1 and not bool(asp.manual)

                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "aspirate",
                            "sequence": asp.sequence,
                            "hardware_mode": asp.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "manual": bool(asp.manual),
                            "autoincrement": asp_should_increment,
                            "increment": asp_batch_size if asp_should_increment else 0,
                            "channel_pattern": asp.channel_pattern,
                            "volume_ul": asp.volume_ul,
                            "liquid_class": asp.liquid_class,
                            "transfer_type": asp.transfer_type,
                            "marker": asp.marker,
                            "sequence_count": asp.sequence_count,
                            "batch_size": asp_batch_size,
                        })
                        order += 1

                    if dsp is not None:
                        dsp_batch_size = get_sequence_batch_size(dsp)
                        dsp_should_increment = transfer_iteration > 1 and not bool(dsp.manual)

                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "dispense",
                            "sequence": dsp.sequence,
                            "hardware_mode": dsp.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "manual": bool(dsp.manual),
                            "autoincrement": dsp_should_increment,
                            "increment": dsp_batch_size if dsp_should_increment else 0,
                            "channel_pattern": dsp.channel_pattern,
                            "volume_ul": dsp.volume_ul,
                            "liquid_class": dsp.liquid_class,
                            "transfer_type": dsp.transfer_type,
                            "marker": dsp.marker,
                            "sequence_count": dsp.sequence_count,
                            "batch_size": dsp_batch_size,
                        })
                        order += 1

                    if tip is not None:
                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "tip_eject",
                            "sequence": "Waste",
                            "hardware_mode": tip.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "manual": False,
                            "autoincrement": False,
                            "increment": 0,
                            "channel_pattern": tip.channel_pattern,
                            "volume_ul": "",
                            "liquid_class": "",
                            "transfer_type": tip.transfer_type,
                            "marker": tip.marker,
                            "sequence_count": tip.sequence_count,
                            "batch_size": tip_batch_size,
                        })
                        order += 1

    return plan
