from __future__ import annotations

import argparse
import json
import os
import sys
from dataclasses import asdict
from typing import List, Optional

from core import DevPalConfig, run_devpal
from core.runtime_modes import (
    RUNTIME_MODE_AUTO,
    RUNTIME_MODE_DRY_RUN_PLAN_ONLY,
    RUNTIME_MODE_FUTURE_LIVE_EXECUTION_BLOCKED,
    RUNTIME_MODE_PYHAMILTON_SIMULATE,
    RUNTIME_MODE_STATIC_ONLY,
    RUNTIME_MODE_TRACE_REPLAY,
    RUNTIME_MODE_VENUS_RUN_CONTROL_SIMULATION,
)


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="devpal",
        description="DevPal - Hamilton method analyzer, stress tester, and DevPal Lite runner",
    )

    parser.add_argument("--method", required=False, default="")
    parser.add_argument("--project-dir", default="")
    parser.add_argument("--layout", nargs="*", default=[])
    parser.add_argument("--docs", nargs="*", default=[])
    parser.add_argument("--trace", nargs="*", default=[])
    parser.add_argument("--output", default="")
    parser.add_argument("--format", default="json", choices=["json", "txt", "docx", "pdf"])

    parser.add_argument("--no-stress", action="store_true")
    parser.add_argument("--no-trace", action="store_true")
    parser.add_argument("--verbose", action="store_true")

    parser.add_argument(
        "--runtime-mode",
        default=RUNTIME_MODE_AUTO,
        choices=[
            RUNTIME_MODE_STATIC_ONLY,
            RUNTIME_MODE_AUTO,
            RUNTIME_MODE_TRACE_REPLAY,
            RUNTIME_MODE_PYHAMILTON_SIMULATE,
            RUNTIME_MODE_VENUS_RUN_CONTROL_SIMULATION,
            RUNTIME_MODE_DRY_RUN_PLAN_ONLY,
            RUNTIME_MODE_FUTURE_LIVE_EXECUTION_BLOCKED,
        ],
    )

    parser.add_argument("--local-runtime-check", action="store_true")
    parser.add_argument("--allow-pyhamilton-sim", action="store_true")
    parser.add_argument("--phase2-runtime-research", action="store_true")
    parser.add_argument("--dry-run-plan", action="store_true")
    parser.add_argument("--evaluate-execution-readiness", action="store_true")
    parser.add_argument("--collect-runtime-evidence", action="store_true")
    parser.add_argument("--operator-attestation", default="")
    parser.add_argument("--create-runtime-session", action="store_true")

    parser.add_argument("--venus-sim-dry-run", action="store_true")
    parser.add_argument("--venus-sim-run", action="store_true")
    parser.add_argument("--venus-run-control-path", default="")
    parser.add_argument("--venus-log-dir", default="")
    parser.add_argument("--venus-sim-timeout-seconds", type=int, default=180)
    parser.add_argument("--venus-trace-wait-seconds", type=int, default=60)
    parser.add_argument("--venus-trace-stabilize-seconds", type=int, default=4)

    parser.add_argument("--offline-replay", action="store_true")
    parser.add_argument("--offline-stress-run", action="store_true")
    parser.add_argument("--stress-scenario-cap", type=int, default=100)

    parser.add_argument("--pyhamilton-oem-plan", action="store_true")
    parser.add_argument("--pyhamilton-oem-method-path", default="")
    parser.add_argument("--allow-pyhamilton-oem-launch", action="store_true")

    parser.add_argument("--devpal-lite-ui", action="store_true")
    parser.add_argument("--devpal-lite", action="store_true")
    parser.add_argument("--devpal-lite-list-sequences", action="store_true")

    parser.add_argument("--source-sequence", default=None)
    parser.add_argument("--dest-sequence", default=None)
    parser.add_argument("--transfer-type", default=None)
    parser.add_argument("--volume", type=float, default=None)
    parser.add_argument("--sample-count", type=int, default=None)

    parser.add_argument("--devpal-lite-marker", default=None)
    parser.add_argument(
        "--devpal-lite-replicate",
        default="single",
        choices=["single", "duplicate", "triplicate"],
    )
    parser.add_argument(
        "--devpal-lite-report-format",
        default="docx",
        choices=["json", "txt", "docx", "pdf"],
    )
    parser.add_argument("--devpal-lite-allow-runtime", action="store_true")
    parser.add_argument("--devpal-lite-generate-pyhamilton", action="store_true")

    return parser


def run_cli(argv: Optional[List[str]] = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.devpal_lite_ui:
        return _run_devpal_lite_ui()

    method_path = args.method or _select_method_file()

    if not method_path:
        print("No method file selected.", file=sys.stderr)
        return 1

    config = DevPalConfig(
        selected_method_path=method_path,
        project_dir=args.project_dir,
        layout_paths=list(args.layout or []),
        document_paths=list(args.docs or []),
        trace_paths=list(args.trace or []),
        output_directory=args.output,
        report_format=args.format,
        enable_stress_tests=not args.no_stress,
        enable_trace_analysis=not args.no_trace,
        verbose=args.verbose,
        runtime_mode=args.runtime_mode,
        local_runtime_check=args.local_runtime_check,
        allow_pyhamilton_sim=args.allow_pyhamilton_sim,
        phase2_runtime_research=args.phase2_runtime_research,
        dry_run_plan=args.dry_run_plan,
        evaluate_execution_readiness=args.evaluate_execution_readiness,
        collect_runtime_evidence=args.collect_runtime_evidence,
        operator_attestation_path=args.operator_attestation,
        create_runtime_session=args.create_runtime_session,
        venus_sim_dry_run=args.venus_sim_dry_run,
        venus_sim_run=args.venus_sim_run,
        venus_run_control_path=args.venus_run_control_path,
        venus_log_dir=args.venus_log_dir,
        venus_sim_timeout_seconds=args.venus_sim_timeout_seconds,
        venus_trace_wait_seconds=args.venus_trace_wait_seconds,
        venus_trace_stabilize_seconds=args.venus_trace_stabilize_seconds,
        offline_replay=args.offline_replay,
        offline_stress_run=args.offline_stress_run,
        stress_scenario_cap=args.stress_scenario_cap,
        pyhamilton_oem_plan=args.pyhamilton_oem_plan,
        pyhamilton_oem_method_path=args.pyhamilton_oem_method_path,
        allow_pyhamilton_oem_launch=args.allow_pyhamilton_oem_launch,
        devpal_lite=args.devpal_lite,
        devpal_lite_ui=args.devpal_lite_ui,
        devpal_lite_list_sequences=args.devpal_lite_list_sequences,
        source_sequence=args.source_sequence,
        dest_sequence=args.dest_sequence,
        transfer_type=args.transfer_type,
        volume=args.volume,
        sample_count=args.sample_count,
        devpal_lite_marker=args.devpal_lite_marker,
        devpal_lite_replicate=args.devpal_lite_replicate,
        devpal_lite_report_format=args.devpal_lite_report_format,
        devpal_lite_allow_runtime=args.devpal_lite_allow_runtime,
        devpal_lite_generate_pyhamilton=args.devpal_lite_generate_pyhamilton,
    )

    try:
        config.resolve_paths()
        config.validate()

        if args.devpal_lite_list_sequences:
            return _run_devpal_lite_list_sequences(config)

        if args.devpal_lite:
            return _run_devpal_lite_cli(config)

        model = run_devpal(config)

        if args.verbose:
            _print_summary(model)

        return 0

    except Exception as exc:
        if args.verbose:
            raise

        print("DevPal execution failed: {0}".format(exc), file=sys.stderr)
        return 1


def _run_devpal_lite_ui() -> int:
    from devpal_lite_runner import main as run_devpal_lite_ui

    run_devpal_lite_ui()
    return 0


def _run_devpal_lite_list_sequences(config: DevPalConfig) -> int:
    from devpal_lite_runner import parse_lay_file

    for sequence_name in parse_lay_file(config.selected_method_path):
        print(sequence_name)

    return 0


def _run_devpal_lite_cli(config: DevPalConfig) -> int:
    from devpal_lite_runner import (
        SequenceStepConfig,
        build_execution_plan,
        create_output_model,
        generate_deterministic_transfer_pairs,
        generate_pyhamilton_review_script,
        parse_lay_file,
        parse_plate_layout_file,
        validate_layout_matches,
        write_docx_report,
        write_pdf_report,
        write_text_report,
    )

    sequence_names = parse_lay_file(config.selected_method_path)

    if config.source_sequence not in sequence_names:
        raise ValueError("Source sequence not found in .lay file: {0}".format(config.source_sequence))

    if config.dest_sequence not in sequence_names:
        raise ValueError("Destination sequence not found in .lay file: {0}".format(config.dest_sequence))

    output_dir = config.output_directory or os.path.join(
        os.path.dirname(config.selected_method_path) or os.getcwd(),
        "devpal_reports",
    )
    os.makedirs(output_dir, exist_ok=True)

    marker = (config.devpal_lite_marker or "").strip().upper()
    transfer_type = config.transfer_type or "samples"
    liquid_class = config.liquid_class_db_override or ""

    configs = [
        SequenceStepConfig(
            sequence=config.source_sequence,
            role="aspirate",
            liquid_class=liquid_class,
            transfer_type=transfer_type,
            replicate=config.devpal_lite_replicate,
            volume_ul=float(config.volume),
            marker=marker,
            channel_pattern="111111111111",
            hardware_mode="channels",
            selected_index=0,
        ),
        SequenceStepConfig(
            sequence=config.dest_sequence,
            role="dispense",
            liquid_class=liquid_class,
            transfer_type=transfer_type,
            replicate=config.devpal_lite_replicate,
            volume_ul=float(config.volume),
            marker=marker,
            channel_pattern="111111111111",
            hardware_mode="channels",
            selected_index=1,
        ),
    ]

    layout_file = config.layout_paths[0] if config.layout_paths else ""
    marker_matches = parse_plate_layout_file(layout_file, marker) if layout_file and marker else {}

    execution_plan = build_execution_plan(configs)
    transfer_pairs = generate_deterministic_transfer_pairs(configs, marker_matches)

    layout_findings = []
    layout_issues = []

    if marker_matches:
        layout_findings, layout_issues = validate_layout_matches(
            marker_matches,
            transfer_pairs,
            marker,
        )

    review_script_path = ""
    if config.devpal_lite_generate_pyhamilton:
        review_script_path = generate_pyhamilton_review_script(
            configs,
            execution_plan,
            output_dir,
        )

    output = create_output_model(
        lay_file=config.selected_method_path,
        layout_file=layout_file,
        trace_file=config.trace_paths[0] if config.trace_paths else "",
        configs=configs,
        pairs=transfer_pairs,
        execution_plan=execution_plan,
        marker_matches=marker_matches,
        layout_findings=layout_findings,
        trace_findings=[],
        issues=layout_issues,
        limitations=[
            "CLI DevPal Lite mode creates a deterministic review plan only.",
            "Use --devpal-lite-ui for full UI sequence selection, optional gated runtime, trace selection, and trace-layout crossmatch.",
        ],
        review_script_path=review_script_path,
    )

    json_path = os.path.join(output_dir, "devpal_lite_output_model.json")

    with open(json_path, "w", encoding="utf-8") as file:
        json.dump(asdict(output), file, indent=2, default=str)

    report_format = config.devpal_lite_report_format or config.report_format

    if report_format == "pdf":
        report_path = write_pdf_report(output, output_dir)
    elif report_format in {"txt", "json"}:
        report_path = write_text_report(output, output_dir)
    else:
        report_path = write_docx_report(output, output_dir)

    print("DevPal Lite CLI completed.")
    print("Output model: {0}".format(json_path))
    print("Report: {0}".format(report_path))

    if review_script_path:
        print("Review-required PyHamilton script: {0}".format(review_script_path))

    return 0


def _select_method_file() -> str:
    try:
        import tkinter as tk
        from tkinter import filedialog
    except ImportError:
        return ""

    root = tk.Tk()
    root.withdraw()
    root.attributes("-topmost", True)

    path = filedialog.askopenfilename(
        title="Select Hamilton Method File",
        filetypes=[
            ("Hamilton method files", "*.med *.hsl *.lay *.stp *.res *.sub"),
            ("MED files", "*.med"),
            ("HSL files", "*.hsl"),
            ("LAY files", "*.lay"),
            ("STP files", "*.stp"),
            ("RES files", "*.res"),
            ("SUB files", "*.sub"),
            ("All files", "*.*"),
        ],
    )

    root.destroy()
    return path or ""


def _print_summary(model) -> None:
    print("\n=== DevPal Summary ===")
    print("Method:", model.files.method_name or model.files.selected_method_path)
    print("Steps:", len(model.steps))
    print("Sequences:", len(model.deck.sequences))
    print("Labware:", len(model.deck.labware))
    print("Uploaded layouts:", len(model.uploaded_layouts))
    print("Requirements:", len(model.documents.requirements))
    print("Trace runs:", len(model.trace_runs))
    print("Transfer pairs:", len(model.transfer_pairs))
    print("Transfer mappings:", len(model.transfer_mappings))

    if not model.transfer_mappings:
        unresolved = [
            issue
            for issue in model.validation_issues
            if issue.category == "layout-transfer-mapping"
        ]
        if unresolved:
            print("Transfer mapping status: unresolved")
            for issue in unresolved[:2]:
                print(" - {0}".format(issue.message))

    print("Issues:", len(model.validation_issues))

    print("\nIssue breakdown:")
    for severity, issues in model.all_issues_by_severity().items():
        print(" {0}: {1}".format(severity, len(issues)))

    report_output_path = model.runtime_metadata.get("report_output_path")
    if report_output_path:
        print("\nReport saved:", report_output_path)

    if model.parse_warnings:
        print("\nParse/runtime warnings:")
        for warning in model.parse_warnings:
            print(" - {0}".format(warning))
