class AutoRunHamiltonInterface(phi.HamiltonInterface if phi else object):
    def start(self):
        if not phi:
            raise RuntimeError("pyhamilton is not installed or could not be imported.")

        if self.active:
            return

        self.log("starting Hamilton interface")

        if self.simulate:
            self.server_thread = phi.HamiltonInterface.HamiltonServerThread(
                self.address,
                self.port,
            )
            self.server_thread.start()
            time.sleep(1)

            subprocess.Popen([
                OEM_RUN_EXE_PATH,
                OEM_HSL_PATH,
                "-r",
                "-t",
            ])

            self.log("started OEM application for simulation with auto-run")
        else:
            self.oem_process = Process(target=phi.run_hamilton_process, args=())
            self.oem_process.start()
            self.log("started OEM process")

            self.server_thread = phi.HamiltonInterface.HamiltonServerThread(
                self.address,
                self.port,
            )
            self.server_thread.start()

        self.log("started server thread")
        self.active = True


class SearchableCombobox(ttk.Combobox):
    def __init__(self, master=None, completevalues=None, **kwargs):
        self.completevalues = sorted(completevalues or [])
        super().__init__(master, values=self.completevalues, **kwargs)
        self.bind("<KeyRelease>", self._filter_values)

    def _filter_values(self, event):
        typed = self.get().strip().lower()
        if not typed:
            self["values"] = self.completevalues
            return

        filtered = [value for value in self.completevalues if typed in value.lower()]
        self["values"] = filtered


def safe_float(value: Any, default: float = 0.0) -> float:
    try:
        return float(value)
    except Exception:
        return default


def read_text_file_safely(path: str) -> str:
    for encoding in ("utf-8", "latin-1", "cp1252"):
        try:
            with open(path, "r", encoding=encoding, errors="ignore") as file:
                return file.read()
        except Exception:
            continue
    return ""


def excel_col_name(index_zero_based: int) -> str:
    name = ""
    index = index_zero_based + 1

    while index:
        index, remainder = divmod(index - 1, 26)
        name = chr(65 + remainder) + name

    return name


def normalize_position_text(value: Any) -> str:
    text = str(value).strip().upper()
    text = text.replace(" ", "")
    text = text.replace(":", "")
    return text


def extract_position_number(position_text: Any) -> Optional[int]:
    match = re.search(r"(\d+)$", str(position_text).strip())
    return int(match.group(1)) if match else None


def load_liquid_classes_from_access(db_path: str = "LC.mdb") -> List[str]:
    candidates = [db_path, "LC.mdb", "LC.accdb"]
    selected = next((path for path in candidates if path and os.path.exists(path)), None)

    if not selected:
        raise FileNotFoundError(
            "Liquid class database not found. Put LC.mdb or LC.accdb in the project directory."
        )

    if pyodbc is None:
        raise RuntimeError("pyodbc is not installed or Microsoft Access ODBC driver is unavailable.")

    conn_str = (
        r"DRIVER={Microsoft Access Driver (*.mdb, *.accdb)};"
        rf"DBQ={os.path.abspath(selected)};"
    )

    conn = pyodbc.connect(conn_str)
    cursor = conn.cursor()

    table_candidates = ["LiquidClass", "LiquidClasses"]
    column_candidates = ["LiquidClassName", "Name", "Liquid Class Name"]

    last_error = None

    for table_name in table_candidates:
        for column_name in column_candidates:
            try:
                cursor.execute(f"SELECT [{column_name}] FROM [{table_name}]")
                liquid_classes = sorted({
                    str(row[0]).strip()
                    for row in cursor.fetchall()
                    if row[0] is not None and str(row[0]).strip()
                })

                if liquid_classes:
                    conn.close()
                    return liquid_classes

            except Exception as exc:
                last_error = exc

    conn.close()
    raise RuntimeError(f"Unable to read liquid classes from {selected}. Last error: {last_error}")


def _clean_lay_name(raw_value: str) -> str:
    cleaned = re.sub(r"[\x00-\x1F]+", "", raw_value).strip()
    cleaned = cleaned.strip("^").strip()
    cleaned = cleaned.strip('"').strip("'").strip()

    match = re.search(r"[A-Za-z][A-Za-z0-9_\- .]*", cleaned)
    if not match:
        return ""

    cleaned = match.group(0).strip()

    if not cleaned or not cleaned[0].isalpha():
        return ""

    return cleaned


def parse_lay_file(lay_path: str) -> List[str]:
    try:
        with open(lay_path, "r", encoding="utf-8", errors="ignore") as file:
            content = file.read()
    except Exception:
        with open(lay_path, "r", encoding="latin-1", errors="ignore") as file:
            content = file.read()

    sequence_names = []
    seen = set()

    binary_name_pattern = re.compile(
        r"Seq\.(\d+)\.Name(?P<raw>.*?)(?=Seq\.\1\.ReadOnly)",
        re.IGNORECASE | re.DOTALL,
    )

    for match in binary_name_pattern.finditer(content):
        name = _clean_lay_name(match.group("raw"))

        if name and name not in seen:
            seen.add(name)
            sequence_names.append(name)

    if sequence_names:
        return sequence_names

    fallback_patterns = [
        re.compile(r"Seq\.\d+\.Name\^\w+\^(\w+[^\^]*)", re.IGNORECASE),
        re.compile(r"Seq\.\d+\.Name\^[^\^]*\^([^\r\n\^]+)", re.IGNORECASE),
        re.compile(r"Sequence\.\d+\.Name\^[^\^]*\^([^\r\n\^]+)", re.IGNORECASE),
    ]

    for pattern in fallback_patterns:
        for raw in pattern.findall(content):
            name = _clean_lay_name(str(raw))

            if name and name not in seen:
                seen.add(name)
                sequence_names.append(name)

    return sequence_names


def parse_sequence_counts(lay_path: str) -> Dict[str, int]:
    try:
        with open(lay_path, "r", encoding="utf-8", errors="ignore") as file:
            content = file.read()
    except Exception:
        with open(lay_path, "r", encoding="latin-1", errors="ignore") as file:
            content = file.read()

    id_to_count = {}

    count_pattern = re.compile(
        r"Seq\.(\d+)\.Cnt(?P<raw>.*?)(?=Seq\.\1\.Item|Seq\.\d+\.Name)",
        re.IGNORECASE | re.DOTALL,
    )

    for match in count_pattern.finditer(content):
        seq_id = match.group(1)
        raw = re.sub(r"[\x00-\x1F]+", "", match.group("raw")).strip()
        num_match = re.search(r"\d+", raw)

        if num_match:
            id_to_count[seq_id] = int(num_match.group(0))

    name_to_count = {}

    name_pattern = re.compile(
        r"Seq\.(\d+)\.Name(?P<raw>.*?)(?=Seq\.\1\.ReadOnly)",
        re.IGNORECASE | re.DOTALL,
    )

    for match in name_pattern.finditer(content):
        seq_id = match.group(1)
        name = _clean_lay_name(match.group("raw"))

        if name and seq_id in id_to_count:
            name_to_count[name] = id_to_count[seq_id]

    return name_to_count


def find_related_method_files(lay_path: str) -> List[str]:
    method_dir = os.path.dirname(os.path.abspath(lay_path))
    method_stem = os.path.splitext(os.path.basename(lay_path))[0].lower()

    candidates = []

    for ext in ("*.hsl", "*.sub", "*.stp", "*.res", "*.med", "*.lay"):
        candidates.extend(glob.glob(os.path.join(method_dir, ext)))

    ranked = []

    for path in candidates:
        name = os.path.basename(path).lower()
        score = 0

        if os.path.splitext(name)[0] == method_stem:
            score += 100
        if method_stem in name:
            score += 50
        if path.lower().endswith(".hsl"):
            score += 20
        elif path.lower().endswith(".sub"):
            score += 15
        elif path.lower().endswith(".stp"):
            score += 10
        elif path.lower().endswith(".lay"):
            score += 5

        ranked.append((score, path))

    ranked.sort(key=lambda item: item[0], reverse=True)

    return [path for _score, path in ranked]


def extract_channel_pattern_candidates(text: str) -> List[str]:
    candidates = []

    patterns = [
        re.compile(r"\bchannel\s*[:=]\s*([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", re.IGNORECASE),
        re.compile(r"\bchannels\s*[:=]\s*([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", re.IGNORECASE),
        re.compile(r"\bchannelPattern\s*[:=]\s*([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", re.IGNORECASE),
        re.compile(r"\bchannel_pattern\s*[:=]\s*([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", re.IGNORECASE),
        re.compile(r"\bChannelPattern\^[^\^]*\^([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", re.IGNORECASE),
        re.compile(r"\bChannel\^[^\^]*\^([01]{8}|[01]{12}|[01]{14}|[01]{16})\b", re.IGNORECASE),
        re.compile(r"\b([01]{8}|[01]{12}|[01]{14}|[01]{16})\b"),
    ]

    for pattern in patterns:
        for match in pattern.findall(text):
            value = str(match).strip()
            if value and "1" in value and value not in candidates:
                candidates.append(value)

    return candidates


def extract_sequence_context_windows(text: str, sequence_name: str, window: int = 1200) -> List[str]:
    contexts = []

    if not sequence_name:
        return contexts

    for match in re.finditer(re.escape(sequence_name), text, flags=re.IGNORECASE):
        start = max(0, match.start() - window)
        end = min(len(text), match.end() + window)
        contexts.append(text[start:end])

    return contexts


def detect_hardware_mode(sequence_name: str, selected_role: str = "") -> str:
    seq_upper = str(sequence_name).upper()
    role_upper = str(selected_role).upper()

    if "CO-RE" in seq_upper or "CORE" in seq_upper or "96" in seq_upper or "HEAD" in seq_upper:
        return "stamp"

    if "CO-RE" in role_upper or "CORE" in role_upper or "96" in role_upper or "HEAD" in role_upper:
        return "stamp"

    return "channels"


def detect_channel_pattern_for_sequence(sequence_name: str, method_files: List[str]) -> str:
    if detect_hardware_mode(sequence_name) == "stamp":
        return "1" * 96

    fallback_candidates = []

    for path in method_files:
        text = read_text_file_safely(path)
        if not text:
            continue

        for context in extract_sequence_context_windows(text, sequence_name):
            candidates = extract_channel_pattern_candidates(context)
            if candidates:
                return candidates[0]

        fallback_candidates.extend(extract_channel_pattern_candidates(text))

    if fallback_candidates:
        return fallback_candidates[0]

    return "111111111111"


def detect_channel_patterns_for_sequences(sequence_names: List[str], lay_path: str) -> Dict[str, str]:
    method_files = find_related_method_files(lay_path)
    detected = {}

    for sequence_name in sequence_names:
        detected[sequence_name] = detect_channel_pattern_for_sequence(sequence_name, method_files)

    debug_path = os.path.join(os.getcwd(), "devpal_lite_channel_pattern_debug.json")

    try:
        with open(debug_path, "w", encoding="utf-8") as file:
            json.dump(
                {
                    "lay_path": lay_path,
                    "method_files_scanned": method_files,
                    "detected_patterns": detected,
                },
                file,
                indent=2,
            )
    except Exception:
        pass

    return detected


def parse_dataframe_plate_layout(df, marker_pattern, plate_layout):
    for row_idx in range(df.shape[0]):
        for col_idx in range(df.shape[1]):
            cell_value = df.iat[row_idx, col_idx]

            if pd.isna(cell_value):
                continue

            cell_text = str(cell_value).strip()
            matches = marker_pattern.findall(cell_text)

            if matches:
                dest_position = f"{excel_col_name(col_idx)}{row_idx + 1}"

                for found_marker in matches:
                    plate_layout[found_marker.upper()].append({
                        "dest_value": dest_position,
                        "cell_value": cell_text,
                        "row_index": row_idx + 1,
                        "column_index": col_idx + 1,
                        "column_name": excel_col_name(col_idx),
                    })


def parse_plate_layout_file(layout_path: str, marker: str) -> Dict[str, List[Dict[str, Any]]]:
    if pd is None:
        raise RuntimeError("pandas is required for layout parsing.")

    marker = marker.strip().upper()
    if not marker:
        return {}

    marker_pattern = re.compile(rf"\b{re.escape(marker)}\d+\b", re.IGNORECASE)
    plate_layout = defaultdict(list)

    ext = os.path.splitext(layout_path)[1].lower()

    if ext == ".csv":
        df = pd.read_csv(layout_path, header=None, dtype=str)
        parse_dataframe_plate_layout(df, marker_pattern, plate_layout)

    elif ext in (".xls", ".xlsx"):
        sheets = pd.read_excel(layout_path, sheet_name=None, header=None, dtype=str)
        for _sheet_name, df in sheets.items():
            parse_dataframe_plate_layout(df, marker_pattern, plate_layout)

    elif ext == ".docx":
        if Document is None:
            raise RuntimeError("python-docx is required for DOCX layout parsing.")

        doc = Document(layout_path)
        for table in doc.tables:
            for row_idx, row in enumerate(table.rows):
                for col_idx, cell in enumerate(row.cells):
                    cell_text = str(cell.text).strip()
                    matches = marker_pattern.findall(cell_text)

                    if matches:
                        dest_position = f"{excel_col_name(col_idx)}{row_idx + 1}"

                        for found_marker in matches:
                            plate_layout[found_marker.upper()].append({
                                "dest_value": dest_position,
                                "cell_value": cell_text,
                                "row_index": row_idx + 1,
                                "column_index": col_idx + 1,
                                "column_name": excel_col_name(col_idx),
                            })
    else:
        raise ValueError("Unsupported plate layout file type. Use CSV, XLS, XLSX, or DOCX.")

    return dict(plate_layout)


def validate_step_configs(configs: List[SequenceStepConfig]) -> List[ValidationIssue]:
    issues = []
    roles = {config.role for config in configs}

    for required_role in ROLE_OPTIONS:
        if required_role not in roles:
            issues.append(
                ValidationIssue(
                    "critical",
                    "configuration",
                    f"Missing required step role: {required_role}",
                )
            )

    for config in configs:
        if config.role not in ROLE_OPTIONS:
            issues.append(ValidationIssue("critical", "configuration", f"Invalid step role: {config.role}"))

        if config.role in ("aspirate", "dispense") and not config.liquid_class:
            issues.append(
                ValidationIssue(
                    "critical",
                    "configuration",
                    f"Liquid class is required for {config.role}: {config.sequence}",
                )
            )

        if config.volume_ul <= 0 or config.volume_ul > 1000:
            issues.append(
                ValidationIssue(
                    "critical",
                    "configuration",
                    f"Volume must be between 1 and 1000 uL: {config.sequence}",
                )
            )

        if config.transfer_type not in TRANSFER_OPTIONS:
            issues.append(
                ValidationIssue(
                    "critical",
                    "configuration",
                    f"Invalid transfer type: {config.transfer_type}",
                )
            )

        if config.replicate not in REPLICATE_OPTIONS:
            issues.append(
                ValidationIssue(
                    "critical",
                    "configuration",
                    f"Invalid replicate value: {config.replicate}",
                )
            )

        if config.transfer_type == "samples" and not config.marker:
            issues.append(
                ValidationIssue(
                    "critical",
                    "configuration",
                    "Marker is required for sample tracking/layout mapping.",
                )
            )

    return issues


def build_execution_plan(
    configs: List[SequenceStepConfig],
    sequence_counts: Optional[Dict[str, int]] = None,
) -> List[Dict[str, Any]]:
    sequence_counts = sequence_counts or {}

    replicate = configs[0].replicate if configs else "single"
    replicate_count = REPLICATE_MAP.get(replicate, 1)

    tip_steps = [c for c in configs if c.role == "tip_pick"]
    asp_steps = [c for c in configs if c.role == "aspirate"]
    dsp_steps = [c for c in configs if c.role == "dispense"]

    max_len = max(len(tip_steps), len(asp_steps), len(dsp_steps), 0)
    plan = []
    order = 1

    for rep_index in range(1, replicate_count + 1):
        for idx in range(max_len):
            if idx < len(tip_steps):
                step = tip_steps[idx]
                plan.append({
                    "order": order,
                    "action": "tip_pick",
                    "sequence": step.sequence,
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "autoincrement": False,
                    "channel_pattern": step.channel_pattern,
                })
                order += 1

            if idx < len(asp_steps):
                step = asp_steps[idx]
                plan.append({
                    "order": order,
                    "action": "aspirate",
                    "sequence": step.sequence,
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "volume_ul": step.volume_ul,
                    "liquid_class": step.liquid_class,
                    "autoincrement": False,
                    "channel_pattern": step.channel_pattern,
                })
                order += 1

            if idx < len(dsp_steps):
                step = dsp_steps[idx]
                sequence_count = int(sequence_counts.get(step.sequence, 12) or 12)

                plan.append({
                    "order": order,
                    "action": "dispense",
                    "sequence": step.sequence,
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "volume_ul": step.volume_ul,
                    "liquid_class": step.liquid_class,
                    "autoincrement": rep_index > 1,
                    "increment": sequence_count if rep_index > 1 else 0,
                    "channel_pattern": step.channel_pattern,
                    "sequence_position_count": sequence_count,
                })
                order += 1

            if idx < len(tip_steps):
                step = tip_steps[idx]
                plan.append({
                    "order": order,
                    "action": "tip_eject",
                    "sequence": "Waste",
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "autoincrement": False,
                    "channel_pattern": step.channel_pattern,
                })
                order += 1

    return plan


def generate_deterministic_transfer_pairs(
    configs: List[SequenceStepConfig],
    layout_matches: Dict[str, List[Dict[str, Any]]],
) -> List[TransferPair]:
    replicate = configs[0].replicate if configs else "single"
    replicate_count = REPLICATE_MAP.get(replicate, 1)

    tip_steps = [c for c in configs if c.role == "tip_pick"]
    asp_steps = [c for c in configs if c.role == "aspirate"]
    dsp_steps = [c for c in configs if c.role == "dispense"]

    max_len = max(len(asp_steps), len(dsp_steps), 0)
    pairs = []
    pair_counter = 1

    marker = configs[0].marker.upper().strip() if configs and configs[0].marker else ""

    for rep_index in range(1, replicate_count + 1):
        for idx in range(max_len):
            asp = asp_steps[idx] if idx < len(asp_steps) else None
            dsp = dsp_steps[idx] if idx < len(dsp_steps) else None
            tip = tip_steps[idx] if idx < len(tip_steps) else None

            source_num = idx + 1 if asp else None
            source_position = str(source_num) if source_num is not None else ""
            marker_label = f"{marker}{source_num}" if marker and source_num is not None else ""

            dest_position = ""

            if marker_label and marker_label in layout_matches:
                entries = layout_matches.get(marker_label, [])

                if entries:
                    dest_index = min(rep_index - 1, len(entries) - 1)
                    dest_position = entries[dest_index].get("dest_value", "")

            pairs.append(
                TransferPair(
                    pair_id=f"pair_{pair_counter:05d}",
                    tip_sequence=tip.sequence if tip else "",
                    source_sequence=asp.sequence if asp else "",
                    destination_sequence=dsp.sequence if dsp else "",
                    source_position=source_position,
                    destination_position=dest_position,
                    source_sample_number=source_num,
                    destination_sample_number=extract_position_number(dest_position),
                    replicate_index=rep_index,
                    volume_ul=asp.volume_ul if asp else dsp.volume_ul if dsp else 0.0,
                    liquid_class=asp.liquid_class if asp else dsp.liquid_class if dsp else "",
                    transfer_type=asp.transfer_type if asp else dsp.transfer_type if dsp else "",
                    marker_label=marker_label,
                )
            )
            pair_counter += 1

    return pairs


def validate_layout_matches(
    layout_matches: Dict[str, List[Dict[str, Any]]],
    pairs: List[TransferPair],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []

    all_layout_positions = []
    seen_positions = defaultdict(list)

    for marker_label, entries in layout_matches.items():
        for entry in entries:
            pos = normalize_position_text(entry.get("dest_value", ""))
            all_layout_positions.append(pos)
            seen_positions[pos].append(marker_label)

    for pos, labels in seen_positions.items():
        if len(labels) > 1:
            issues.append(
                ValidationIssue(
                    "major",
                    "layout",
                    f"Duplicate destination well found in layout: {pos}",
                    {"markers": labels},
                )
            )

    pair_positions = [normalize_position_text(pair.destination_position) for pair in pairs if pair.destination_position]
    pair_position_set = set(pair_positions)

    missing_from_pairs = sorted(set(all_layout_positions) - pair_position_set)

    for pos in missing_from_pairs:
        issues.append(
            ValidationIssue(
                "major",
                "layout",
                f"Layout position is not represented in deterministic transfer pairs: {pos}",
            )
        )

    duplicate_pair_positions = sorted([pos for pos in set(pair_positions) if pair_positions.count(pos) > 1])

    for pos in duplicate_pair_positions:
        issues.append(
            ValidationIssue(
                "major",
                "mapping",
                f"Duplicate destination well in transfer pairs: {pos}",
            )
        )

    expected_marker_labels = {pair.marker_label for pair in pairs if pair.marker_label}
    actual_marker_labels = set(layout_matches.keys())

    for label in sorted(expected_marker_labels - actual_marker_labels):
        issues.append(
            ValidationIssue(
                "major",
                "marker",
                f"Expected marker not found in layout: {label}",
            )
        )

    for label in sorted(actual_marker_labels - expected_marker_labels):
        findings.append({
            "type": "extra_layout_marker",
            "marker": label,
            "message": f"Layout marker exists but was not selected in transfer pairs: {label}",
        })

    findings.append({
        "type": "layout_summary",
        "marker": marker,
        "marker_count": len(layout_matches),
        "layout_position_count": len(all_layout_positions),
        "unique_layout_position_count": len(set(all_layout_positions)),
        "missing_positions_from_pairs": missing_from_pairs,
        "duplicate_layout_positions": [pos for pos, labels in seen_positions.items() if len(labels) > 1],
    })

    return findings, issues


def get_latest_trc_file(
    run_start_time: Optional[float] = None,
    wait_seconds: int = 40,
    trace_dir: str = DEFAULT_TRACE_DIR,
) -> Optional[str]:
    pattern = os.path.join(trace_dir, "STAR_OEM_noFan_*_Trace.trc")
    end_time = time.time() + wait_seconds

    while time.time() < end_time:
        trc_files = glob.glob(pattern)

        if run_start_time is not None:
            trc_files = [path for path in trc_files if os.path.getmtime(path) >= run_start_time]

        if trc_files:
            trc_files.sort(key=os.path.getmtime, reverse=True)
            return trc_files[0]

        time.sleep(1)

    return None


def parse_trc_file(trc_path: str) -> Tuple[List[str], List[str], List[Dict[str, Any]]]:
    aspirate_steps = []
    dispense_steps = []
    ordered_steps = []

    patterns = [
        (
            "aspirate",
            re.compile(
                r"1000\s*ul\s+channel\s+aspirate\s+\(single step\)\s*-\s*complete[:;]\s*(.*)",
                re.IGNORECASE,
            ),
        ),
        (
            "dispense",
            re.compile(
                r"1000\s*ul\s+channel\s+dispense\s+\(single step\)\s*-\s*complete[:;]\s*(.*)",
                re.IGNORECASE,
            ),
        ),
        (
            "aspirate_96_head",
            re.compile(
                r"co-?re\s+96\s+head\s+aspirate\s+\(single step\)\s*-\s*complete[:;]\s*(.*)",
                re.IGNORECASE,
            ),
        ),
        (
            "dispense_96_head",
            re.compile(
                r"co-?re\s+96\s+head\s+dispense\s+\(single step\)\s*-\s*complete[:;]\s*(.*)",
                re.IGNORECASE,
            ),
        ),
    ]

    with open(trc_path, "r", encoding="latin-1") as file:
        lines = file.readlines()

    order = 1

    for raw_line in lines:
        line = raw_line.strip()

        for step_type, pattern in patterns:
            match = pattern.search(line)

            if not match:
                continue

            payload = match.group(1).strip()

            if step_type in ("aspirate", "aspirate_96_head"):
                aspirate_steps.append(payload)

            if step_type in ("dispense", "dispense_96_head"):
                dispense_steps.append(payload)

            ordered_steps.append({
                "order": order,
                "type": step_type,
                "raw": payload,
            })
            order += 1
            break

    return aspirate_steps, dispense_steps, ordered_steps


def normalize_channel_steps(step_lines: List[str]) -> List[Tuple[str, str, str, str]]:
    normalized = []

    pattern = re.compile(
        r">\s*channel\s+(\d+):\s*([^,]+),\s*([A-Za-z]*\d+)\s+([\d\.]+)\s*[µu]L",
        re.IGNORECASE,
    )

    fallback_pattern = re.compile(
        r"channel\s+(\d+).*?([A-Za-z0-9_\- ]+).*?\b([A-H]\d{1,2}|\d+)\b.*?([\d\.]+)\s*[µu]L",
        re.IGNORECASE,
    )

    for step_line in step_lines:
        matches = pattern.findall(step_line)

        if not matches:
            matches = fallback_pattern.findall(step_line)

        for channel_num, labware, position, volume in matches:
            normalized.append((
                channel_num.strip(),
                labware.strip(),
                normalize_position_text(position),
                volume.strip(),
            ))

    return normalized


def cross_match_positions(
    aspirate_steps: List[str],
    dispense_steps: List[str],
    replicate_value: str,
) -> Tuple[bool, Any]:
    replicate_count = REPLICATE_MAP.get(str(replicate_value).lower(), 1)

    normalized_aspirate_steps = normalize_channel_steps(aspirate_steps)
    normalized_dispense_steps = normalize_channel_steps(dispense_steps)

    aspirate_channel_map = {}
    for aspirate in normalized_aspirate_steps:
        aspirate_channel_map[aspirate[0]] = aspirate

    aspirate_to_dispense_map = defaultdict(list)

    for dispense in normalized_dispense_steps:
        channel = dispense[0]

        if channel not in aspirate_channel_map:
            return False, f"Channel {channel} in dispense step does not match any aspirate step."

        aspirate_step = aspirate_channel_map[channel]
        aspirate_to_dispense_map[aspirate_step].append(dispense[1:])

    for aspirate_step, dispenses in aspirate_to_dispense_map.items():
        if replicate_count > 0 and len(dispenses) % replicate_count != 0:
            return False, (
                f"Aspirate step {aspirate_step} has {len(dispenses)} dispenses, "
                f"which is not divisible by replicate count {replicate_count}."
            )

    return True, dict(aspirate_to_dispense_map)


def validate_trace_against_layout(
    aspirate_to_dispense_map: Dict[Any, Any],
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []
    marker = marker.upper().strip()

    expected_by_sample_num = defaultdict(list)

    for marker_key, entries in layout_matches.items():
        try:
            sample_num = int(marker_key.upper().replace(marker, ""))
            expected_by_sample_num[sample_num].extend(entries)
        except ValueError:
            issues.append(
                ValidationIssue(
                    "minor",
                    "marker",
                    f"Could not parse sample number from marker {marker_key}",
                )
            )

    seen_trace_destinations = []

    for aspirate_step, dispenses in aspirate_to_dispense_map.items():
        source_position_text = str(aspirate_step[2]).strip()
        source_num = extract_position_number(source_position_text)

        if source_num is None:
            issues.append(
                ValidationIssue(
                    "major",
                    "trace",
                    f"Could not extract source number from aspirate position: {source_position_text}",
                )
            )
            continue

        marker_label = f"{marker}{source_num}"
        expected_entries = expected_by_sample_num.get(source_num, [])
        actual_positions = [normalize_position_text(dispense[1]) for dispense in dispenses]
        seen_trace_destinations.extend(actual_positions)

        expected_positions = [
            normalize_position_text(entry.get("dest_value", ""))
            for entry in expected_entries
            if entry.get("dest_value") not in [None, "", "nan"]
        ]

        missing = sorted(set(expected_positions) - set(actual_positions))
        unexpected = sorted(set(actual_positions) - set(expected_positions))

        findings.append({
            "type": "trace_layout_match",
            "marker": marker_label,
            "source_position": source_position_text,
            "expected_destinations": expected_positions,
            "actual_destinations": actual_positions,
            "missing_destinations": missing,
            "unexpected_destinations": unexpected,
            "status": "pass" if not missing and not unexpected else "fail",
        })

        if missing:
            issues.append(
                ValidationIssue(
                    "critical",
                    "trace_layout",
                    f"{marker_label} missing expected destination wells: {missing}",
                )
            )

        if unexpected:
            issues.append(
                ValidationIssue(
                    "critical",
                    "trace_layout",
                    f"{marker_label} has unexpected destination wells: {unexpected}",
                )
            )

        if len(actual_positions) != len(expected_positions):
            issues.append(
                ValidationIssue(
                    "major",
                    "trace_layout",
                    f"{marker_label} source/destination count mismatch",
                    {
                        "expected_count": len(expected_positions),
                        "actual_count": len(actual_positions),
                    },
                )
            )

    duplicate_trace_dests = sorted([
        pos for pos in set(seen_trace_destinations)
        if seen_trace_destinations.count(pos) > 1
    ])

    for pos in duplicate_trace_dests:
        issues.append(
            ValidationIssue(
                "major",
                "trace",
                f"Duplicate destination well found in trace: {pos}",
            )
        )

    all_expected = []
    for entries in layout_matches.values():
        all_expected.extend([
            normalize_position_text(entry.get("dest_value", ""))
            for entry in entries
        ])

    for pos in sorted(set(all_expected) - set(seen_trace_destinations)):
        issues.append(
            ValidationIssue(
                "major",
                "trace_layout",
                f"Layout destination not represented in trace: {pos}",
            )
        )

    return findings, issues


def validate_tracking_against_marker_order(
    aspirate_to_dispense_map: Dict[Any, Any],
    layout_matches: Dict[str, List[Dict[str, Any]]],
    marker: str,
) -> Tuple[List[Dict[str, Any]], List[ValidationIssue]]:
    findings = []
    issues = []
    marker = marker.upper().strip()

    expected_sample_numbers = set()

    for marker_key in layout_matches:
        try:
            sample_num = int(marker_key.upper().replace(marker, ""))
            expected_sample_numbers.add(sample_num)
        except ValueError:
            continue

    traced_source_numbers = set()

    for aspirate_step, dispenses in aspirate_to_dispense_map.items():
        source_position_text = str(aspirate_step[2]).strip()
        source_num = extract_position_number(source_position_text)

        if source_num is None:
            issues.append(
                ValidationIssue(
                    "major",
                    "tracking",
                    f"Could not extract source number from aspirate position: {source_position_text}",
                )
            )
            continue

        traced_source_numbers.add(source_num)
        marker_label = f"{marker}{source_num}"
        status = "pass" if source_num in expected_sample_numbers else "fail"

        findings.append({
            "type": "tracking_source_order",
            "marker": marker_label,
            "source_position": source_position_text,
            "source_sample_number": source_num,
            "dispense_event_count": len(dispenses),
            "status": status,
        })

        if source_num not in expected_sample_numbers:
            issues.append(
                ValidationIssue(
                    "critical",
                    "tracking",
                    f"Aspirated source position {source_position_text} does not match any layout marker sample number.",
                )
            )

    for sample_num in sorted(expected_sample_numbers - traced_source_numbers):
        issues.append(
            ValidationIssue(
                "critical",
                "tracking",
                f"Layout marker {marker}{sample_num} expected source sample {sample_num}, but no matching aspirate source was found in trace.",
            )
        )

    return findings, issues


def generate_pyhamilton_review_script(
    configs: List[SequenceStepConfig],
    execution_plan: List[Dict[str, Any]],
    output_dir: str,
) -> str:
    script_path = os.path.join(output_dir, "devpal_lite_generated_pyhamilton_simulation_script.py")

    payload = {
        "review_required": True,
        "generated_at": datetime.now().isoformat(),
        "selected_sequences": [asdict(c) for c in configs],
        "execution_plan": execution_plan,
    }

    lines = [
        "from pyhamilton import *",
        "",
        "REVIEW_REQUIRED = True",
        f"DEV_PAL_LITE_PLAN = {json.dumps(payload, indent=4)}",
        "",
        "def run_review_required_plan(ham_int):",
        "    if REVIEW_REQUIRED:",
        "        raise RuntimeError('Review required before running generated PyHamilton script.')",
        "    initialize(ham_int)",
    ]

    for item in execution_plan:
        action = item.get("action")
        seq = item.get("sequence", "")
        channel = item.get("channel_pattern") or "111111111111"
        vol = float(item.get("volume_ul") or 0)
        lc = item.get("liquid_class", "")

        if action == "tip_pick":
            lines.append(f"    tip_pick_up_seq(ham_int, tipseq={seq!r}, channel={channel!r})")

        elif action == "aspirate":
            lines.append(
                f"    aspirate_seq(ham_int, asp_seq={seq!r}, vols={vol!r}, channel={channel!r}, liq_class={lc!r})"
            )

        elif action == "dispense":
            if item.get("autoincrement"):
                lines.append(
                    f"    inc_sequence(ham_int, sequence={seq!r}, increment={int(item.get('increment', 12))!r})"
                )

            lines.append(
                f"    dispense_seq(ham_int, disp_seq={seq!r}, vols={vol!r}, channel={channel!r}, liq_class={lc!r})"
            )

        elif action == "tip_eject":
            lines.append(f"    tip_eject_seq2(ham_int, waste_seq='Waste', channel={channel!r})")

    Path(script_path).write_text("\n".join(lines) + "\n", encoding="utf-8")
    return script_path


def run_pyhamilton_simulation(
    lay_path: str,
    configs: List[SequenceStepConfig],
    execution_plan: List[Dict[str, Any]],
) -> Tuple[Optional[str], List[ValidationIssue], str]:
    issues = []
    temp_dir = tempfile.mkdtemp(prefix="devpal_lite_pyhamilton_")
    generated_script_path = ""

    if phi is None or LayoutManager is None:
        issues.append(
            ValidationIssue(
                "critical",
                "runtime",
                "pyhamilton is not available. Simulation could not run.",
            )
        )
        return None, issues, generated_script_path

    try:
        generated_script_path = generate_pyhamilton_review_script(
            configs=configs,
            execution_plan=execution_plan,
            output_dir=temp_dir,
        )
    except Exception as exc:
        issues.append(
            ValidationIssue(
                "major",
                "runtime",
                f"Temp PyHamilton script generation failed: {exc}",
            )
        )

    run_start_time = time.time()

    try:
        layout_manager = LayoutManager(lay_path)
        plate1 = layout_manager.assign_unused_resource(ResourceType(Plate96, ""))

        with AutoRunHamiltonInterface(simulate=True) as ham_int:
            normal_logging(ham_int, temp_dir)
            initialize(ham_int)

            for item in execution_plan:
                action = item.get("action")
                seq = item.get("sequence", "")
                mode = item.get("hardware_mode", "channels")
                channel = item.get("channel_pattern") or "111111111111"
                volume = float(item.get("volume_ul") or 0)
                liquid_class = item.get("liquid_class", "")

                if action == "tip_pick":
                    if mode == "stamp":
                        tip_pick_up_96_seq(ham_int, tip96_seq=seq)
                    else:
                        tip_pick_up_seq(ham_int, tipseq=seq, channel=channel)

                elif action == "aspirate":
                    if mode == "stamp":
                        aspirate_96_seq(
                            ham_int,
                            plate96=plate1,
                            head_asp_seq=seq,
                            vols=volume,
                            liq_class=liquid_class,
                        )
                    else:
                        aspirate_seq(
                            ham_int,
                            asp_seq=seq,
                            vols=volume,
                            channel=channel,
                            liq_class=liquid_class,
                        )

                elif action == "dispense":
                    if item.get("autoincrement"):
                        inc_sequence(
                            ham_int,
                            sequence=seq,
                            increment=int(item.get("increment", 12)),
                        )

                    if mode == "stamp":
                        dispense_96_seq2(
                            ham_int,
                            plate96=plate1,
                            head_disp_seq=seq,
                            vols=volume,
                        )
                    else:
                        dispense_seq(
                            ham_int,
                            disp_seq=seq,
                            vols=volume,
                            channel=channel,
                            liq_class=liquid_class,
                        )

                elif action == "tip_eject":
                    if mode == "stamp":
                        tip_eject_96(ham_int)
                    else:
                        tip_eject_seq2(
                            ham_int,
                            waste_seq="Waste",
                            channel=channel,
                        )

    except (HamiltonStepError, HamiltonError, HamiltonTimeoutError, Exception) as exc:
        issues.append(
            ValidationIssue(
                "critical",
                "runtime",
                f"PyHamilton simulation failed: {type(exc).__name__}: {exc}",
            )
        )
        return None, issues, generated_script_path

    time.sleep(5)

    trace_path = get_latest_trc_file(run_start_time=run_start_time)

    if not trace_path:
        issues.append(
            ValidationIssue(
                "critical",
                "trace",
                "No new .trc file was found after PyHamilton simulation.",
            )
        )

    return trace_path, issues, generated_script_path


def create_output_model(
    lay_file: str,
    layout_file: str,
    trace_file: str,
    configs: List[SequenceStepConfig],
    pairs: List[TransferPair],
    execution_plan: List[Dict[str, Any]],
    marker_matches: Dict[str, List[Dict[str, Any]]],
    layout_findings: List[Dict[str, Any]],
    trace_findings: List[Dict[str, Any]],
    issues: List[ValidationIssue],
    limitations: List[str],
    review_script_path: str,
    report_path: str = "",
) -> DevPalLiteOutput:
    source_positions = sorted({pair.source_position for pair in pairs if pair.source_position})
    destination_positions = sorted({pair.destination_position for pair in pairs if pair.destination_position})

    validation_findings = [
        {
            "severity": issue.severity,
            "category": issue.category,
            "message": issue.message,
            "evidence": issue.evidence,
        }
        for issue in issues
    ]

    return DevPalLiteOutput(
        lay_file=lay_file,
        layout_file=layout_file,
        trace_file=trace_file,
        selected_sequences=[asdict(config) for config in configs],
        source_positions=source_positions,
        destination_positions=destination_positions,
        transfer_pairs=[asdict(pair) for pair in pairs],
        execution_plan=execution_plan,
        marker_matches=marker_matches,
        layout_findings=layout_findings,
        trace_findings=trace_findings,
        validation_findings=validation_findings,
        issues=validation_findings,
        limitations=limitations,
        generated_review_script=review_script_path,
        report_path=report_path,
    )


def write_docx_report(output: DevPalLiteOutput, output_dir: str) -> str:
