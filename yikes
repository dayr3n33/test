        tk.Button(top, text="Upload Plate Layout", command=self.upload_layout).pack(side="left", padx=4)
        self.layout_label = tk.Label(top, text="No layout selected", anchor="w")
        self.layout_label.pack(side="left", fill="x", expand=True, padx=6)

        form = tk.LabelFrame(self.root, text="Required Transfer Information")
        form.pack(fill="x", padx=10, pady=5)

        tk.Label(form, text="Transfer Type").grid(row=0, column=0, sticky="w", padx=5, pady=4)
        ttk.Combobox(form, textvariable=self.transfer_type_var, values=TRANSFER_OPTIONS, state="readonly", width=18).grid(row=0, column=1, sticky="w", padx=5, pady=4)

        tk.Label(form, text="Replicate").grid(row=0, column=2, sticky="w", padx=5, pady=4)
        ttk.Combobox(form, textvariable=self.replicate_var, values=REPLICATE_OPTIONS, state="readonly", width=18).grid(row=0, column=3, sticky="w", padx=5, pady=4)

        tk.Label(form, text="Volume uL").grid(row=0, column=4, sticky="w", padx=5, pady=4)
        tk.Entry(form, textvariable=self.volume_var, width=12).grid(row=0, column=5, sticky="w", padx=5, pady=4)

        tk.Label(form, text="Marker").grid(row=0, column=6, sticky="w", padx=5, pady=4)
        tk.Entry(form, textvariable=self.marker_var, width=12).grid(row=0, column=7, sticky="w", padx=5, pady=4)

        tk.Checkbutton(form, text="Tracking Enabled", variable=self.tracking_var).grid(row=0, column=8, sticky="w", padx=5, pady=4)

        tk.Label(form, text="Liquid Class").grid(row=1, column=0, sticky="w", padx=5, pady=4)
        self.liquid_combo = SearchableCombobox(form, textvariable=self.liquid_class_var, completevalues=[], width=90)
        self.liquid_combo.grid(row=1, column=1, columnspan=8, sticky="we", padx=5, pady=4)

        options = tk.LabelFrame(self.root, text="Report Options")
        options.pack(fill="x", padx=10, pady=5)

        tk.Label(options, text="Report Format").pack(side="left", padx=10)
        ttk.Combobox(options, textvariable=self.report_format_var, values=["docx", "pdf", "txt"], state="readonly", width=10).pack(side="left")

        list_frame = tk.LabelFrame(self.root, text="Extracted Method/Deck Sequences")
        list_frame.pack(fill="both", expand=True, padx=10, pady=8)

        header = tk.Frame(list_frame)
        header.pack(fill="x")

        tk.Label(header, text="Use", width=5).grid(row=0, column=0)
        tk.Label(header, text="Sequence", width=55).grid(row=0, column=1, sticky="w")
        tk.Label(header, text="Step Role", width=14).grid(row=0, column=2)
        tk.Label(header, text="Channel Pattern", width=22).grid(row=0, column=3)
        tk.Label(header, text="Hardware", width=12).grid(row=0, column=4)
        tk.Label(header, text="Seq Count", width=10).grid(row=0, column=5)

        self.canvas = tk.Canvas(list_frame)
        scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.canvas.yview)
