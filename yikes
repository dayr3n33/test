def parse_lay_file(lay_path: str) -> List[str]:
    sequence_names = []

    try:
        with open(lay_path, "r", encoding="utf-8") as file:
            content = file.read()
    except UnicodeDecodeError:
        with open(lay_path, "r", encoding="latin-1") as file:
            content = file.read()

    pattern = re.compile(r"Seq\.\d+\.Name\^\w+\^(\w+[^\^]*)")
    matches = pattern.findall(content)

    for match in matches:
        sequence_names.append(match.strip())

    return sequence_names




def upload_lay(self):
    path = filedialog.askopenfilename(title="Select .lay File", filetypes=[("LAY files", "*.lay")])
    if not path:
        return
    self.lay_path = path
    self.lay_label.config(text=path)
    try:
        self.sequence_names = sorted(parse_lay_file(path))
        self.load_liquid_classes()
        self.render_sequences()
        self.status.config(text=f"Loaded {len(self.sequence_names)} sequences.")
    except Exception as exc:
        messagebox.showerror("LAY Parse Error", str(exc))
