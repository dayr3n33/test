def render_sequences(self):
    for widget in self.sequence_frame.winfo_children():
        widget.destroy()

    self.sequence_vars = []
    self.sequence_role_vars = {}
    self.sequence_channel_vars = {}
    self.sequence_hardware_vars = {}
    self.sequence_count_vars = {}
    self.sequence_manual_vars = {}

    headers = [
        "Use",
        "Sequence",
        "Step Role",
        "Channel Pattern",
        "Hardware",
        "Seq Count",
        "Manual",
    ]

    for col, header in enumerate(headers):
        label = tk.Label(
            self.sequence_frame,
            text=header,
            font=("Arial", 9, "bold"),
            bg="gray10",
            fg="white",
        )
        label.grid(row=0, column=col, padx=4, pady=4, sticky="w")

    for row_index, sequence_name in enumerate(self.sequence_names, start=1):
        sequence_count = int(self.sequence_counts.get(sequence_name, 0))
        detected_hardware = detect_hardware_mode(sequence_name, "")
        default_channel = "1" * 96 if detected_hardware.lower() == "stamp" else "111111111111"

        use_var = tk.IntVar(value=0)
        role_var = tk.StringVar(value="aspirate")
        channel_var = tk.StringVar(value=default_channel)
        hardware_var = tk.StringVar(value=detected_hardware)
        sequence_count_var = tk.StringVar(value=str(sequence_count))
        manual_var = tk.IntVar(value=0)

        self.sequence_vars.append((sequence_name, use_var))
        self.sequence_role_vars[sequence_name] = role_var
        self.sequence_channel_vars[sequence_name] = channel_var
        self.sequence_hardware_vars[sequence_name] = hardware_var
        self.sequence_count_vars[sequence_name] = sequence_count_var
        self.sequence_manual_vars[sequence_name] = manual_var

        tk.Checkbutton(
            self.sequence_frame,
            variable=use_var,
            bg="gray10",
            fg="white",
            selectcolor="gray20",
        ).grid(row=row_index, column=0, padx=4, pady=2, sticky="w")

        tk.Label(
            self.sequence_frame,
            text=sequence_name,
            bg="gray10",
            fg="white",
            anchor="w",
            width=38,
        ).grid(row=row_index, column=1, padx=4, pady=2, sticky="w")

        role_combo = ttk.Combobox(
            self.sequence_frame,
            textvariable=role_var,
            values=["tip_pick", "aspirate", "dispense"],
            width=12,
            state="readonly",
        )
        role_combo.grid(row=row_index, column=2, padx=4, pady=2, sticky="w")

        channel_entry = tk.Entry(
            self.sequence_frame,
            textvariable=channel_var,
            width=18,
        )
        channel_entry.grid(row=row_index, column=3, padx=4, pady=2, sticky="w")

        hardware_combo = ttk.Combobox(
            self.sequence_frame,
            textvariable=hardware_var,
            values=["channels", "stamp"],
            width=10,
            state="readonly",
        )
        hardware_combo.grid(row=row_index, column=4, padx=4, pady=2, sticky="w")

        tk.Label(
            self.sequence_frame,
            textvariable=sequence_count_var,
            bg="gray10",
            fg="white",
            width=8,
            anchor="w",
        ).grid(row=row_index, column=5, padx=4, pady=2, sticky="w")

        manual_check = tk.Checkbutton(
            self.sequence_frame,
            variable=manual_var,
            bg="gray10",
            fg="white",
            selectcolor="gray20",
        )
        manual_check.grid(row=row_index, column=6, padx=4, pady=2, sticky="w")

        def on_role_change(_event=None, seq=sequence_name):
            role = self.sequence_role_vars[seq].get()
            hardware = detect_hardware_mode(seq, role)
            self.sequence_hardware_vars[seq].set(hardware)

            current_pattern = self.sequence_channel_vars[seq].get().strip()
            if hardware.lower() == "stamp":
                if not current_pattern or len(current_pattern) != 96:
                    self.sequence_channel_vars[seq].set("1" * 96)
            else:
                if not current_pattern or len(current_pattern) == 96:
                    self.sequence_channel_vars[seq].set("111111111111")

        role_combo.bind("<<ComboboxSelected>>", on_role_change)









def collect_configs(self) -> List[SequenceStepConfig]:
    configs = []

    marker = self.marker_var.get().strip().upper()
    transfer_type = self.transfer_type_var.get().strip() or "samples"
    replicate = self.replicate_var.get().strip().lower()
    liquid_class = self.liquid_class_var.get().strip()

    try:
        volume_ul = float(self.volume_var.get().strip())
    except Exception:
        messagebox.showerror("Invalid Volume", "Volume must be numeric.")
        return []

    for selected_index, (sequence_name, use_var) in enumerate(self.sequence_vars):
        if not use_var.get():
            continue

        role = self.sequence_role_vars[sequence_name].get().strip()
        channel_pattern = self.sequence_channel_vars[sequence_name].get().strip()
        hardware_mode = self.sequence_hardware_vars[sequence_name].get().strip().lower()
        manual = bool(self.sequence_manual_vars[sequence_name].get())

        try:
            sequence_count = int(self.sequence_count_vars[sequence_name].get())
        except Exception:
            sequence_count = int(self.sequence_counts.get(sequence_name, 0))

        if role in ("aspirate", "dispense") and not liquid_class:
            messagebox.showerror("Missing Liquid Class", "Liquid class is required for aspirate/dispense steps.")
            return []

        if hardware_mode == "stamp":
            if not channel_pattern:
                channel_pattern = "1" * 96
        else:
            if not re.match(r"^(?:[01]{8}|[01]{12}|[01]{14}|[01]{16})$", channel_pattern):
                messagebox.showerror(
                    "Invalid Channel Pattern",
                    f"{sequence_name} has invalid channel pattern.\nUse 8, 12, 14, or 16 digits of 0/1.",
                )
                return []

        configs.append(
            SequenceStepConfig(
                sequence=sequence_name,
                role=role,
                liquid_class=liquid_class if role in ("aspirate", "dispense") else "",
                transfer_type=transfer_type,
                replicate=replicate,
                volume_ul=volume_ul,
                marker=marker,
                channel_pattern=channel_pattern,
                hardware_mode=hardware_mode,
                selected_index=selected_index,
                sequence_count=sequence_count,
                manual=manual,
            )
        )

    return configs










