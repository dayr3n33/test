def parse_lay_file(lay_path: str) -> List[str]:
    text = read_text_file_best_effort(lay_path)

    if not text:
        return []

    found = []
    seen = set()

    seq_ids = sorted(
        {int(value) for value in re.findall(r"Seq\.(\d+)\.Name", text, re.IGNORECASE)}
    )

    for seq_id in seq_ids:
        pattern = re.compile(
            rf"Seq\.{seq_id}\.Name(.*?)(?=Seq\.{seq_id}\.(?:ReadOnly|Cnt|Item)|Seq\.\d+\.Name|Seq\.Cnt|$)",
            re.IGNORECASE | re.DOTALL,
        )

        match = pattern.search(text)
        if not match:
            continue

        raw_name = match.group(1)
        raw_name = raw_name.replace("\x00", " ")
        raw_name = re.sub(r"[\x01-\x1f]+", " ", raw_name)
        raw_name = re.sub(r"^[^A-Za-z0-9_]+", "", raw_name)

        name_match = re.search(r"([A-Za-z][A-Za-z0-9_ .\-]{0,119})", raw_name)
        if not name_match:
            continue

        name = clean_control_chars(name_match.group(1)).strip()
        name = re.sub(r"\s+", " ", name)

        if not name:
            continue

        if name.lower().startswith(("readonly", "cnt", "item")):
            continue

        if name not in seen:
            found.append(name)
            seen.add(name)

    return found





def parse_lay_sequence_counts(lay_path: str) -> Dict[str, int]:
    text = read_text_file_best_effort(lay_path)

    if not text:
        return {}

    counts_by_num = {}
    names_by_num = {}

    for seq_num, cnt in re.findall(r"Seq\.(\d+)\.Cnt[^\d]*(\d+)", text, re.IGNORECASE):
        try:
            counts_by_num[int(seq_num)] = int(cnt)
        except Exception:
            pass

    seq_ids = sorted(
        {int(value) for value in re.findall(r"Seq\.(\d+)\.Name", text, re.IGNORECASE)}
    )

    for seq_id in seq_ids:
        pattern = re.compile(
            rf"Seq\.{seq_id}\.Name(.*?)(?=Seq\.{seq_id}\.(?:ReadOnly|Cnt|Item)|Seq\.\d+\.Name|Seq\.Cnt|$)",
            re.IGNORECASE | re.DOTALL,
        )

        match = pattern.search(text)
        if not match:
            continue

        raw_name = match.group(1)
        raw_name = raw_name.replace("\x00", " ")
        raw_name = re.sub(r"[\x01-\x1f]+", " ", raw_name)
        raw_name = re.sub(r"^[^A-Za-z0-9_]+", "", raw_name)

        name_match = re.search(r"([A-Za-z][A-Za-z0-9_ .\-]{0,119})", raw_name)
        if not name_match:
            continue

        name = clean_control_chars(name_match.group(1)).strip()
        name = re.sub(r"\s+", " ", name)

        if name:
            names_by_num[seq_id] = name

    return {
        name: counts_by_num.get(seq_num, 0)
        for seq_num, name in names_by_num.items()
    }









def render_sequences(self):
        if not hasattr(self, "sequence_frame") or self.sequence_frame is None:
            messagebox.showerror(
                "UI Error",
                "Sequence frame does not exist. Rebuild UI before rendering sequences.",
            )
            return

        sequence_frame = self.sequence_frame






list_frame = tk.LabelFrame(self.root, text="Extracted Method/Deck Sequences")
        list_frame.pack(fill="both", expand=True, padx=10, pady=8)

        header = tk.Frame(list_frame)
        header.pack(fill="x")

        tk.Label(header, text="Use", width=5).grid(row=0, column=0, sticky="w")
        tk.Label(header, text="Sequence", width=55).grid(row=0, column=1, sticky="w")
        tk.Label(header, text="Step Role", width=14).grid(row=0, column=2, sticky="w")
        tk.Label(header, text="Manual", width=8).grid(row=0, column=3, sticky="w")
        tk.Label(header, text="Channel Pattern", width=18).grid(row=0, column=4, sticky="w")
        tk.Label(header, text="Hardware", width=12).grid(row=0, column=5, sticky="w")
        tk.Label(header, text="Seq Count", width=10).grid(row=0, column=6, sticky="w")

        self.canvas = tk.Canvas(list_frame, highlightthickness=0)
        self.sequence_canvas = self.canvas
        scrollbar = ttk.Scrollbar(list_frame, orient="vertical", command=self.canvas.yview)

        self.sequence_frame = tk.Frame(self.canvas)
        self.scroll_frame = self.sequence_frame

        self.sequence_window = self.canvas.create_window((0, 0), window=self.sequence_frame, anchor="nw")

        self.sequence_frame.bind(
            "<Configure>",
            lambda event: self.canvas.configure(scrollregion=self.canvas.bbox("all")),
        )

        self.canvas.bind(
            "<Configure>",
            lambda event: self.canvas.itemconfig(self.sequence_window, width=event.width),
        )

        self.canvas.configure(yscrollcommand=scrollbar.set)

        self.canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")
