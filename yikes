def build_execution_plan(configs: List[SequenceStepConfig]) -> List[Dict[str, Any]]:
    replicate = configs[0].replicate if configs else "single"
    replicate_count = REPLICATE_MAP.get(str(replicate).lower(), 1)

    tip_steps = [config for config in configs if config.role == "tip_pick"]
    asp_steps = [config for config in configs if config.role == "aspirate"]
    dsp_steps = [config for config in configs if config.role == "dispense"]

    max_len = max(
        len(tip_steps),
        len(asp_steps),
        len(dsp_steps),
        0,
    )

    plan = []
    order = 1

    for rep_index in range(1, replicate_count + 1):
        for idx in range(max_len):

            if idx < len(tip_steps):
                step = tip_steps[idx]

                plan.append({
                    "order": order,
                    "action": "tip_pick",
                    "sequence": step.sequence,
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "manual": False,
                    "autoincrement": False,
                    "reset_to_first_position": False,
                    "increment": 0,
                    "channel_pattern": step.channel_pattern,
                    "volume_ul": "",
                    "liquid_class": "",
                    "transfer_type": step.transfer_type,
                    "marker": step.marker,
                })
                order += 1

            if idx < len(asp_steps):
                step = asp_steps[idx]

                plan.append({
                    "order": order,
                    "action": "aspirate",
                    "sequence": step.sequence,
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "manual": bool(step.manual),
                    "autoincrement": False,
                    "reset_to_first_position": bool(step.manual),
                    "increment": 0,
                    "channel_pattern": step.channel_pattern,
                    "volume_ul": step.volume_ul,
                    "liquid_class": step.liquid_class,
                    "transfer_type": step.transfer_type,
                    "marker": step.marker,
                })
                order += 1

            if idx < len(dsp_steps):
                step = dsp_steps[idx]

                should_increment = rep_index > 1 and not step.manual

                plan.append({
                    "order": order,
                    "action": "dispense",
                    "sequence": step.sequence,
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "manual": bool(step.manual),
                    "autoincrement": should_increment,
                    "reset_to_first_position": bool(step.manual),
                    "increment": 12 if should_increment else 0,
                    "channel_pattern": step.channel_pattern,
                    "volume_ul": step.volume_ul,
                    "liquid_class": step.liquid_class,
                    "transfer_type": step.transfer_type,
                    "marker": step.marker,
                })
                order += 1

            if idx < len(tip_steps):
                step = tip_steps[idx]

                plan.append({
                    "order": order,
                    "action": "tip_eject",
                    "sequence": "Waste",
                    "hardware_mode": step.hardware_mode,
                    "replicate_index": rep_index,
                    "manual": False,
                    "autoincrement": False,
                    "reset_to_first_position": False,
                    "increment": 0,
                    "channel_pattern": step.channel_pattern,
                    "volume_ul": "",
                    "liquid_class": "",
                    "transfer_type": step.transfer_type,
                    "marker": step.marker,
                })
                order += 1

    return plan











