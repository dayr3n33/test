def render_sequences(self):
    if not hasattr(self, "sequence_frame") or self.sequence_frame is None:
        messagebox.showerror(
            "UI Error",
            "Sequence frame does not exist. Rebuild UI before rendering sequences.",
        )
        return

    sequence_frame = self.sequence_frame

    for widget in sequence_frame.winfo_children():
        widget.destroy()

    self.sequence_vars = []
    self.sequence_role_vars = {}
    self.sequence_channel_vars = {}
    self.sequence_hardware_vars = {}
    self.sequence_count_vars = {}
    self.sequence_manual_vars = {}
    self.sequence_set_vars = {}
    self.sequence_set_widgets = {}
    self.sequence_control_vars = {}
    self.set_header_widget = None

    headers = [
        ("Use", 0, 5),
        ("Set", 1, 4),
        ("Control", 2, 7),
        ("Sequence", 3, 34),
        ("Step Role", 4, 12),
        ("Manual", 5, 7),
        ("Channel Pattern", 6, 18),
        ("Hardware", 7, 10),
        ("Seq Count", 8, 9),
    ]

    for text, col, width in headers:
        label = tk.Label(
            sequence_frame,
            text=text,
            width=width,
            anchor="w",
            font=("Arial", 9, "bold"),
            bg="#ffffff",
        )
        label.grid(row=0, column=col, padx=3, pady=4, sticky="w")

        if text == "Set":
            self.set_header_widget = label

    sequence_names = list(getattr(self, "sequence_names", []) or [])
    sequence_counts = getattr(self, "sequence_counts", {}) or {}

    for row_index, sequence_name in enumerate(sequence_names, start=1):
        sequence_count = int(sequence_counts.get(sequence_name, 0) or 0)

        default_hardware = detect_hardware_mode(sequence_name, "").lower()
        if default_hardware not in ("channels", "head"):
            default_hardware = "channels"

        default_channel_pattern = "1" * 96 if default_hardware == "head" else "111111111111"

        use_var = tk.IntVar(value=0)
        set_var = tk.StringVar(value="")
        control_var = tk.IntVar(value=0)
        role_var = tk.StringVar(value="aspirate")
        manual_var = tk.IntVar(value=0)
        channel_var = tk.StringVar(value=default_channel_pattern)
        hardware_var = tk.StringVar(value=default_hardware)
        sequence_count_var = tk.StringVar(value=str(sequence_count))

        self.sequence_vars.append((sequence_name, use_var))
        self.sequence_set_vars[sequence_name] = set_var
        self.sequence_control_vars[sequence_name] = control_var
        self.sequence_role_vars[sequence_name] = role_var
        self.sequence_manual_vars[sequence_name] = manual_var
        self.sequence_channel_vars[sequence_name] = channel_var
        self.sequence_hardware_vars[sequence_name] = hardware_var
        self.sequence_count_vars[sequence_name] = sequence_count_var

        tk.Checkbutton(
            sequence_frame,
            variable=use_var,
            command=self.update_set_column_visibility,
            bg="#ffffff",
            activebackground="#ffffff",
        ).grid(row=row_index, column=0, padx=3, pady=2, sticky="w")

        set_entry = tk.Entry(
            sequence_frame,
            textvariable=set_var,
            width=4,
        )
        set_entry.grid(row=row_index, column=1, padx=3, pady=2, sticky="w")
        self.sequence_set_widgets[sequence_name] = set_entry

        tk.Checkbutton(
            sequence_frame,
            variable=control_var,
            bg="#ffffff",
            activebackground="#ffffff",
        ).grid(row=row_index, column=2, padx=3, pady=2, sticky="w")

        tk.Label(
            sequence_frame,
            text=sequence_name,
            width=34,
            anchor="w",
            bg="#ffffff",
        ).grid(row=row_index, column=3, padx=3, pady=2, sticky="w")

        role_combo = ttk.Combobox(
            sequence_frame,
            textvariable=role_var,
            values=ROLE_OPTIONS,
            width=12,
            state="readonly",
        )
        role_combo.grid(row=row_index, column=4, padx=3, pady=2, sticky="w")

        tk.Checkbutton(
            sequence_frame,
            variable=manual_var,
            bg="#ffffff",
            activebackground="#ffffff",
        ).grid(row=row_index, column=5, padx=3, pady=2, sticky="w")

        tk.Entry(
            sequence_frame,
            textvariable=channel_var,
            width=18,
        ).grid(row=row_index, column=6, padx=3, pady=2, sticky="w")

        hardware_combo = ttk.Combobox(
            sequence_frame,
            textvariable=hardware_var,
            values=["channels", "head"],
            width=10,
            state="readonly",
        )
        hardware_combo.grid(row=row_index, column=7, padx=3, pady=2, sticky="w")

        tk.Label(
            sequence_frame,
            textvariable=sequence_count_var,
            width=9,
            anchor="w",
            bg="#ffffff",
        ).grid(row=row_index, column=8, padx=3, pady=2, sticky="w")

        def on_role_or_hardware_change(event=None, seq=sequence_name):
            role = self.sequence_role_vars[seq].get().strip()
            hardware = self.sequence_hardware_vars[seq].get().strip().lower()

            detected = detect_hardware_mode(seq, role).lower()
            if detected in ("channels", "head"):
                hardware = detected
                self.sequence_hardware_vars[seq].set(hardware)

            current_pattern = self.sequence_channel_vars[seq].get().strip()

            if hardware == "head":
                if not current_pattern or len(current_pattern) != 96:
                    self.sequence_channel_vars[seq].set("1" * 96)
            else:
                if not current_pattern or len(current_pattern) == 96:
                    self.sequence_channel_vars[seq].set("111111111111")

        role_combo.bind("<<ComboboxSelected>>", on_role_or_hardware_change)
        hardware_combo.bind("<<ComboboxSelected>>", on_role_or_hardware_change)

    if not sequence_names:
        tk.Label(
            sequence_frame,
            text="No sequences loaded.",
            anchor="w",
            bg="#ffffff",
        ).grid(row=1, column=0, columnspan=9, padx=4, pady=8, sticky="w")

    self.update_set_column_visibility()

    try:
        sequence_frame.update_idletasks()
        if hasattr(self, "sequence_canvas"):
            self.sequence_canvas.configure(scrollregion=self.sequence_canvas.bbox("all"))
        elif hasattr(self, "canvas"):
            self.canvas.configure(scrollregion=self.canvas.bbox("all"))
    except Exception:
        pass






def parse_volume_by_set(volume_text: str, set_count: int) -> Dict[int, float]:
    raw_values = [item.strip() for item in str(volume_text or "").split(",") if item.strip()]

    if not raw_values:
        raise ValueError("Volume is required.")

    volumes = []
    for raw in raw_values:
        try:
            value = float(raw)
        except Exception:
            raise ValueError(f"Invalid volume value: {raw}")

        if value <= 0 or value > 1000:
            raise ValueError(f"Volume must be between 1 and 1000 uL: {value}")

        volumes.append(value)

    if len(volumes) == 1:
        return {set_num: volumes[0] for set_num in range(1, set_count + 1)}

    if len(volumes) < set_count:
        raise ValueError(
            f"You entered {len(volumes)} volume value(s), but there are {set_count} set(s). "
            "Enter one volume or one comma-separated volume per set."
        )

    return {set_num: volumes[set_num - 1] for set_num in range(1, set_count + 1)}


def infer_tip_type_from_sequence(sequence_name: str) -> str:
    text = str(sequence_name or "").upper()

    if "1000" in text or "HV" in text or "HIGH" in text:
        return "1000_ul_hv"

    if "300S" in text or "300 S" in text or "300" in text or "STD" in text or "SLIM" in text:
        return "300_ul_std_slim"

    if "50" in text or "LV" in text or "LOW" in text:
        return "50_ul_lv"

    return "unknown"


def get_tip_volume_range(tip_type: str, hardware_mode: str) -> Optional[Tuple[float, float]]:
    hardware_mode = str(hardware_mode or "").lower()

    if hardware_mode == "head":
        ranges = {
            "1000_ul_hv": (100.0, 1000.0),
            "300_ul_std_slim": (20.0, 300.0),
            "50_ul_lv": (12.5, 49.0),
        }
    else:
        ranges = {
            "1000_ul_hv": (100.0, 1000.0),
            "300_ul_std_slim": (10.0, 300.0),
            "50_ul_lv": (10.0, 50.0),
        }

    return ranges.get(tip_type)


def validate_tip_volume_rules(configs: List[SequenceStepConfig]) -> List[ValidationIssue]:
    issues = []
    grouped = defaultdict(list)

    for config in configs:
        grouped[int(getattr(config, "set_order", 1) or 1)].append(config)

    for set_order, items in sorted(grouped.items()):
        tip_steps = [item for item in items if item.role == "tip pick up"]
        liquid_steps = [item for item in items if item.role in ("aspirate", "dispense")]

        if not tip_steps or not liquid_steps:
            continue

        tip = tip_steps[0]
        tip_type = infer_tip_type_from_sequence(tip.sequence)
        hardware_mode = str(tip.hardware_mode or "channels").lower()

        if tip_type == "unknown":
            issues.append(ValidationIssue(
                "major",
                "tip_type",
                f"Could not identify tip type for Set {set_order} from tip sequence: {tip.sequence}",
                {"set_order": set_order, "tip_sequence": tip.sequence},
            ))
            continue

        allowed_range = get_tip_volume_range(tip_type, hardware_mode)

        if not allowed_range:
            continue

        min_ul, max_ul = allowed_range

        for step in liquid_steps:
            volume = float(step.volume_ul)

            if volume < min_ul or volume > max_ul:
                issues.append(ValidationIssue(
                    "critical",
                    "tip_volume_range",
                    (
                        f"Set {set_order} volume {volume} uL is outside allowed range "
                        f"{min_ul}-{max_ul} uL for {hardware_mode} {tip_type} tips."
                    ),
                    {
                        "set_order": set_order,
                        "tip_sequence": tip.sequence,
                        "tip_type": tip_type,
                        "hardware_mode": hardware_mode,
                        "volume_ul": volume,
                        "allowed_min_ul": min_ul,
                        "allowed_max_ul": max_ul,
                    },
                ))

    return issues




def get_required_transfer_iterations(configs: List[SequenceStepConfig]) -> int:
    control_steps = [
        config for config in configs
        if bool(getattr(config, "control", False))
        and config.role in ("aspirate", "dispense")
    ]

    if control_steps:
        return max(get_sequence_iterations(config) for config in control_steps)

    dsp_steps = [config for config in configs if config.role == "dispense" and not bool(config.manual)]
    asp_steps = [config for config in configs if config.role == "aspirate" and not bool(config.manual)]

    if dsp_steps:
        return max(get_sequence_iterations(config) for config in dsp_steps)

    if asp_steps:
        return max(get_sequence_iterations(config) for config in asp_steps)

    return 1










