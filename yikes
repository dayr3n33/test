def make_checkbutton(self, parent, text, variable, command=None, width=None):
    checkbox = tk.Checkbutton(
        parent,
        text=text,
        variable=variable,
        command=command,
        bg=self.UI_BG,
        fg=self.UI_TEXT_FG,
        activebackground=self.UI_TEXT_BG,
        activeforeground=self.UI_TEXT_FG,
        selectcolor="#1e6bff",
        indicatoron=True,
        relief="flat",
        bd=1,
        highlightthickness=0,
        anchor="w",
        width=width,
    )

    checkbox.bind("<Enter>", lambda event: checkbox.configure(bg=self.UI_TEXT_BG))
    checkbox.bind("<Leave>", lambda event: checkbox.configure(bg=self.UI_BG))

    return checkbox





def _build_ui(self):
