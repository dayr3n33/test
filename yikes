
self.variant_var = tk.IntVar(value=0)
self.sequence_set_vars = {}
self.sequence_set_widgets = {}
self.set_header_widget = None





tk.Checkbutton(
    options,
    text="Variant",
    variable=self.variant_var,
).pack(side="right", padx=10)










def render_sequences(self):
        if not hasattr(self, "sequence_frame") or self.sequence_frame is None:
            messagebox.showerror(
                "UI Error",
                "Sequence frame does not exist. Rebuild UI before rendering sequences.",
            )
            return

        sequence_frame = self.sequence_frame

        for widget in sequence_frame.winfo_children():
            widget.destroy()

        self.sequence_vars = []
        self.sequence_role_vars = {}
        self.sequence_channel_vars = {}
        self.sequence_hardware_vars = {}
        self.sequence_count_vars = {}
        self.sequence_manual_vars = {}
        self.sequence_set_vars = {}
        self.sequence_set_widgets = {}

        headers = [
            ("Use", 0, 6),
            ("Set", 1, 6),
            ("Sequence", 2, 34),
            ("Step Role", 3, 12),
            ("Manual", 4, 8),
            ("Channel Pattern", 5, 18),
            ("Hardware", 6, 10),
            ("Seq Count", 7, 10),
        ]

        for text, col, width in headers:
            label = tk.Label(
                sequence_frame,
                text=text,
                width=width,
                anchor="w",
                font=("Arial", 9, "bold"),
            )
            label.grid(row=0, column=col, padx=4, pady=4, sticky="w")

            if text == "Set":
                self.set_header_widget = label

        sequence_names = list(getattr(self, "sequence_names", []) or [])
        sequence_counts = getattr(self, "sequence_counts", {}) or {}

        for row_index, sequence_name in enumerate(sequence_names, start=1):
            sequence_count = int(sequence_counts.get(sequence_name, 0) or 0)
            default_hardware = detect_hardware_mode(sequence_name, "").lower()

            if default_hardware not in ("channels", "head"):
                default_hardware = "channels"

            default_channel_pattern = "1" * 96 if default_hardware == "head" else "111111111111"

            use_var = tk.IntVar(value=0)
            set_var = tk.StringVar(value="")
            role_var = tk.StringVar(value="aspirate")
            manual_var = tk.IntVar(value=0)
            channel_var = tk.StringVar(value=default_channel_pattern)
            hardware_var = tk.StringVar(value=default_hardware)
            sequence_count_var = tk.StringVar(value=str(sequence_count))

            self.sequence_vars.append((sequence_name, use_var))
            self.sequence_role_vars[sequence_name] = role_var
            self.sequence_manual_vars[sequence_name] = manual_var
            self.sequence_channel_vars[sequence_name] = channel_var
            self.sequence_hardware_vars[sequence_name] = hardware_var
            self.sequence_count_vars[sequence_name] = sequence_count_var
            self.sequence_set_vars[sequence_name] = set_var

            tk.Checkbutton(
                sequence_frame,
                variable=use_var,
                command=self.update_set_column_visibility,
            ).grid(row=row_index, column=0, padx=4, pady=2, sticky="w")

            set_entry = tk.Entry(
                sequence_frame,
                textvariable=set_var,
                width=6,
            )
            set_entry.grid(row=row_index, column=1, padx=4, pady=2, sticky="w")
            self.sequence_set_widgets[sequence_name] = set_entry

            tk.Label(
                sequence_frame,
                text=sequence_name,
                width=34,
                anchor="w",
            ).grid(row=row_index, column=2, padx=4, pady=2, sticky="w")

            role_combo = ttk.Combobox(
                sequence_frame,
                textvariable=role_var,
                values=["tip_pick", "aspirate", "dispense"],
                width=12,
                state="readonly",
            )
            role_combo.grid(row=row_index, column=3, padx=4, pady=2, sticky="w")

            tk.Checkbutton(
                sequence_frame,
                variable=manual_var,
            ).grid(row=row_index, column=4, padx=4, pady=2, sticky="w")

            tk.Entry(
                sequence_frame,
                textvariable=channel_var,
                width=18,
            ).grid(row=row_index, column=5, padx=4, pady=2, sticky="w")

            hardware_combo = ttk.Combobox(
                sequence_frame,
                textvariable=hardware_var,
                values=["channels", "head"],
                width=10,
                state="readonly",
            )
            hardware_combo.grid(row=row_index, column=6, padx=4, pady=2, sticky="w")

            tk.Label(
                sequence_frame,
                textvariable=sequence_count_var,
                width=10,
                anchor="w",
            ).grid(row=row_index, column=7, padx=4, pady=2, sticky="w")

            def on_role_or_hardware_change(event=None, seq=sequence_name):
                role = self.sequence_role_vars[seq].get().strip()
                hardware = self.sequence_hardware_vars[seq].get().strip().lower()

                detected = detect_hardware_mode(seq, role).lower()

                if detected in ("channels", "head"):
                    hardware = detected
                    self.sequence_hardware_vars[seq].set(hardware)

                current_pattern = self.sequence_channel_vars[seq].get().strip()

                if hardware == "head":
                    if not current_pattern or len(current_pattern) != 96:
                        self.sequence_channel_vars[seq].set("1" * 96)
                else:
                    if not current_pattern or len(current_pattern) == 96:
                        self.sequence_channel_vars[seq].set("111111111111")

            role_combo.bind("<<ComboboxSelected>>", on_role_or_hardware_change)
            hardware_combo.bind("<<ComboboxSelected>>", on_role_or_hardware_change)

        if not sequence_names:
            tk.Label(
                sequence_frame,
                text="No sequences loaded.",
                anchor="w",
            ).grid(row=1, column=0, columnspan=8, padx=4, pady=8, sticky="w")

        self.update_set_column_visibility()

        try:
            sequence_frame.update_idletasks()
            if hasattr(self, "sequence_canvas"):
                self.sequence_canvas.configure(scrollregion=self.sequence_canvas.bbox("all"))
            elif hasattr(self, "canvas"):
                self.canvas.configure(scrollregion=self.canvas.bbox("all"))
        except Exception:
            pass












def update_set_column_visibility(self):
        selected_count = sum(1 for _, use_var in self.sequence_vars if use_var.get())
        show_sets = selected_count > 3 or bool(self.variant_var.get())

        if self.set_header_widget is not None:
            if show_sets:
                self.set_header_widget.grid()
            else:
                self.set_header_widget.grid_remove()

        for sequence_name, widget in self.sequence_set_widgets.items():
            if show_sets:
                widget.grid()
            else:
                widget.grid_remove()
                if sequence_name in self.sequence_set_vars:
                    self.sequence_set_vars[sequence_name].set("")

        try:
            if hasattr(self, "sequence_canvas"):
                self.sequence_canvas.configure(scrollregion=self.sequence_canvas.bbox("all"))
        except Exception:
            pass






def collect_configs(self) -> List[SequenceStepConfig]:
        configs = []

        marker = self.marker_var.get().strip().upper()
        transfer_type = self.transfer_type_var.get().strip() or "samples"
        replicate = self.replicate_var.get().strip().lower()
        liquid_class = self.liquid_class_var.get().strip()
        variant_mode = bool(self.variant_var.get())

        selected_sequences = [
            sequence_name
            for sequence_name, use_var in self.sequence_vars
            if use_var.get()
        ]

        use_set_order = len(selected_sequences) > 3 or variant_mode

        try:
            volume_ul = float(self.volume_var.get().strip())
        except Exception:
            messagebox.showerror("Invalid Volume", "Volume must be numeric.")
            return []

        for selected_index, sequence_name in enumerate(selected_sequences):
            role = self.sequence_role_vars[sequence_name].get().strip()
            channel_pattern = self.sequence_channel_vars[sequence_name].get().strip()
            hardware_mode = self.sequence_hardware_vars[sequence_name].get().strip().lower()
            manual = bool(self.sequence_manual_vars[sequence_name].get())

            try:
                sequence_count = int(self.sequence_count_vars[sequence_name].get())
            except Exception:
                sequence_count = int(self.sequence_counts.get(sequence_name, 0))

            set_order = 1

            if use_set_order:
                raw_set = self.sequence_set_vars[sequence_name].get().strip()

                if not raw_set:
                    messagebox.showerror(
                        "Missing Set Number",
                        f"Set number is required for selected sequence: {sequence_name}",
                    )
                    return []

                try:
                    set_order = int(raw_set)
                except Exception:
                    messagebox.showerror(
                        "Invalid Set Number",
                        f"Set number must be numeric for sequence: {sequence_name}",
                    )
                    return []

                if set_order <= 0:
                    messagebox.showerror(
                        "Invalid Set Number",
                        f"Set number must be 1 or higher for sequence: {sequence_name}",
                    )
                    return []

            if role in ("aspirate", "dispense") and not liquid_class:
                messagebox.showerror("Missing Liquid Class", "Liquid class is required for aspirate/dispense steps.")
                return []

            if hardware_mode == "head":
                if not channel_pattern:
                    channel_pattern = "1" * 96
            else:
                if not re.match(r"^(?:[01]{8}|[01]{12}|[01]{14}|[01]{16})$", channel_pattern):
                    messagebox.showerror(
                        "Invalid Channel Pattern",
                        f"{sequence_name} has invalid channel pattern.\nUse 8, 12, 14, or 16 digits of 0/1.",
                    )
                    return []

            configs.append(
                SequenceStepConfig(
                    sequence=sequence_name,
                    role=role,
                    liquid_class=liquid_class if role in ("aspirate", "dispense") else "",
                    transfer_type=transfer_type,
                    replicate=replicate,
                    volume_ul=volume_ul,
                    marker=marker,
                    channel_pattern=channel_pattern,
                    hardware_mode=hardware_mode,
                    selected_index=selected_index,
                    sequence_count=sequence_count,
                    manual=manual,
                    set_order=set_order,
                )
            )

        validation_error = validate_step_sets(configs, variant_mode, use_set_order)

        if validation_error:
            messagebox.showerror("Invalid Step Sets", validation_error)
            return []

        return configs









def validate_step_sets(
    configs: List[SequenceStepConfig],
    variant_mode: bool,
    use_set_order: bool,
) -> str:
    if not use_set_order:
        return ""

    grouped = defaultdict(list)
    for config in configs:
        grouped[int(config.set_order)].append(config)

    if variant_mode:
        tip_orders = [
            int(config.set_order)
            for config in configs
            if config.role == "tip_pick"
        ]

        if tip_orders and min(tip_orders) != 1:
            return "In Variant mode, the first tip pick up step must have Set 1."

        return ""

    for set_order, items in sorted(grouped.items()):
        roles = [item.role for item in items]

        for required_role in ROLE_OPTIONS:
            if roles.count(required_role) != 1:
                return (
                    f"Set {set_order} must contain exactly one tip_pick, "
                    f"one aspirate, and one dispense sequence."
                )

    return ""







def build_execution_plan(configs: List[SequenceStepConfig]) -> List[Dict[str, Any]]:
    plan = []
    order = 1

    grouped = defaultdict(list)
    for config in configs:
        grouped[int(getattr(config, "set_order", 1) or 1)].append(config)

    for set_order in sorted(grouped):
        set_configs = grouped[set_order]

        replicate = set_configs[0].replicate if set_configs else "single"
        replicate_count = REPLICATE_MAP.get(str(replicate).lower(), 1)

        tip_steps = [config for config in set_configs if config.role == "tip_pick"]
        asp_steps = [config for config in set_configs if config.role == "aspirate"]
        dsp_steps = [config for config in set_configs if config.role == "dispense"]

        max_len = max(len(tip_steps), len(asp_steps), len(dsp_steps), 1)
        transfer_iterations = get_required_transfer_iterations(set_configs)

        for rep_index in range(1, replicate_count + 1):
            for transfer_iteration in range(1, transfer_iterations + 1):
                for idx in range(max_len):
                    tip = tip_steps[idx] if idx < len(tip_steps) else tip_steps[0] if tip_steps else None
                    asp = asp_steps[idx] if idx < len(asp_steps) else asp_steps[0] if asp_steps else None
                    dsp = dsp_steps[idx] if idx < len(dsp_steps) else dsp_steps[0] if dsp_steps else None

                    if tip:
                        tip_batch_size = get_sequence_batch_size(tip)
                        tip_should_increment = transfer_iteration > 1 and not bool(tip.manual)

                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "tip_pick",
                            "sequence": tip.sequence,
                            "hardware_mode": tip.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "dispense_iteration": transfer_iteration,
                            "manual": bool(tip.manual),
                            "autoincrement": tip_should_increment,
                            "reset_to_first_position": bool(tip.manual),
                            "increment": tip_batch_size if tip_should_increment else 0,
                            "channel_pattern": tip.channel_pattern,
                            "volume_ul": "",
                            "liquid_class": "",
                            "transfer_type": tip.transfer_type,
                            "marker": tip.marker,
                            "sequence_count": tip.sequence_count,
                            "batch_size": tip_batch_size,
                        })
                        order += 1

                    if asp:
                        asp_batch_size = get_sequence_batch_size(asp)
                        asp_should_increment = transfer_iteration > 1 and not bool(asp.manual)

                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "aspirate",
                            "sequence": asp.sequence,
                            "hardware_mode": asp.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "dispense_iteration": transfer_iteration,
                            "manual": bool(asp.manual),
                            "autoincrement": asp_should_increment,
                            "reset_to_first_position": bool(asp.manual),
                            "increment": asp_batch_size if asp_should_increment else 0,
                            "channel_pattern": asp.channel_pattern,
                            "volume_ul": asp.volume_ul,
                            "liquid_class": asp.liquid_class,
                            "transfer_type": asp.transfer_type,
                            "marker": asp.marker,
                            "sequence_count": asp.sequence_count,
                            "batch_size": asp_batch_size,
                        })
                        order += 1

                    if dsp:
                        dsp_batch_size = get_sequence_batch_size(dsp)
                        dsp_should_increment = transfer_iteration > 1 and not bool(dsp.manual)

                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "dispense",
                            "sequence": dsp.sequence,
                            "hardware_mode": dsp.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "dispense_iteration": transfer_iteration,
                            "manual": bool(dsp.manual),
                            "autoincrement": dsp_should_increment,
                            "reset_to_first_position": bool(dsp.manual),
                            "increment": dsp_batch_size if dsp_should_increment else 0,
                            "channel_pattern": dsp.channel_pattern,
                            "volume_ul": dsp.volume_ul,
                            "liquid_class": dsp.liquid_class,
                            "transfer_type": dsp.transfer_type,
                            "marker": dsp.marker,
                            "sequence_count": dsp.sequence_count,
                            "batch_size": dsp_batch_size,
                        })
                        order += 1

                    if tip:
                        plan.append({
                            "order": order,
                            "set_order": set_order,
                            "action": "tip_eject",
                            "sequence": "Waste",
                            "hardware_mode": tip.hardware_mode,
                            "replicate_index": rep_index,
                            "transfer_iteration": transfer_iteration,
                            "dispense_iteration": transfer_iteration,
                            "manual": False,
                            "autoincrement": False,
                            "reset_to_first_position": False,
                            "increment": 0,
                            "channel_pattern": tip.channel_pattern,
                            "volume_ul": "",
                            "liquid_class": "",
                            "transfer_type": tip.transfer_type,
                            "marker": tip.marker,
                            "sequence_count": tip.sequence_count,
                            "batch_size": get_sequence_batch_size(tip),
                        })
                        order += 1

    return plan
















